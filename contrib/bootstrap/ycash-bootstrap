def has_chain(netdir, dirs=("blocks", "chainstate")):
    return any(os.path.isdir(os.path.join(netdir, d)) and os.listdir(os.path.join(netdir, d)) for d in dirs)


def reset(args, netdir):
    """--reset (T-7): the network's subdirectory removed, its wallet.dat moved aside first."""
    if not os.path.isdir(netdir):
        return
    wallet = os.path.join(netdir, "wallet.dat")
    if os.path.isfile(wallet):
        kept = os.path.join(args.datadir, "wallet-before-reset-%s-%d.dat" % (os.path.basename(netdir), int(time.time())))
        os.replace(wallet, kept)
        log("--reset: moved wallet.dat to %s (its transactions are on the old chain)" % kept)
    shutil.rmtree(netdir)
    log("--reset: removed %s" % netdir)


def marker_path(args):
    """DATADIR/<network>.bootstrap-incomplete: beside the network's subdirectory, not in it, so a
    failure that removes the subdirectory keeps it. The image entrypoint reads the same name."""
    return os.path.join(args.datadir, "%s.bootstrap-incomplete" % args.network)


def fsync_dir(path):
    """Make a rename or a removal in `path` durable (a crash right after it must not undo it)."""
    try:
        fd = os.open(path, os.O_RDONLY)
    except OSError:
        return
    try:
        os.fsync(fd)
    except OSError:
        pass                                   # a file system that cannot sync a directory
    finally:
        os.close(fd)


def write_marker(args, netdir, status):
    os.makedirs(args.datadir, exist_ok=True)
    path = marker_path(args)
    what = netdir if os.path.realpath(netdir) != os.path.realpath(args.datadir) else \
        "%s/{%s} and %s" % (netdir, ",".join(STATE_TOP_DIRS), STAGING)
    with open(path + ".part", "w", encoding="utf-8") as f:
        f.write("ycash-bootstrap: the restore of %s into %s %s (%s).\n"
                "ycashd must not start on this datadir until it is cleared: remove %s and remove the marker,\n"
                "then restore again (or remove only the marker to start on the datadir as it is).\n"
                % (args.network, netdir, status, time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), what))
        f.flush()
        os.fsync(f.fileno())
    os.replace(path + ".part", path)
    fsync_dir(args.datadir)


# ycashd arguments that give the import node a peer, or a listening socket (-noX is X=0 on the line).
PEER_SETTINGS = ("addnode", "connect", "seednode", "bind", "whitebind", "externalip", "listen", "discover", "dnsseed", "upnp")


def is_peer_setting(key):
    key = key.strip().lstrip("-")
    return key in PEER_SETTINGS or (key.startswith("no") and key[2:] in PEER_SETTINGS)


def import_conf(args, work):
    """The ycash.conf the offline import reads: the node's (--conf, else DATADIR/ycash.conf, which
    ycashd reads by default) without its peer settings. ycashd appends a conf's addnode/connect/
    seednode lines to the command line's, so -connect=0 alone does not keep a conf's peers out.
    RPC credentials, indexes (txindex, insightexplorer) and the network stay as the node has them."""
    original = args.conf or os.path.join(args.datadir, "ycash.conf")
    lines = []
    if os.path.isfile(original):
        with open(original, encoding="utf-8", errors="replace") as f:
            for line in f.read().splitlines():
                key = line.split("=", 1)[0] if "=" in line else line
                if not line.lstrip().startswith("#") and is_peer_setting(key):
                    lines.append("# (left out by ycash-bootstrap for the offline import) %s" % key.strip())
                else:
                    lines.append(line)
    os.makedirs(work, exist_ok=True)
    path = os.path.abspath(os.path.join(work, "import.conf"))     # ycashd reads a relative -conf against the datadir
    # It holds the RPC password: a new file, 0600 whatever an earlier one's mode was (O_TRUNC would keep
    # that mode), never a link; restore() removes it when it ends, failed or not.
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600), "w", encoding="utf-8") as f:
        f.write("# ycash-bootstrap: %s without its peer settings, for the offline import only\n" % original)
        f.write("\n".join(lines) + "\n")
    return path


# ycashd arguments an import node never takes from --node-arg: a second -conf would win over the
# stripped copy (the last -conf counts) and bring its peers back; -datadir would point it elsewhere.
NODE_ARG_REFUSED = ("conf", "datadir")


def restore(args, profile):
    netdir = os.path.join(args.datadir, profile["node"]["datadir"]) if profile["node"]["datadir"] else args.datadir
    bad = [a for a in (args.node_arg or []) if is_peer_setting(a.split("=", 1)[0])]
    if bad:
        sys.exit("ycash-bootstrap: --node-arg %s: the import node is offline, peer settings are not taken" % " ".join(bad))
    bad = [a for a in (args.node_arg or []) if a.split("=", 1)[0].strip().lstrip("-") in NODE_ARG_REFUSED]
    if bad:
        sys.exit("ycash-bootstrap: --node-arg %s: the import node reads its own copy of the conf in --datadir; "
                 "pass the conf with --conf and the datadir with --datadir" % " ".join(bad))
    args.work_dir = os.path.abspath(args.work or os.path.join(args.datadir, "bootstrap-work"))
    if profile["name"] == "main":
        if args.prefix or args.source == "prefix":
            sys.exit("ycash-bootstrap: mainnet has no prefix layer: pass --source <base>/main/latest/ (or main-insight/latest/)")
        args.state = True                              # a mainnet restore is always a state bundle
        if args.allow_unsigned:
            sys.exit("ycash-bootstrap: --allow-unsigned is refused on mainnet: a mainnet restore always needs SHA256SUMS.minisig "
                     "from the release key")
        if args.reset:
            sys.exit("ycash-bootstrap: --reset is for the testnets; on mainnet remove blocks/, chainstate/, vaults/ and yellowback/ yourself")
    if args.state:
        if not args.source or args.source == "prefix":
            sys.exit("ycash-bootstrap: --state needs --source (the bundle's directory or URL, e.g. <base>/%s/latest/)" % state_network(profile))
    else:
        where = profile["prefix"]["url"] if args.source in (None, "prefix") else args.source
        if not where:
            sys.exit("ycash-bootstrap: %s has no published prefix: pass --source" % profile["name"])
        if not args.frame_only and not (args.ycashd and args.cli):
            sys.exit("restoring needs --ycashd and --cli (or --frame-only DIR to stop after framing)")
    changes = not (args.frame_only and not args.state)
    if args.reset:
        write_marker(args, netdir, "started with --reset and has not completed")
        reset(args, netdir)
    if has_chain(netdir, STATE_TOP_DIRS if args.state else ("blocks", "chainstate")):
        # Nothing was changed: no marker (an existing one, from an earlier failure, stays).
        raise BundleError("%s already holds a chain: ycash-bootstrap restores into an empty datadir (--reset wipes it first)" % netdir)
    if not changes:
        return restore_prefix(args, profile, netdir, where)
    write_marker(args, netdir, "started and has not completed (killed, or still running)")
    try:
        code = restore_state(args, profile, netdir) if args.state else restore_prefix(args, profile, netdir, where)
    except BundleError as e:
        write_marker(args, netdir, "failed: %s" % e)
        raise
    except BaseException as e:
        write_marker(args, netdir, "failed: %s" % (e.__class__.__name__ + (": %s" % e if str(e) else "")))
        raise
    finally:
        try:
            os.remove(os.path.join(args.work_dir, "import.conf"))     # it holds the RPC password
        except FileNotFoundError:
            pass
    os.remove(marker_path(args))
    fsync_dir(args.datadir)
    return code


def restore_prefix(args, profile, netdir, where):
    source = Source(where)
    work = getattr(args, "work_dir", None) or os.path.abspath(args.work or os.path.join(args.datadir, "bootstrap-work"))
    os.makedirs(work, exist_ok=True)
    log("restoring the %s prefix from %s into %s" % (profile["name"], source, netdir))
    manifest, expect, files, record = verify_bundle(source, profile, work, args)
    if args.frame_only:
        os.makedirs(args.frame_only, exist_ok=True)
        moved = []
        for f in files:
            moved.append(os.path.join(args.frame_only, os.path.basename(f)))
            os.replace(f, moved[-1])
        print("\n".join("-loadblock=%s" % f for f in moved))
        return 0
    node = Node(args, profile, args.rpcport or free_port(), import_conf(args, work))
    record["import"] = import_and_check(node, files, manifest, expect, args, profile)
    os.makedirs(netdir, exist_ok=True)
    with open(os.path.join(netdir, "bootstrap.json"), "w", encoding="utf-8") as f:
        f.write(json.dumps(record, indent=2, sort_keys=True) + "\n")
    if not args.keep:
        shutil.rmtree(work)
    log("done: %s holds the %s prefix to height %d (%s); start the node normally" % (netdir, profile["name"], manifest["last_height"], record["tip"]))
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0], epilog=__doc__.split("\n", 2)[2], formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--network", required=True, help="the network: main (a state bundle only), regtest, testnet-yb-fast, testnet-yb-slow or testnet-legacy")
    ap.add_argument("--datadir", required=True, help="the node's -datadir (the network subdirectory goes inside it; mainnet's files sit at its root)")
    ap.add_argument("--source", help="bundle location: https:// or file:// URL, or a directory (a `latest/` one is read for its height only); "
                                     "`prefix` (the default) is the release's pinned prefix")
    layer = ap.add_mutually_exclusive_group()
    layer.add_argument("--prefix", action="store_true", help="restore the prefix layer (the default)")
    layer.add_argument("--state", action="store_true", help="restore a state bundle (ycash-state/1, /2 or /3, ycash-infra bundles/state/FORMAT.md) from --source")
    ap.add_argument("--reset", action="store_true", help="wipe the network's subdirectory first (wallet.dat is moved aside), for a testnet reset")
    ap.add_argument("--verify-full", action="store_true", help="import with -checkpoints=0: validate every block's scripts")
    ap.add_argument("--ycashd", default=shutil.which("ycashd"), help="the ycashd to import with (default: ycashd on PATH)")
    ap.add_argument("--cli", default=shutil.which("ycash-cli"), help="the ycash-cli beside it (default: ycash-cli on PATH)")
    ap.add_argument("--conf", help="the node's ycash.conf (its RPC credentials and settings are used for the import)")
    ap.add_argument("--rpcport", type=int, help="the RPC port for the import run (default: a free one)")
    ap.add_argument("--node-arg", action="append", metavar="ARG", help="an extra ycashd argument for the import, e.g. regtest's -nuparams=...")
    ap.add_argument("--key", default=DEFAULT_KEY, help="minisign public key file (default keys/ycash-release.pub)")
    ap.add_argument("--minisign", default="minisign", help="the minisign binary")
    ap.add_argument("--require-signature", action="store_true", help="refuse an unsigned SHA256SUMS (the default on mainnet, for a state bundle over "
                                                                     "http(s) and for an unpinned prefix)")
    ap.add_argument("--allow-unsigned", action="store_true", help="accept an unsigned SHA256SUMS where a signature is the default (logged as a warning); "
                                                                "refused on mainnet, which always needs one")
    ap.add_argument("--allow-unpinned", action="store_true", help="accept a SHA256SUMS whose sha256 this release does not pin")
    ap.add_argument("--work", help="download and framing directory (default DATADIR/bootstrap-work, removed afterwards)")
    ap.add_argument("--keep", action="store_true", help="keep the work directory")
    ap.add_argument("--keep-parts", action="store_true", help="a state bundle: keep each checked part in the work directory after it is extracted, "
                                                                "so a re-run after a failure reads them locally (costs the bundle's size in disk)")
    ap.add_argument("--timeout", type=int, default=120, help="seconds without data before a download attempt fails")
    ap.add_argument("--part-attempts", type=int, default=5, help="attempts per part of a state bundle (a broken download resumes)")
    ap.add_argument("--retry-wait", type=float, default=2.0, help=argparse.SUPPRESS)
    ap.add_argument("--frame-only", metavar="DIR", help="check and frame only: write the -loadblock files to DIR, start no node")
    ap.add_argument("--dbcache", type=int, default=1024)
    ap.add_argument("--poll", type=float, default=2.0, help=argparse.SUPPRESS)
    ap.add_argument("--stall-timeout", type=int, default=1800, help="seconds without a new block before the import fails")
    ap.add_argument("--done-grace", type=int, default=120, help=argparse.SUPPRESS)
    ap.add_argument("--pack", metavar="OUT", help="instead: pack heights 0..--last-height of a running private-chain node into a bundle")
    ap.add_argument("--last-height", type=int, help="with --pack: the bundle's last height")
    args = ap.parse_args(argv)
    if args.network == "main":
        profile = main_profile()
    else:
        ybprofile = _profiles_module()
        try:
            profile = ybprofile.load(args.network)
        except ybprofile.ProfileError as e:
            ap.error(str(e))
    args.datadir = os.path.abspath(args.datadir)
    try:
        if args.pack:
            if args.last_height is None or args.last_height < 0:
                ap.error("--pack needs --last-height N")
            if not args.cli:
                ap.error("--pack needs --cli")
            return pack(args, profile)
        return restore(args, profile)
    except BundleError as e:
        print("ycash-bootstrap: refused: %s" % e, file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
