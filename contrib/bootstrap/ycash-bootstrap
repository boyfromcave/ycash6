def state_network(profile):
    """The network's name in a state bundle: its datadir subdirectory, `main` for mainnet."""
    return profile["node"]["datadir"] or "main"


def release_pins(profile):
    """{height: hash} this release compiles for the network (the profile's checkpoints and prefix end)."""
    pins = {}
    for item in profile["prefix"]["checkpoints"]:
        height, value = item.split(":")
        pins[int(height)] = value
    if profile["prefix"]["last_height"] and profile["prefix"]["last_hash"]:
        pins[profile["prefix"]["last_height"]] = profile["prefix"]["last_hash"]
    return pins


def canonical(value):
    return json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False) + "\n"


def state_tarball_name(m):
    return "ycash6-%s-%s-%s.tar.gz" % (m["network"], m["height"], m["flavour"])


def is_count(value, low=0):
    return type(value) is int and value >= low


def manifest_parts(m):
    """The bundle's parts in stream order: v3's `parts` (checked against FORMAT.md's rules), or a v1/v2
    tarball as the one part."""
    if m["format"] != STATE_FORMAT_V3:
        if not is_count(m["bytes"], 1) or not isinstance(m["sha256"], str) or not HEX64.match(m["sha256"]):
            raise BundleError("manifest bytes / sha256 are not a size and a sha256")
        return [{"name": m["tarball"], "bytes": m["bytes"], "sha256": m["sha256"]}], m["bytes"]
    pb, parts = m["part_bytes"], m["parts"]
    if not is_count(pb, 1) or not is_count(m["bytes"], 1) or not is_count(m["unpacked_bytes"]):
        raise BundleError("manifest part_bytes, bytes and unpacked_bytes must be sizes")
    if not isinstance(m["sha256"], str) or not HEX64.match(m["sha256"]):
        raise BundleError("manifest sha256 is not a sha256")
    if not isinstance(parts, list) or not 1 <= len(parts) <= MAX_PARTS:
        raise BundleError("manifest parts is not a list of 1..%d parts" % MAX_PARTS)
    total = 0
    for i, p in enumerate(parts):
        want = "%s.%03d" % (m["tarball"], i)
        if not isinstance(p, dict) or sorted(p) != ["bytes", "name", "sha256"]:
            raise BundleError("manifest part %d is not {name, bytes, sha256}" % i)
        if p["name"] != want:
            raise BundleError("manifest part %d is named %r, expected %r" % (i, p["name"], want))
        if not isinstance(p["sha256"], str) or not HEX64.match(p["sha256"]):
            raise BundleError("manifest part %d: sha256 is not a sha256" % i)
        last = i == len(parts) - 1
        if not is_count(p["bytes"], 1) or p["bytes"] > pb or (not last and p["bytes"] != pb):
            raise BundleError("manifest part %d has %r bytes: every part but the last is part_bytes (%d), the last 1..part_bytes"
                              % (i, p["bytes"], pb))
        total += p["bytes"]
    if total != m["bytes"]:
        raise BundleError("manifest parts hold %d bytes, bytes says %d" % (total, m["bytes"]))
    return parts, pb


def check_state_manifest(raw, profile, sums):
    """manifest.json of a state bundle against FORMAT.md and this release (the profile). Returns the
    manifest, its parts in stream order, and the largest part size."""
    try:
        m = json.loads(raw)
    except ValueError as e:
        raise BundleError("manifest.json is not JSON: %s" % e)
    if not isinstance(m, dict) or raw != canonical(m):
        raise BundleError("manifest.json is not canonical JSON")
    fmt = m.get("format")
    if fmt not in STATE_FORMATS:
        raise BundleError("manifest format %r, expected one of %s" % (fmt, ", ".join(STATE_FORMATS)))
    need = ["network", "height", "blockhash", "line", "flavour", "profile", "tarball", "sha256", "bytes", "created", "verifiers"]
    if fmt != STATE_FORMAT:
        need += ["commit", "tree_sha256", "pins"]
    if fmt == STATE_FORMAT_V3:
        need += ["part_bytes", "parts", "unpacked_bytes"]
    for key in need:
        if key not in m:
            raise BundleError("manifest lacks %s" % key)
    if m["network"] != state_network(profile) or m["profile"] != profile["testnet_profile"]:
        raise BundleError("manifest is for %s (%r); this is %s" % (m["network"], m["profile"], profile["name"]))
    if m["line"] != "ycash6":
        raise BundleError("manifest line %r: a state bundle is a ycash6 datadir" % m["line"])
    if m["flavour"] not in ("full", "full-insight"):
        raise BundleError("manifest flavour %r" % m["flavour"])
    if type(m["height"]) is not int or m["height"] < profile["heights"]["ycash_fork"]:
        raise BundleError("manifest height %r is below the fork %d (the prefix is that layer)" % (m["height"], profile["heights"]["ycash_fork"]))
    if not isinstance(m["blockhash"], str) or not HEX64.match(m["blockhash"]):
        raise BundleError("manifest blockhash is not a hash")
    if m["tarball"] != state_tarball_name(m):
        raise BundleError("manifest tarball %r does not match its name rule" % m["tarball"])
    parts, largest = manifest_parts(m)
    for p in parts:
        if sums.get(p["name"]) != p["sha256"]:
            raise BundleError("%s: SHA256SUMS and the manifest disagree (or SHA256SUMS lacks it)" % p["name"])
    verifiers = m["verifiers"]
    if not isinstance(verifiers, list) or verifiers != sorted(verifiers) or not all(isinstance(v, str) and re.fullmatch(NAME_RE, v) for v in verifiers):
        raise BundleError("manifest verifiers %r are not sorted names" % (verifiers,))
    if fmt == STATE_FORMAT and len(verifiers) < 2:
        raise BundleError("manifest verifiers %r: at least two, sorted (plan §4.2)" % (verifiers,))
    if fmt != STATE_FORMAT and "ycash6" not in verifiers:
        raise BundleError("manifest verifiers %r: %s needs statement-ycash6.json" % (verifiers, fmt))
    treestate = m.get("treestate") if fmt != STATE_FORMAT else None
    if treestate is not None and treestate != "treestate.json":
        raise BundleError("manifest treestate %r, expected 'treestate.json'" % (treestate,))
    wanted = sorted(["manifest.json"] + [p["name"] for p in parts] + ["statement-%s.json" % v for v in verifiers]
                    + ([treestate] if treestate else []), key=str.encode)
    if sorted(sums, key=str.encode) != wanted:
        raise BundleError("SHA256SUMS names %s, the manifest needs %s" % (sorted(sums), wanted))
    pins = release_pins(profile)
    if pins.get(m["height"], m["blockhash"]) != m["blockhash"]:
        raise BundleError("the bundle's block %d is %s; this release compiles %s" % (m["height"], m["blockhash"], pins[m["height"]]))
    if fmt != STATE_FORMAT:
        if not isinstance(m["tree_sha256"], str) or not HEX64.match(m["tree_sha256"]):
            raise BundleError("manifest tree_sha256 is not a sha256")
        if not isinstance(m["pins"], dict):
            raise BundleError("manifest pins is not an object")
        for key, value in m["pins"].items():
            if not re.fullmatch(r"0|[1-9]\d*", key) or int(key) > m["height"] or pins.get(int(key), value) != value:
                raise BundleError("manifest pin %s: %s is not this release's" % (key, value))
        if profile["name"] == "main":
            want = {str(h): x for h, x in pins.items() if h <= m["height"]}
            if m["pins"] != want:
                raise BundleError("manifest pins are not this release's compiled pins at or below %d" % m["height"])
    return m, parts, largest


def parse_state_sums(text):
    sums = {}
    for line in text.splitlines():
        mm = re.fullmatch(r"([0-9a-f]{64})  (%s)" % NAME_RE, line)
        if not mm or mm.group(2) in sums:
            raise BundleError("SHA256SUMS line is not '<sha256>  <name>' (or names a file twice): %r" % line[:120])
        sums[mm.group(2)] = mm.group(1)
    if list(sums) != sorted(sums, key=str.encode):
        raise BundleError("SHA256SUMS is not sorted by name")
    if "manifest.json" not in sums:
        raise BundleError("SHA256SUMS does not name manifest.json")
    return sums


class Transient(Exception):
    """A part's download broke off (the bytes received are kept for a Range request)."""


def http_get_part(url, path, size, timeout):
    """Bring `path` to `size` bytes from `url`: a Range request for what is missing when it holds some.
    A 206 appends, a 200 (a server that ignores Range) starts again from 0. Never takes more than `size`."""
    have = os.path.getsize(path) if os.path.exists(path) else 0
    if have >= size:
        return
    request = urllib.request.Request(url, headers={"Range": "bytes=%d-" % have} if have else {})
    try:
        reply = urllib.request.urlopen(request, timeout=timeout)
    except urllib.error.HTTPError as e:
        if e.code == 416:
            raise BundleError("%s: HTTP 416 at byte %d: the object is shorter than the %d bytes the manifest names" % (url, have, size))
        if e.code in (408, 429) or e.code >= 500:
            raise Transient("HTTP %d" % e.code)
        raise BundleError("%s: HTTP %d" % (url, e.code))
    except (urllib.error.URLError, OSError, http.client.HTTPException) as e:
        raise Transient(str(e) or e.__class__.__name__)
    with reply:
        mode = "wb"
        if reply.status == 206 and have:
            if not (reply.headers.get("Content-Range") or "").startswith("bytes %d-" % have):
                raise Transient("Content-Range %r does not continue at byte %d" % (reply.headers.get("Content-Range"), have))
            mode = "ab"
        elif reply.status == 200:
            if have:
                log("%s: the server ignores Range; the part starts again from 0" % url)
            have = 0
        else:
            raise BundleError("%s: HTTP %d" % (url, reply.status))
        with open(path, mode) as out:
            try:
                while True:
                    b = reply.read(min(READ_SIZE, size - have + 1))
                    if not b:
                        break
                    if have + len(b) > size:
                        raise BundleError("%s: the server sends more than the %d bytes the manifest names" % (url, size))
                    out.write(b)
                    have += len(b)
            except (OSError, http.client.HTTPException) as e:
                raise Transient("broke off at byte %d of %d: %s" % (have, size, str(e) or e.__class__.__name__))
    if have < size:
        raise Transient("the connection closed at byte %d of %d" % (have, size))


def fetch_part(source, part, directory, args):
    """Step 4-5 for one part: fetch it to <directory>/<name>.part (resuming a broken download), check
    its size and sha256 against the signed line, then rename it to <name>. Nothing of it is used before
    that. A complete part with the wrong hash is fetched once more from 0; a second mismatch refuses."""
    name, size, digest = part["name"], part["bytes"], part["sha256"]
    if not re.fullmatch(NAME_RE, name):
        raise BundleError("refusing the file name %r" % name)
    final = os.path.join(directory, name)
    if os.path.isfile(final):                       # kept (--keep-parts) or fetched by an earlier run
        if sha256_file(final) == (digest, size):
            log("%s: already here and checked" % name)
            return final
        os.remove(final)
    tmp = final + ".part"
    attempts, mismatches = 0, 0
    while True:
        try:
            if source.local is not None:
                src = os.path.join(source.local, name)
                if not os.path.isfile(src):
                    raise BundleError("%s is missing from %s" % (name, source.local))
                if os.path.getsize(src) != size:
                    raise BundleError("%s: %d bytes in %s, the manifest says %d" % (name, os.path.getsize(src), source.local, size))
                shutil.copyfile(src, tmp)
            else:
                http_get_part(source.base + name, tmp, size, args.timeout)
        except Transient as e:
            attempts += 1
            if attempts >= args.part_attempts:
                raise BundleError("%s: %d attempts failed, the last: %s" % (name, attempts, e))
            wait = args.retry_wait * 2 ** (attempts - 1)
            log("%s: %s; resuming in %.0fs (attempt %d of %d)" % (name, e, wait, attempts + 1, args.part_attempts))
            time.sleep(wait)
            continue
        got = sha256_file(tmp)
        if got == (digest, size):
            os.replace(tmp, final)
            return final
        os.remove(tmp)
        mismatches += 1
        if mismatches >= 2:
            raise BundleError("%s: %d bytes sha256 %s, SHA256SUMS says %d bytes %s (twice)" % (name, got[1], got[0], size, digest))
        log("%s: %d bytes sha256 %s, expected %s: fetching it again from 0" % (name, got[1], got[0], digest))


class PartStream:
    """The parts as one stream for the extractor: a part is fetched and checked (fetch_part) before its
    first byte is served, and deleted once it is served (unless kept), so one part is on disk at a time.
    It hashes the whole stream as it serves it."""

    def __init__(self, fetch, parts, keep):
        self.fetch, self.parts, self.keep = fetch, parts, keep
        self.index, self.f, self.path = 0, None, None
        self.sha, self.total = hashlib.sha256(), 0

    def read(self, n=-1):
        out, got = [], 0
        while n < 0 or got < n:
            if self.f is None:
                if self.index == len(self.parts) or (got and n >= 0):
                    break                                # a short read at a part's end: the next is fetched on demand
                self.path = self.fetch(self.parts[self.index])
                self.f = open(self.path, "rb")
            b = self.f.read(READ_SIZE if n < 0 else n - got)
            if not b:
                self.f.close()
                self.f = None
                if not self.keep:
                    os.remove(self.path)
                self.index += 1
                continue
            out.append(b)
            got += len(b)
        data = b"".join(out)
        self.sha.update(data)
        self.total += len(data)
        return data

    def close(self):
        if self.f is not None:
            self.f.close()
            self.f = None


def extract_stream(stream, network, flavour, staging):
    """Extract the tar.gz stream into staging, entry by entry ("r|", never seeking), with FORMAT.md's
    rules: directories and regular files under <network>/{blocks,chainstate,vaults,yellowback} only.
    <network>/ itself is stripped (mainnet's files sit at the datadir's root, as tar
    --strip-components=1 does). Returns (files, the tree hash, the regular files' total size)."""
    import tarfile
    count, unpacked, tree = 0, 0, hashlib.sha256()
    try:
        gz = gzip.GzipFile(fileobj=stream, mode="rb")
        with tarfile.open(fileobj=gz, mode="r|") as t:
            for e in t:
                name = e.name.rstrip("/")
                parts = name.split("/")
                if name.startswith("/") or ".." in parts or "" in parts:
                    raise BundleError("tar: unsafe path %r" % e.name)
                if parts[0] != network or len(parts) < 2 or parts[1] not in STATE_TOP_DIRS:
                    raise BundleError("tar: %s is not under %s/{%s}" % (e.name, network, ",".join(STATE_TOP_DIRS)))
                if STATE_LEFT_OUT.search(name) or name == "%s/yellowback/carriers.dat" % network or parts[-1] == "wallet.dat":
                    raise BundleError("tar: %s is a file the format leaves out" % e.name)
                if flavour == "full" and name.startswith("%s/blocks/insight-index" % network):
                    raise BundleError("tar: %s: the insight index is in the full-insight flavour only" % e.name)
                target = os.path.join(staging, *parts[1:])
                if e.isdir():
                    os.makedirs(target, exist_ok=True)
                elif e.isfile():
                    os.makedirs(os.path.dirname(target), exist_ok=True)
                    h = hashlib.sha256()
                    with t.extractfile(e) as src, open(target, "xb") as out:
                        while True:
                            b = src.read(READ_SIZE)
                            if not b:
                                break
                            h.update(b)
                            out.write(b)
                    tree.update(("%s  %s\n" % (h.hexdigest(), name)).encode())
                    unpacked += e.size
                    count += 1
                else:
                    raise BundleError("tar: %s is neither a file nor a directory" % e.name)
        while True:                                  # after the tar's end: its zero padding, then nothing
            b = gz.read(READ_SIZE)
            if not b:
                break
            if b.strip(b"\0"):
                raise BundleError("tar: data after the end of the archive")
    except (tarfile.TarError, EOFError, zlib.error, gzip.BadGzipFile, OSError) as e:
        raise BundleError("the bundle's stream: %s" % e)
    return count, tree.hexdigest(), unpacked


def state_statement(node, height, fields):
    """The statement fields (FORMAT.md) as this node computes them at `height`."""
    blockhash = node.cli("getblockhash", height)
    out = {"height": height, "blockhash": blockhash,
           "chainwork": json.loads(node.cli("getblockheader", blockhash))["chainwork"],
           "utxo_hash_serialized": json.loads(node.cli("gettxoutsetinfo"))["hash_serialized"]}
    vault = json.loads(node.cli("vault_getinfo"))
    if vault.get("dbtip") is None:
        out["vault_statehash"] = None
    elif vault["dbtip"].get("hash") != blockhash:
        raise BundleError("vault_getinfo is at %s, not %s" % (vault["dbtip"].get("hash"), blockhash))
    else:
        out["vault_statehash"] = vault.get("statehash")
    yed = node.cli("yed_getstatehash", height, check=False)
    if yed is None:
        out["yed_statehash"] = None
    else:
        yed = json.loads(yed)
        if yed.get("blockhash") != blockhash:
            raise BundleError("yed_getstatehash answered for %s, not %s" % (yed.get("blockhash"), blockhash))
        out["yed_statehash"] = yed.get("statehash")
    if "finalsaplingroot" in fields or "chainsupply_zat" in fields:
        block = json.loads(node.cli("getblock", blockhash, 1))
        out["finalsaplingroot"] = block.get("finalsaplingroot")
        out["chainsupply_zat"] = (block.get("chainSupply") or {}).get("chainValueZat")
    return out


def check_disk(args, m, largest, work):
    """Step 3: refuse up front, with numbers, unless the restore fits: the unpacked datadir (the
    manifest's unpacked_bytes, which v3 always has; without it 1.5 x the tarball's size: the published
    3,100,949 bundle unpacks to 56.1 GB from 41.8 GB) plus one part and 1 GiB on the datadir's file
    system; with --keep-parts, every part too."""
    unpacked = m["unpacked_bytes"] if is_count(m.get("unpacked_bytes")) else m["bytes"] * 3 // 2
    on_datadir = unpacked + GIB
    in_work = largest + (m["bytes"] if args.keep_parts else 0)
    os.makedirs(work, exist_ok=True)
    needs = [(args.datadir, on_datadir), (work, in_work)]
    if os.stat(args.datadir).st_dev == os.stat(work).st_dev:
        needs = [(args.datadir, on_datadir + in_work)]
    for path, need in needs:
        free = shutil.disk_usage(path).free
        if free < need:
            raise BundleError("not enough disk at %s: the restore needs %.1f GB free (the datadir %.1f GB, one part %.1f GB, "
                              "1 GiB margin%s), %.1f GB are free" % (path, need / 1e9, unpacked / 1e9, largest / 1e9,
                                                                     ", every part (--keep-parts)" if args.keep_parts else "", free / 1e9))


def resolve_latest(source, download):
    """Step 1: `latest/` holds only manifest.json, and a short cache lifetime: it is read for `height`
    only, and every file comes from `../<height>/`. Returns (the source to read, the height or None)."""
    if source.last_segment() != "latest":
        return source, None
    path = os.path.join(download, "latest-manifest.json")
    source.fetch("manifest.json", path)
    try:
        with open(path, encoding="utf-8") as f:
            height = json.load(f).get("height")
    except (ValueError, AttributeError) as e:
        raise BundleError("%smanifest.json does not name a height: %s" % (source, e))
    finally:
        if os.path.exists(path):
            os.remove(path)
    if type(height) is not int or height < 0:
        raise BundleError("%smanifest.json names height %r" % (source, height))
    rebased = source.sibling(str(height))
    log("%s names height %d: every file is read from %s" % (source, height, rebased))
    return rebased, height


def restore_state(args, profile, netdir):
    """§4.4 for a state bundle: the anchors first, then the parts, streamed and checked, into a staging
    directory; installed only when the whole stream matches; then the node checks the statement at H."""
    work = args.work_dir
    download = os.path.join(work, "download")
    os.makedirs(download, exist_ok=True)
    source, latest = resolve_latest(Source(args.source), download)
    sums_path = os.path.join(download, "SHA256SUMS")
    source.fetch("SHA256SUMS", sums_path)
    signed = check_signature(source, sums_path, args, profile, True, False,
                             "the statements, the pins and the node's own check at H are the anchors")
    with open(sums_path, encoding="ascii", errors="replace") as f:
        sums = parse_state_sums(f.read())
    path = os.path.join(download, "manifest.json")
    source.fetch("manifest.json", path)
    if sha256_file(path)[0] != sums["manifest.json"]:
        raise BundleError("manifest.json does not match SHA256SUMS")
    with open(path, encoding="utf-8") as f:
        m, parts, largest = check_state_manifest(f.read(), profile, sums)
    if latest is not None and m["height"] != latest:
        raise BundleError("latest/ names height %d, the manifest at %s says %d" % (latest, source, m["height"]))
    fields = V2_STATEMENT_FIELDS if m["format"] != STATE_FORMAT else STATEMENT_FIELDS
    first = None
    for v in m["verifiers"]:
        name = "statement-%s.json" % v
        spath = os.path.join(download, name)
        source.fetch(name, spath)
        if sha256_file(spath)[0] != sums[name]:
            raise BundleError("%s does not match SHA256SUMS" % name)
        with open(spath, encoding="utf-8") as f:
            raw = f.read()
        try:
            statement = json.loads(raw)
        except ValueError as e:
            raise BundleError("%s is not JSON: %s" % (name, e))
        if not isinstance(statement, dict) or raw != canonical(statement) or not {"network", "height", "blockhash"} <= set(statement) <= set(fields):
            raise BundleError("%s is not a canonical statement" % name)
        if any(m.get(k) != val for k, val in statement.items()):
            raise BundleError("%s disagrees with the manifest" % name)
        if first is not None and raw != first:
            raise BundleError("%s differs from statement-%s.json" % (name, m["verifiers"][0]))
        first = raw
    statement = json.loads(first)
    if m.get("treestate") and m["format"] != STATE_FORMAT:
        tpath = os.path.join(download, "treestate.json")
        source.fetch("treestate.json", tpath)
        if sha256_file(tpath)[0] != sums["treestate.json"]:
            raise BundleError("treestate.json does not match SHA256SUMS")
    log("manifest: %s %s at %d (%s), %d bytes in %d part(s); %s" % (m["format"], m["network"], m["height"], m["flavour"], m["bytes"],
                                                                   len(parts), "signed" if signed else "NOT signed"))
    check_disk(args, m, largest, work)
    staging = os.path.join(args.datadir, STAGING)
    shutil.rmtree(staging, ignore_errors=True)        # an interrupted run's: the gzip stream restarts at part 0
    os.makedirs(staging)
    installed = []
    try:
        stream = PartStream(lambda p: fetch_part(source, p, download, args), parts, args.keep_parts)
        try:
            files, tree, unpacked = extract_stream(stream, m["network"], m["flavour"], staging)
        finally:
            stream.close()
        if stream.index != len(parts) or (stream.total, stream.sha.hexdigest()) != (m["bytes"], m["sha256"]):
            raise BundleError("the stream is %d bytes sha256 %s, the manifest says %d bytes %s"
                              % (stream.total, stream.sha.hexdigest(), m["bytes"], m["sha256"]))
        if m["format"] != STATE_FORMAT and tree != m["tree_sha256"]:
            raise BundleError("the tree hash of the extracted files is %s, the manifest says %s" % (tree, m["tree_sha256"]))
        if m["format"] == STATE_FORMAT_V3 and unpacked != m["unpacked_bytes"]:
            raise BundleError("the extracted files hold %d bytes, unpacked_bytes says %d" % (unpacked, m["unpacked_bytes"]))
        log("extracted %d files of %s (height %d, %s); the stream and the tree hash match the manifest"
            % (files, m["tarball"], m["height"], m["flavour"]))
        os.makedirs(netdir, exist_ok=True)
        for top in STATE_TOP_DIRS:                     # one rename per directory, on the same file system
            src, dst = os.path.join(staging, top), os.path.join(netdir, top)
            if os.path.isdir(src):
                if os.path.isdir(dst):
                    os.rmdir(dst)                      # empty (restore() refused a non-empty one)
                os.replace(src, dst)
                installed.append(dst)
        shutil.rmtree(staging)
        record = {"format": m["format"], "profile": profile["name"], "source": str(source), "height": m["height"], "blockhash": m["blockhash"],
                  "flavour": m["flavour"], "version": m.get("version"), "verifiers": m["verifiers"], "signed": signed,
                  "sha256sums_sha256": sha256_file(sums_path)[0], "sha256": m["sha256"], "parts": len(parts)}
        if args.ycashd and args.cli:
            record["check"] = check_state(args, profile, m, statement, import_conf(args, work))
        else:
            record["check"] = "skipped: no --ycashd/--cli"
            log("no --ycashd/--cli: the statements were not checked against a node (start it offline and compare them yourself)")
        with open(os.path.join(netdir, "bootstrap.json"), "w", encoding="utf-8") as f:
            f.write(json.dumps(record, indent=2, sort_keys=True) + "\n")
    except BaseException:
        shutil.rmtree(staging, ignore_errors=True)    # a state not confirmed to the end is not left behind
        for d in installed:
            shutil.rmtree(d, ignore_errors=True)
        raise
    if not args.keep:
        shutil.rmtree(work)
    if args.ycashd and args.cli:
        log("done: %s holds the %s state at height %d; start the node normally" % (netdir, profile["name"], m["height"]))
    else:
        log("done: %s holds the %s state at height %d, but the node check was SKIPPED (no --ycashd/--cli): the files match the "
            "signed manifest, the state was not compared with the statement at %d; start the node offline and compare it, or "
            "restore again with --ycashd and --cli" % (netdir, profile["name"], m["height"], m["height"]))
    return 0


def check_state(args, profile, m, statement, conf):
    """Start the restored node offline; roll back to H if it connected blocks above it (FORMAT.md, "Blocks
    above H_B"), compare every statement field and the manifest's pins, then reconsider so the datadir
    keeps no failed-block mark."""
    height = m["height"]
    node = Node(args, profile, args.rpcport or free_port(), conf)
    insight = ["-experimentalfeatures", "-insightexplorer", "-txindex"] if m["flavour"] == "full-insight" else []
    node.start([], False, args.dbcache, insight)
    try:
        prev, still, t0 = None, 0, time.time()
        while still < 3:                                  # until the tip has settled (it connects the blocks above H it holds)
            time.sleep(args.poll)
            if not node.alive():
                raise BundleError("ycashd exited (status %s): %s" % (node.process.returncode, node.error_text()))
            text = node.cli("getblockcount", check=False)
            if text is None:
                continue
            tip = int(text)
            node.check_offline()
            still = still + 1 if tip == prev else 0
            prev = tip
            if time.time() - t0 > args.stall_timeout:
                raise BundleError("the restored node did not settle within %ds" % args.stall_timeout)
        if prev < height:
            raise BundleError("the restored node is at %d, below the bundle's %d" % (prev, height))
        for key, want in sorted((m.get("pins") or {}).items(), key=lambda kv: int(kv[0])):
            got = node.cli("getblockhash", int(key))
            if got != want:
                raise BundleError("the restored node's block %s is %s, the pin is %s" % (key, got, want))
        invalidated = None
        if prev > height:
            invalidated = node.cli("getblockhash", height + 1)
            node.cli("invalidateblock", invalidated)
            if int(node.cli("getblockcount")) != height:
                raise BundleError("invalidateblock %s did not bring the tip to %d" % (invalidated, height))
        mine = state_statement(node, height, statement)
        node.check_offline()
        mine["network"] = m["network"]
        bad = {k: (statement[k], mine.get(k)) for k in statement if mine.get(k) != statement[k]}
        if invalidated:
            node.cli("reconsiderblock", invalidated)
        if bad:
            raise BundleError("the restored node disagrees with the statements at %d: %s" % (height, json.dumps(bad, sort_keys=True)))
        log("the restored node agrees with the statements at %d (%s) and %d pin(s); tip %d"
            % (height, ", ".join(sorted(statement)), len(m.get("pins") or {}), prev))
        return {"tip": prev, "rolled_back_from": prev if invalidated else None, "fields": sorted(statement)}
    finally:
        node.stop()


