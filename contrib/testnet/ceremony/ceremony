    return out


# ---------------------------------------------------------------------------------- the gap scan (C-T6)

ACT_NAMES = {0x01: "SET_CREATE", 0x02: "SET_JOIN", 0x03: "SET_HEARTBEAT", 0x04: "SET_REMOVE", 0x05: "SET_EQUIVOCATION",
             0x06: "SET_WINDDOWN"}                     # src/vault/act.h ActType
TAG_PATTERNS = {"v1": "2459454421", "v2": "3159454421"}   # push 36 / push 49 + "YED!" (yellowback/tag.cpp FindTag)


def first_push(script_hex):
    """The data of the first push after OP_RETURN in a scriptPubKey (hex), or None."""
    try:
        b = bytes.fromhex(script_hex)
    except ValueError:
        return None
    if len(b) < 2 or b[0] != 0x6a:
        return None
    op, i = b[1], 2
    if op <= 0x4b:
        n = op
    elif op == 0x4c and len(b) >= 3:
        n, i = b[2], 3
    elif op == 0x4d and len(b) >= 4:
        n, i = int.from_bytes(b[2:4], "little"), 4
    else:
        return None
    return b[i:i + n] if len(b) >= i + n else None


def scan_block(block, setid):
    """The findings of one verbose block (getblock <hash> 2): acts naming `setid` and coinbase tag patterns."""
    target = bytes.fromhex(setid)[::-1]   # a SetId is pushed as its 32 internal bytes (vault/template.h)
    found = []
    for n, tx in enumerate(block.get("tx", [])):
        if n == 0:
            for vin in tx.get("vin", []):
                sig = vin.get("coinbase", "")
                for version, pattern in sorted(TAG_PATTERNS.items()):
                    if pattern in sig.lower():
                        found.append({"height": block["height"], "txid": tx["txid"], "kind": "tag-" + version})
            continue
        for vout in tx.get("vout", []):
            data = first_push(vout.get("scriptPubKey", {}).get("hex", ""))
            if data is None or len(data) < 4 or data[:3] != b"YV\x01" or data[3] not in ACT_NAMES:
                continue
            names = tx["txid"] == setid if data[3] == 0x01 else data[4:36] == target
            if names:
                found.append({"height": block["height"], "txid": tx["txid"], "kind": ACT_NAMES[data[3]]})
    return found


def record_txids(record):
    """Every 64-hex string a ceremony record holds (the set's creation and the seats' joins)."""
    out = set()

    def walk(v):
        if isinstance(v, dict):
            for x in v.values():
                walk(x)
        elif isinstance(v, list):
            for x in v:
                walk(x)
        elif isinstance(v, str) and len(v) == 64 and all(c in HEX_DIGITS for c in v):
            out.add(v)
    walk(record)
    return out


def gap_scan(rpc, setid, start, stop, known=frozenset(), log=print):
    """Scan blocks start..stop; return (the ceremony's own acts, findings)."""
    own, findings = [], []
    for h in range(start, stop + 1):
        block = rpc.call("getblock", rpc.call("getblockhash", h), 2)
        for f in scan_block(block, setid):
            (own if f["kind"].startswith("SET_") and f["txid"] in known else findings).append(f)
        if (h - start) % 5000 == 0:
            log("gap-scan: height %d of %d" % (h, stop))
    return own, findings


def gap_scan_main(argv):
    ap = argparse.ArgumentParser(prog="ceremony gap-scan")
    ap.add_argument("--network", required=True, choices=list(ybprofile.NETWORKS))
    ap.add_argument("--datadir", required=True)
    ap.add_argument("--conf")
    ap.add_argument("--rpcport", type=int)
    ap.add_argument("--cli")
    ap.add_argument("--setid", help="the attestor set id (default: the --record's release.attestorSetId)")
    ap.add_argument("--record", help="the ceremony record: its txids are the ceremony's own acts")
    ap.add_argument("--from", dest="start", type=int, help="first height (default: the profile's Vault height)")
    ap.add_argument("--to", dest="stop", type=int, help="last height (default: the tip)")
    ap.add_argument("--json", action="store_true", help="print the result as JSON")
    a = ap.parse_args(argv)
    profile = ybprofile.load(a.network)
    rpc = CliRPC(a.cli or shutil.which("ycash-cli") or os.path.join(REPO, "src", "ycash-cli"), a.datadir, profile, a.conf, a.rpcport)
    record = {}
    if a.record:
        with open(a.record) as f:
            record = json.load(f)
    setid = a.setid or (record.get("release") or {}).get("attestorSetId")
    start = a.start if a.start is not None else profile["vault_height"]
    try:
        if not setid or len(setid) != 64 or any(c not in HEX_DIGITS for c in setid):
            raise CeremonyError("no set id (--setid, or a --record with release.attestorSetId)")
        if start is None:
            raise CeremonyError("%s has no Vault height: pass --from" % a.network)
        stop = a.stop if a.stop is not None else rpc.call("getblockcount")
        own, findings = gap_scan(rpc, setid, start, stop, record_txids(record),
                                 log=lambda m: print(m, file=sys.stderr))
    except CeremonyError as e:
        print("ceremony gap-scan: stopped: %s" % e, file=sys.stderr)
        return 2
    result = {"setid": setid, "from": start, "to": stop, "ceremony": own, "findings": findings, "clean": not findings}
    if a.json:
        print(canonical(result), end="")
    else:
        for f in own:
            print("ceremony %-16s %d %s" % (f["kind"], f["height"], f["txid"]))
        for f in findings:
            print("FINDING  %-16s %d %s" % (f["kind"], f["height"], f["txid"]))
        print("gap-scan %d..%d: %d ceremony act(s), %d finding(s): %s" % (start, stop, len(own), len(findings),
              "clean" if not findings else "rerun the ceremony with a new set"))
    return 0 if not findings else 1


def main(argv=None):
    argv = sys.argv[1:] if argv is None else list(argv)
    if argv[:1] == ["gap-scan"]:
        return gap_scan_main(argv[1:])
    if argv[:1] == ["rehearse"]:
        argv = rehearse_argv(argv[1:])
    if argv[:1] in (["host-key"], ["host-sign"]):
        return host_main(argv[0], argv[1:])
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0], epilog=__doc__.split("\n", 2)[2], formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--network", choices=[n for n in ybprofile.NETWORKS if n != "regtest"], help="the testnet to launch")
    ap.add_argument("--datadir", help="the ceremony node's -datadir")
    ap.add_argument("--conf", help="its ycash.conf (default: DATADIR/ycash.conf)")
    ap.add_argument("--rpcport", type=int, help="its RPC port (default: the profile's)")
    ap.add_argument("--cli", help="ycash-cli (default: on PATH, else src/ycash-cli; a rehearsal: beside --ycashd)")
    ap.add_argument("--secrets", dest="keydir", help="directory for the house seats' keys: outside any git repository")
    ap.add_argument("--out", help="the ceremony record (default ./ceremony-<network>.json); re-runs continue from it")
    ap.add_argument("--member-keys", dest="member_keys", help="C-T7: JSON {\"hosts\": {\"a\": [member key, ...], ...}} of the keys born on the seat hosts (`host-key`); the ceremony then never holds a seat key")
    ap.add_argument("--handoff", help="with --member-keys: the directory of the unsigned joins and the hosts' signed copies (default: <out dir>/<network>-joins)")
    ap.add_argument("--steps", help="comma-separated subset of: " + ",".join(STEPS) + " (check always runs)")
    ap.add_argument("--no-mine", dest="mine", action="store_false", help="a testnet: wait for the other operators' blocks instead of setgenerate")
    ap.add_argument("--genproclimit", type=int, default=1)
    ap.add_argument("--seats", type=int, help="house seats (default: the profile's, T-5)")
    ap.add_argument("--bond", help="YEC per house seat (default: the profile's, the module's bond floor)")
    ap.add_argument("--poll", type=float, default=5.0, help="seconds between block-count polls")
    ap.add_argument("--max-blocks-wait", type=int, default=0, help="give up after this many blocks without reaching a target (0: never)")
    ap.add_argument("--confirm-blocks", type=int, default=6, help="blocks to wait for a ceremony transaction to confirm")
    ap.add_argument("--rehearse", action="store_true", help="run the whole ceremony on regtest (spawns its own nodes)")
    ap.add_argument("--like", default="testnet-yb-fast", choices=("testnet-yb-fast", "testnet-yb-slow", "testnet-legacy"), help="rehearsal: the network whose seats and fork-to-Vault distance to use")
    ap.add_argument("--ycashd", default=os.environ.get("ZCASHD") or os.environ.get("BITCOIND") or os.path.join(REPO, "src", "ycashd"))
    ap.add_argument("--workdir", help="rehearsal: the output directory (default: a new temporary one)")
    ap.add_argument("--prefix-height", type=int, default=50, help="rehearsal: the regtest prefix's last height")
    ap.add_argument("--portseed", type=int, default=os.getpid() % 4000 + 1000, help="rehearsal: the functional framework's port seed")
    opts = ap.parse_args(argv)
    try:
        if opts.rehearse:
            opts.poll = min(opts.poll, 0.5)
            return rehearse(opts)
        if not (opts.network and opts.datadir and (opts.keydir or opts.member_keys)):
            ap.error("a ceremony needs --network, --datadir and --member-keys (or --secrets) (or --rehearse)")
        profile = ybprofile.load(opts.network)
        steps = None
        if opts.steps:
            steps = tuple(s for s in opts.steps.split(",") if s)
            unknown = set(steps) - set(STEPS)
            if unknown:
                ap.error("unknown steps: %s" % ", ".join(sorted(unknown)))
        if opts.keydir:
            prepare_secrets(opts.keydir)
        rpc = CliRPC(opts.cli or shutil.which("ycash-cli") or os.path.join(REPO, "src", "ycash-cli"), opts.datadir, profile, opts.conf, opts.rpcport)
        out = os.path.abspath(opts.out or "ceremony-%s.json" % opts.network)
        Ceremony(rpc, profile, opts, out).run(steps)
        return 0
    except CeremonyError as e:
        print("ceremony: stopped: %s" % e, file=sys.stderr)
        return 2


def host_main(command, argv):
    """`ceremony host-key|host-sign`: on a seat host, against its own node (C-T7)."""
    ap = argparse.ArgumentParser(prog="ceremony " + command)
    ap.add_argument("--network", required=True, choices=list(ybprofile.NETWORKS))
    ap.add_argument("--datadir", required=True)
    ap.add_argument("--conf")
    ap.add_argument("--rpcport", type=int)
    ap.add_argument("--cli")
    if command == "host-sign":
        ap.add_argument("--join", required=True, help="the ceremony's <network>-seat-N-<host>.join.json")
    a = ap.parse_args(argv)
    profile = ybprofile.load(a.network)
    rpc = CliRPC(a.cli or shutil.which("ycash-cli") or os.path.join(REPO, "src", "ycash-cli"), a.datadir, profile, a.conf, a.rpcport)
    try:
        if command == "host-key":
            print(canonical(host_key(rpc)), end="")
        else:
            host_sign(rpc, a.network, a.join)
        return 0
    except CeremonyError as e:
        print("ceremony %s: stopped: %s" % (command, e), file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
