{
  "_comment": "Semgrep scan policy for this node line (contrib/semgrep/README.md). Identical in ycash-dd and ycash6.",
  "semgrep_version": "1.179.0",
  "semgrep_image": "semgrep/semgrep:1.179.0@sha256:93963d9295a366f59e4850127b1550400ee7b388f04fe144e4a1f6325d96e01b",
  "rules_repo": "https://github.com/semgrep/semgrep-rules",
  "rules_commit": "16b9e6d45f10649f6a531ec4838ed9924372c3bc",
  "rule_paths": [
    "c",
    "rust",
    "python/lang/security",
    "bash",
    "dockerfile",
    "generic/secrets",
    "yaml/github-actions"
  ],
  "local_rules": "contrib/semgrep/rules",
  "categories": ["security"],
  "exclude_rules": {
    "rust.lang.security.unsafe-usage": "Every `unsafe` block in src/rust is the C++/Rust FFI boundary by design; the audit rule flags each one (191 hits, INFO) and would bury real findings."
  },
  "non_production_paths": [
    "qa/**",
    "src/test/**",
    "src/gtest/**",
    "src/bench/**",
    "src/fuzz*/**",
    "contrib/**",
    "zcutil/**",
    "doc/**",
    "test/**",
    "*.md"
  ],
  "buckets": {
    "critical": {"sla_days": 7,   "color": "b60205", "label": "semgrep:critical"},
    "high":     {"sla_days": 30,  "color": "d93f0b", "label": "semgrep:high"},
    "medium":   {"sla_days": 90,  "color": "fbca04", "label": "semgrep:medium"},
    "low":      {"sla_days": 180, "color": "0e8a16", "label": "semgrep:low"}
  },
  "autofix_rules": [],
  "autofix_never_paths": [
    "src/consensus/**",
    "src/script/**",
    "src/primitives/**",
    "src/pow/**",
    "src/main.cpp",
    "src/crypto/pq/falcon/**",
    "src/crypto/pq/slhdsa/**"
  ],
  "fail_on": ["critical"],
  "base_branch": "upgrade/vault",
  "branch_prefix": "semgrep/",
  "pr_labels": ["security", "semgrep"],
  "overdue_label": "sla:overdue"
}
