def lightwalletd_command(directory, binary, port, node=USER, extra=None):
    """The zcash/lightwalletd 0.4.6 lineage (yodl): the four --rpc* flags bypass its conf file
    (frontend/rpc_client.go), --data-dir must be writable (its default is /var/lib/lightwalletd),
    --no-tls-very-insecure serves plaintext gRPC on --grpc-bind-addr, metrics on --http-bind-addr."""
    user, password = rpc_auth_pair(node)
    data_dir = os.path.join(node_dir(directory, node), "lightwalletd")
    os.makedirs(data_dir, exist_ok=True)
    return [binary, "--rpcuser", user, "--rpcpassword", password, "--rpchost", "127.0.0.1", "--rpcport", str(rpc_port(node)),
            "--no-tls-very-insecure", "--grpc-bind-addr", "127.0.0.1:%d" % port, "--http-bind-addr", "127.0.0.1:%d" % (port + 2000),
            "--data-dir", data_dir, "--log-file", os.path.join(node_dir(directory, node), "lightwalletd.log")] + list(extra or [])

def lightwalletd_probe(port, timeout=5, yellowback=False):
    """GetLightdInfo + GetLatestBlock (and, with yellowback, every YellowbackStreamer method once)
    through the fork's cmd/lwdinfo (needs go); dict or raises."""
    command = ["go", "run", "-mod=vendor", "./testtools/lwdinfo", "-server", "127.0.0.1:%d" % port, "-timeout", "%ds" % timeout]
    if yellowback: command.append("-yellowback")
    out = subprocess.check_output(command, cwd=LWD_REPO, text=True, stderr=subprocess.PIPE)
    return json.loads(out)

def lightwalletd_check(state):
    """None when the recorded server answers and follows node 0; else the problem."""
    lwd = state.get("lightwalletd") or {}
    if not agent_alive(lwd.get("pid")): return "lightwalletd (pid %s) is not running" % lwd.get("pid")
    # The ingestor polls the node every 5 s; right after `start` the cache is legitimately empty.
    for _ in range(4):
        try: info = lightwalletd_probe(lwd["port"])
        except subprocess.CalledProcessError as error: return "lightwalletd probe failed: %s" % error.stderr.strip()
        if "latestHeight" in info: break
        time.sleep(5)
    if info.get("chainName") != "regtest": return "lightwalletd reports chain %r, not regtest" % info.get("chainName")
    height = rpc(state, USER).getblockcount()
    if "latestHeight" not in info: return "lightwalletd has no cached block after 20s (%s)" % info.get("latestError")
    if abs(int(info["latestHeight"]) - height) > 2: return "lightwalletd is at %s, node0 at %d" % (info["latestHeight"], height)
    if "--yellowback" in (lwd.get("extra") or []):   # this lineage's cobra flag (the yecdev build took -yellowback)
        # Started with the flag: every YellowbackStreamer method must answer (ok, or the node's own
        # FailedPrecondition for a harmless input); Unimplemented means the service is not registered.
        try: yed = lightwalletd_probe(lwd["port"], yellowback=True)["yellowback"]
        except subprocess.CalledProcessError as error: return "lightwalletd yellowback probe failed: %s" % error.stderr.strip()
        bad = {k: v for k, v in yed.items() if "#" not in k and not (v == "ok" or v.startswith("FailedPrecondition"))}
        if bad: return "lightwalletd Yellowback methods not answering: %s" % json.dumps(bad, sort_keys=True)
        if yed.get("GetYellowbackInfo#rpcversion") != "3": return "lightwalletd reports yed rpcversion %s" % yed.get("GetYellowbackInfo#rpcversion")
    return None

def lightwalletd(args):
    directory, state = os.path.abspath(args.dir), load(os.path.abspath(args.dir))
    lwd = state.get("lightwalletd") or {}
    if args.action == "status":
        if not lwd: print("no lightwalletd started (`lightwalletd start`)"); return
        print("lightwalletd pid %s port %s %s, %s" % (lwd.get("pid"), lwd.get("port"), lwd.get("binary"), "running" if agent_alive(lwd.get("pid")) else "not running"))
        if agent_alive(lwd.get("pid")):
            try: print(json.dumps(lightwalletd_probe(lwd["port"]), indent=2))
            except subprocess.CalledProcessError as error: print("probe failed: %s" % error.stderr.strip()); return 1
        return
    if args.action == "stop":
        _kill(lwd.get("pid"), "lightwalletd"); state.pop("lightwalletd", None); save(directory, state); return
    binary = lightwalletd_binary(args.baseline, args.bin)
    if not args.baseline and not args.bin and not os.access(binary, os.X_OK):
        os.makedirs(os.path.dirname(binary), exist_ok=True)
        print("building %s from %s" % (binary, LWD_REPO))
        subprocess.check_call(["go", "build", "-mod=vendor", "-o", binary, "."], cwd=LWD_REPO, env=dict(os.environ, CGO_ENABLED="0"))
    if not os.access(binary, os.X_OK):
        sys.exit("lightwalletd not found at %s%s" % (binary, "; build it with lightwalletd-dd/scripts/build-baseline.sh" if args.baseline else ""))
    import shlex
    extra = shlex.split(args.extra)
    command = lightwalletd_command(directory, binary, args.port, extra=extra)
    if args.print: print(" ".join(command)); return
    if agent_alive(lwd.get("pid")): sys.exit("lightwalletd already running (pid %d); `lightwalletd stop` first" % lwd["pid"])
    process = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    state["lightwalletd"] = {"pid": process.pid, "port": args.port, "binary": binary, "baseline": bool(args.baseline), "extra": extra}
    save(directory, state)
    print("lightwalletd started on 127.0.0.1:%d against node0 (pid %d): %s" % (args.port, process.pid, binary))
    for _ in range(30):
        time.sleep(1)
        try: info = lightwalletd_probe(args.port, timeout=3)
        except subprocess.CalledProcessError: continue
        print("GetLightdInfo: %s %s chain=%s height=%s" % (info.get("vendor"), info.get("version"), info.get("chainName"), info.get("latestHeight", info.get("blockHeight"))))
        return
    print("started, but GetLightdInfo did not answer within 30s (see node0/lightwalletd.log)", file=sys.stderr); return 1

def wait(nodes, state=None):
    sync_blocks(nodes)
    pools = auto_pools(state) if state else POOLS
    attestors = auto_attestors(state) if state else ATTESTORS
    for index in (USER,) + tuple(pools) + tuple(a for a in attestors if a < len(nodes)):
        wait_yed_healthy(nodes[index])

