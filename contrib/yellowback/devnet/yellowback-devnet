def check(state, verbose=True):
    node = rpc(state, USER)
    activation, stats = node.yed_getactivation(), node.yed_getstats()
    # Only the automated pools are promised eligible: in the pool preset your own pool starts as a
    # plain miner, and its eligibility is your work, not the devnet's.
    expected = {pool_address(state, pool) for pool in auto_pools(state)}
    eligible = {row["payoutAddress"] for row in node.yed_listminers() if row["eligible"]}
    errors = []
    if activation["status"] != "active": errors.append("activation is %s" % activation["status"])
    if not stats["mintingAllowed"]: errors.append("minting is not allowed (halts: %s)" % ",".join(stats.get("haltMask") or []) )
    if not expected <= eligible: errors.append("not all automated pools are eligible")
    if node.getbalance() <= 0 and role_of(state) == "none": errors.append("node0 has no mature balance")
    if verbose: print("activation: %s; minting: %s; eligible pools: %d/%d automated; node0 balance: %s YEC" % (activation["status"], "yes" if stats["mintingAllowed"] else "no", len(eligible & expected), len(expected), node.getbalance()))
    if attestors_of(state):
        attest = node.yed_getinfo()["attest"]
        if attest["status"] != "ARMED": errors.append("attestation is %s, not ARMED" % attest["status"])
        if attest["poolFresh"] < M_SELECT:
            errors.append("poolFresh is %d, below M_SELECT (%d): no mint can build a bundle" % (attest["poolFresh"], M_SELECT))
        seated = attest["seatedCount"]
        if seated < ATTEST_ARM_MIN: errors.append("only %d attestors seated (need %d)" % (seated, ATTEST_ARM_MIN))
        stopped = set(state.get("stopped_agents") or [])
        dead = [name for name, pid in attest_pids(state).items() if not agent_alive(pid)]
        if dead: errors.append("attest agents not running: %s%s" % (", ".join(sorted(dead)), " (stopped deliberately)" if set(dead) <= stopped else ""))
        if verbose: print("attestation: %s; seated %d; poolFresh %d/%d; pool size %d; agents %d up"
                          % (attest["status"], seated, attest["poolFresh"], M_SELECT, attest["poolSize"],
                             len([1 for pid in attest_pids(state).values() if agent_alive(pid)])))
    for name in ("heartbeat", "walk", "sim"):
        record = state.get(name) or {}
        if record.get("pid") and not agent_alive(record["pid"]) and not record.get("stopped"):
            errors.append("%s process (pid %d) is not running; see %s/%s.log" % (name, record["pid"], state["dir"], name))
    for node, record in sorted((state.get("stratum") or {}).items()):
        if record.get("pid") and not agent_alive(record["pid"]) and not record.get("stopped"):
            errors.append("yolo beside node%s (pid %d) is not running; see %s/stratum-%s.log" % (node, record["pid"], state["dir"], node))
        elif agent_alive(record.get("pid")) and not stratum_status(record):
            errors.append("yolo beside node%s answers nothing on /status (port %s)" % (node, record.get("status_port")))
    if errors: raise RuntimeError("devnet check failed: " + "; ".join(errors))

def liveness(state):
    """What the heartbeat needs to keep mining: cheaper and narrower than `check`. A halted mint
    (a price shock trips DIVERGENCE for a window) is weather the scenarios want to live through;
    a dead node, a lost arming or a dead automated agent is a broken devnet to stop burying."""
    errors = []
    if not alive(state, USER): return ["node0 is down"]
    node = rpc(state, USER)
    try:
        info = node.yed_getinfo()
        if info["activation"]["status"] != "active": errors.append("activation is %s" % info["activation"]["status"])
        if attestors_of(state) and info["attest"]["status"] != "ARMED": errors.append("attestation is %s" % info["attest"]["status"])
    except Exception as error:
        errors.append("yed_getinfo on node0: %s" % error)
    stopped = set(state.get("stopped_agents") or [])       # `attestor N stop` / `pool N quote stop`: deliberate, not a crash
    for name, pid in attest_pids(state).items():
        if name not in stopped and not agent_alive(pid): errors.append("%s is dead" % name)
    for pool, pid in agent_pids(state).items():
        if pool in auto_pools(state) and ("quote-%d" % pool) not in stopped and not agent_alive(pid): errors.append("quote agent of node%d is dead" % pool)
    for pool in auto_pools(state):
        if not alive(state, pool): errors.append("node%d (automated pool) is down" % pool)
    return errors

