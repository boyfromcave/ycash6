            try: os.kill(pid, 15); print("stopping quote agent of node%d (pid %d)" % (node, pid))
            except OSError as error: print("agent of node%d: %s" % (node, error))
def wait_quotes(state, since=None, timeout=60, pools=None):
    """Wait until every automated pool's next tag is a quote; with `since` (a wall-clock time),
    until each pool's quote was stamped at least two seconds after it, so the agents have re-read
    the mock."""
    pools = auto_pools(state) if pools is None else pools
    deadline = time.time() + timeout
    while True:
        miners = {node: rpc(state, node).yed_getinfo()["miner"] for node in pools}
        def fresh(miner):
            if miner["quoteKind"] != "quote": return False
            return since is None or (time.time() - since) - miner["quoteAgeSeconds"] >= 2
        if all(fresh(miner) for miner in miners.values()): return
        if time.time() > deadline: raise RuntimeError("quote agents did not publish within %ds: %s" % (timeout, {node: miner["quoteKind"] for node, miner in miners.items()}))
        time.sleep(0.5)
