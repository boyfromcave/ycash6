def _spawn(directory, name, argv, env=None):
    """One detached agent process logging to <dir>/<name>.log; returns its pid."""
    log = open(os.path.join(directory, "%s.log" % name), "a")
    process = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=log, env=env,
                               stderr=subprocess.STDOUT, start_new_session=True)
    log.close()
    return process.pid

def mark_stopped(state, name, stopped):
    """Record a deliberate stop (`attestor N stop`, `pool N quote stop`) so the heartbeat's
    liveness check and `check` do not read the dead process as a broken devnet."""
    names = set(state.get("stopped_agents") or [])
    (names.add if stopped else names.discard)(name)
    state["stopped_agents"] = sorted(names)

def node_pids(directory):
    """Every ycashd whose -datadir is under this devnet, by process, not by RPC. A node whose RPC
    is broken (one answered 500 to getblockcount after its directory was wiped under it) looks
    "down" to `alive()` yet still holds its ports, and the next `up` dies with "Unable to start
    HTTP server" (F-14)."""
    try:
        out = subprocess.run(["pgrep", "-f", "ycashd.*-datadir=%s/node" % directory], capture_output=True, text=True).stdout
    except OSError:
        return []
    return [int(x) for x in out.split() if x.isdigit()]

def kill_nodes(directory, grace=30):
    """SIGTERM every remaining node process of this devnet, wait for them, SIGKILL the rest."""
    pids = node_pids(directory)
    for pid in pids:
        try: os.kill(pid, 15)
        except OSError: pass
    deadline = time.time() + grace
    while node_pids(directory) and time.time() < deadline: time.sleep(0.5)
    for pid in node_pids(directory):
        try: os.kill(pid, 9); print("killed node process %d (did not stop within %ds)" % (pid, grace))
        except OSError: pass
    return pids

def _kill(pid, label):
    if agent_alive(pid):
        try: os.kill(pid, 15); print("stopping %s (pid %d)" % (label, pid))
        except OSError as error: print("%s: %s" % (label, error))

