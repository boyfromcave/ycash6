# ---------------------------------------------------------------------------------- chain-viz (chain-viz-plan.md C-11)

def chainviz_port(): return CHAINVIZ_PORT_BASE + PortSeed.n % CHAINVIZ_SEED_PERIOD
def chainviz_binary():
    """CHAINVIZ_BIN, then chain-viz on PATH, then the workspace's release and debug builds."""
    override = os.environ.get("CHAINVIZ_BIN")
    if override: return override
    found = shutil.which("chain-viz")
    if found: return found
    for build in ("release", "debug"):
        candidate = os.path.join(WORKSPACE, "chain-viz", "target", build, "chain-viz")
        if os.access(candidate, os.X_OK): return candidate
    return None
def chainviz_of(state): return state.get("chainviz") or {}
def chainviz_pid_file(directory): return os.path.join(directory, "chain-viz.pid")
def chainviz_pid(state):
    """The recorded pid, or the pid file's (chain-viz writes it; a record survives a crash)."""
    pid = chainviz_of(state).get("pid")
    if pid: return pid
    try:
        with open(chainviz_pid_file(state["dir"])) as file: return int(file.read().strip() or 0) or None
    except (OSError, ValueError): return None
def _dim(text): return "\033[2m%s\033[0m" % text if sys.stdout.isatty() else text

def chainviz_start(state):
    """Spawn chain-viz on devnet.json and wait for its `listening on http://…` line; a missing
    binary is one dim line, never an error (C-11: the devnet does not depend on the visualizer)."""
    binary = chainviz_binary()
    if not binary:
        print(_dim("chain-viz: no binary (CHAINVIZ_BIN, PATH, %s/chain-viz/target/{release,debug}); not started" % WORKSPACE)); return
    if not os.access(binary, os.X_OK):
        print(_dim("chain-viz: %s is not executable; not started" % binary)); return
    directory, port = state["dir"], chainviz_port()
    log, pid_file = os.path.join(directory, "chain-viz.log"), chainviz_pid_file(directory)
    argv = [binary, "--devnet", directory, "--listen", "127.0.0.1:%d" % port,
            "--record", os.path.join(directory, "chain-viz"), "--pid-file", pid_file]
    pid = _spawn(directory, "chain-viz", argv)
    url, deadline = None, time.time() + CHAINVIZ_START_TIMEOUT
    while time.time() < deadline:
        try:
            with open(log) as file: match = re.search(r"listening on (http://\S+)", file.read())
        except OSError: match = None
        if match: url = match.group(1); break
        if not agent_alive(pid): break
        time.sleep(0.25)
    state["chainviz"] = {"pid": pid, "url": url or "http://127.0.0.1:%d" % port, "port": port, "log": log,
                         "binary": binary, "pid_file": pid_file, "record": os.path.join(directory, "chain-viz")}
    if url: print("chain-viz: %s (pid %d, log %s)" % (url, pid, log))
    elif not agent_alive(pid): print("chain-viz exited at start; see %s" % log, file=sys.stderr)
    else: print("chain-viz started (pid %d) but printed no `listening on` line in %d s; expected http://127.0.0.1:%d, see %s" % (pid, CHAINVIZ_START_TIMEOUT, port, log), file=sys.stderr)

def chainviz_stop(state, grace=5):
    """SIGTERM, then SIGKILL after `grace` seconds; by the record or the pid file."""
    pid = chainviz_pid(state)
    if not pid or not agent_alive(pid): return
    _kill(pid, "chain-viz")
    deadline = time.time() + grace
    while agent_alive(pid) and time.time() < deadline: time.sleep(0.2)
    if agent_alive(pid):
        try: os.kill(pid, 9); print("chain-viz (pid %d) did not stop in %d s; killed" % (pid, grace))
        except OSError: pass
    try: os.remove(chainviz_pid_file(state["dir"]))
    except OSError: pass

def chainviz_line(state):
    record = chainviz_of(state)
    if not record: return "chain-viz: not started (`up` starts it when a binary is found; CHAINVIZ_BIN)"
    pid = chainviz_pid(state)
    return "chain-viz: %s (pid %s) %s; log %s" % (record.get("url"), pid, "up" if pid and agent_alive(pid) else "DEAD", record.get("log"))

