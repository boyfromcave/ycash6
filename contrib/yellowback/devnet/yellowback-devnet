def arm_attestors(state, nodes, price, steps=6):
    """Register the automated attestor nodes with yed_registerattestor, mine through
    BOND_MATURITY and ATTEST_ARM_DELAY so the devnet ends ARMED (ARM-1/ARM-2), then start one
    `attest` agent per attestor and one `subscribe` beside every minting node on the `dir`
    transport and wait for poolFresh >= M_SELECT.

    Registration is the wallet RPC each attestor runs for itself (yed_registerattestor), not a
    raw builder: this is the path a real attestor follows, and the devnet exists to demonstrate
    it.  Blocks are mined by the automated pools, round-robin, so every height keeps a tagged
    quote."""
    directory, attestors = state["dir"], attestors_of(state)
    pools = list(auto_pools(state))
    def pool_mine(n, label):
        for block in range(n):
            nodes[pools[block % len(pools)]].generate(1); sync_blocks(nodes)
        wait(nodes, state)
        print("      %s -> height %d" % (label, nodes[USER].getblockcount()))

    print("[5/%d] registering %d attestors (%d YEC bonded for %d blocks each)"
          % (steps, len(attestors), ATTEST_BOND_YEC, ATTEST_LOCK_BLOCKS))
    for node in attestors:
        nodes[USER].sendtoaddress(nodes[node].getnewaddress(), ATTEST_FUND_YEC)
    # sync_blocks alone is not enough: the funding transactions must reach the pool that mines the
    # next block, and mempools are only synced explicitly (the third registration once found
    # "insufficient-yec: have 0.00" because its funding was still on node 0).
    sync_mempools(nodes); pool_mine(1, "funded the attestor wallets")
    for node in attestors:
        have = nodes[node].getbalance()
        if have < ATTEST_BOND_YEC:
            raise RuntimeError("node%d holds %s YEC after funding, needs %d" % (node, have, ATTEST_BOND_YEC))
    pubkeys = {}
    for node in attestors:
        result = nodes[node].yed_registerattestor(ATTEST_BOND_YEC, ATTEST_LOCK_BLOCKS)
        pubkeys[node] = result["attestorPubKey"]
        print("      node%d registered: txid %s, bond %s" % (node, result["txid"][:16], result["bondAddress"]))
    sync_mempools(nodes)
    pool_mine(1, "registrations confirmed")
    pool_mine(BOND_MATURITY, "bonds matured (BOND_MATURITY=%d)" % BOND_MATURITY)
    info = nodes[USER].yed_getinfo()["attest"]
    if info["status"] != "TRIGGERED":
        raise RuntimeError("attestation is %s after BOND_MATURITY, expected TRIGGERED "
                           "(%d of %d bonds mature)" % (info["status"], info["seatedCount"], len(attestors)))
    print("      TRIGGERED at height %d; arms at %d" % (info["triggerHeight"], info["armHeight"]))
    pool_mine(ATTEST_ARM_DELAY, "arming delay elapsed (ATTEST_ARM_DELAY=%d)" % ATTEST_ARM_DELAY)
    info = nodes[USER].yed_getinfo()["attest"]
    if info["status"] != "ARMED":
        raise RuntimeError("attestation is %s after ATTEST_ARM_DELAY, expected ARMED" % info["status"])
    seqs = {}
    for node in attestors:
        seq = seq_of(nodes[USER], pubkeys[node])
        if seq is None: raise RuntimeError("node%d's registration is not in yed_listattestors" % node)
        seqs[str(node)] = seq
    state["attest_seqs"] = seqs

    subscribers = minting_nodes(state)
    print("[6/%d] starting %d `attest` agents and %d `subscribe` (beside node %s), dir transport at %s"
          % (steps, len(attestors), len(subscribers), ", ".join(str(n) for n in subscribers), bus_path(directory)))
    os.makedirs(bus_path(directory), exist_ok=True)
    for node in attestors:
        write_attest_mock(directory, node, price)
        state["attest_agents"]["attest-%d" % node] = start_attest_agent(directory, node, seqs[str(node)])
    for node in subscribers:
        state["attest_agents"]["subscribe-%d" % node] = start_subscriber(directory, node)
    # The agents sign only at a due tick (every ATTEST_INTERVAL blocks), so mine into one.
    pool_mine(ATTEST_INTERVAL + REF_LAG, "mined into an attestation tick")
    for node in subscribers:
        info = wait_pool_fresh(state, node=node)
    print("      ARMED: %d seated, poolFresh %d, pool holds %d attestation(s)"
          % (info["seatedCount"], info["poolFresh"], info["poolSize"]))

def _teardown(state, nodes):
    stop_agents(state); stop_attest_agents(state)
    for node in nodes:
        try: node.stop()
        except Exception: pass
    for index in list(bitcoind_processes):
        try: bitcoind_processes[index].wait(timeout=10)
        except Exception: pass
        del bitcoind_processes[index]

def footprint(role, count, args):
    agents = len(ROLES[role]["auto_attestors"]) + (3 if role != "none" else 1)     # attest + subscribe
    quotes = len(ROLES[role]["auto_pools"]) if (args.agents or role != "none") else 0
    extra = []
    if role != "none":
        if not args.no_heartbeat: extra.append("heartbeat")
        if not (args.no_walk or args.lean): extra.append("price walk")
        if not args.no_sim: extra.append("simulator")
    return "%d ycashd, %d attest/subscribe agents, %d quote agents%s" % (
        count, agents, quotes, (", " + ", ".join(extra)) if extra else "")

def up(args):
    directory = os.path.abspath(args.dir)
    role = args.role
    if role != "none" and args.no_attest: sys.exit("--role needs the attestors; drop --no-attest")
    if args.stratum and role != "pool": sys.exit("--stratum is the pool seat's: `up --role pool --stratum`")
    if args.stratum and not os.access(YOLO, os.X_OK):
        sys.exit("yolo not found at %s\n  build it with: cd %s && cargo build --release\n  (or point YOLO_BIN at it, or drop --stratum)" % (YOLO, os.path.join(WORKSPACE, "yolo")))
    if os.path.exists(path(directory)):
        state = load(directory)
        if any(alive(state, node) for node in range(state["num_nodes"])): sys.exit("a devnet is already running in %s; `down` it first" % directory)
        if not args.force: sys.exit("%s holds a stopped devnet; pass --force to rebuild" % directory)
    elif os.path.exists(directory) and os.listdir(directory) and not args.force: sys.exit("%s exists and is not empty; pass --force" % directory)
    stray = node_pids(directory)
    if stray:
        # a node that no longer answers RPC (or a half-started `up`) still holds its ports
        if not args.force: sys.exit("%d ycashd process(es) still run out of %s (pids %s); `down` them, or pass --force to kill them" % (len(stray), directory, " ".join(str(p) for p in stray)))
        print("killing %d stray ycashd process(es) of an earlier run: %s" % (len(stray), " ".join(str(p) for p in stray)))
        kill_nodes(directory)
    if os.path.exists(directory): shutil.rmtree(directory)
    binary = args.bitcoind or os.environ.get("BITCOIND") or os.path.join(REPO, "src", "ycashd")
    if not os.access(binary, os.X_OK): sys.exit("ycashd not found at %s" % binary)
    os.environ["BITCOIND"], PortSeed.n = binary, args.portseed
    attest = not args.no_attest
    agents_wanted = args.agents or role != "none"          # the role presets always run the real quote agents
    preset = ROLES[role]
    if role == "none":
        count = ATTEST_NODES if attest else NODES
        attestors = list(ATTESTORS) if attest else []
        population = liquidator = None
    else:
        count = ROLE_NODES
        attestors = list(preset["auto_attestors"])
        population, liquidator = POPULATION, LIQUIDATOR
    steps = 7 if role != "none" else (6 if attest else 4)
    addresses = [address_of(wif) for wif in POOL_WIFS]
    pool_extra = ["-yellowbackquotemaxage=%d" % QUOTE_MAX_AGE] if agents_wanted else None
    # node 0 also serves lightwalletd (`lightwalletd` below): the server's getaddresstxids needs the
    # address index, which is experimental and needs -txindex (both are only ever set on a fresh datadir here).
    node_args = {USER: yellowback_node_args() + ["-insightexplorer", "-txindex"], STOCK: yellowback_node_args(yellowback=False)}
    for index, pool in enumerate(POOLS):
        if pool in preset["auto_pools"] or role == "none": node_args[pool] = pool_args(addresses[index], pool_extra)
        else: node_args[pool] = yellowback_node_args(pool_extra)      # your pool: a plain miner, no payout, no signal
    for node in range(NODES, count):
        node_args[node] = yellowback_node_args()      # attestor, population and liquidator nodes: enforcing, no payout, no signal
    for node in node_args: node_args[node] = node_args[node] + zmq_args(node)    # every node publishes hashblock/hashtx (N-4)
    if agents_wanted and not os.access(AGENT, os.X_OK): sys.exit("quote agent not found at %s" % AGENT)
    if attest and not os.access(ATTEST_AGENT, os.X_OK):
        sys.exit("yellowback-attest not found at %s\n  build it with: cd %s && cargo build --release\n"
                 "  (or point YELLOWBACK_ATTEST_BIN at it, or run `up --no-attest` for the five-node v2 devnet)"
                 % (ATTEST_AGENT, ATTEST_CRATE))
    if role != "none" and not args.no_sim and not os.access(SIM, os.X_OK): sys.exit("simulator not found at %s" % SIM)
    seed = args.seed if args.seed is not None else random.randrange(1, 10 ** 6)
    print("footprint: %s (--lean drops the walk and halves the heartbeat)" % footprint(role, count, args))
    os.makedirs(directory); nodes = []; agents = {}; attest_agents = {}
    state = {"portseed": args.portseed, "bitcoind": binary, "num_nodes": count, "pools": list(POOLS),
             "auto_pools": list(preset["auto_pools"]), "pool_addresses": addresses, "price_usd": str(args.price),
             "agents": agents, "attestors": attestors, "auto_attestors": attestors, "attest_agents": attest_agents,
             "attest_seqs": {}, "dir": directory, "created": time.strftime("%Y-%m-%d %H:%M:%S"),
             "role": role, "seat": preset["seat"], "population": population, "liquidator": liquidator,
             "seed": seed, "node_args": {str(k): v for k, v in node_args.items()},
             "rpc": {str(n): {"url": rpc_url(n), "port": rpc_port(n), "user": rpc_auth_pair(n)[0], "password": rpc_auth_pair(n)[1]} for n in range(count)},
             "nodes": {str(n): {"zmq": zmq_record(n)} for n in range(count)},
             "heartbeat": {}, "walk": {}, "sim": {}, "session": None,
             "pool_signal": {str(pool): pool in preset["auto_pools"] or role == "none" for pool in POOLS}}
    try:
        print("[1/%d] starting %d regtest nodes in %s (role: %s)" % (steps, count, directory, role))
        initialize_chain_clean(directory, count)
        nodes = [start_quiet(directory, index, node_args[index]) for index in range(count)]
        for left in range(count):
            for right in range(left + 1, count): connect_nodes_bi(nodes, left, right)
        for index, node in enumerate(POOLS): nodes[node].importprivkey(POOL_WIFS[index], "yellowback-payout", False)
        print("[2/%d] funding node0 with 101 untagged blocks" % steps)
        nodes[USER].generate(101); wait(nodes, state)
        if nodes[USER].getbalance() <= 0: raise RuntimeError("node0 has no mature balance")
        write_mock(directory, args.price)
        if agents_wanted:
            print("[3/%d] starting one yellowback-quote per automated pool at $%s (mock price %s)" % (steps, args.price, mock_path(directory)))
            for node in auto_pools(state): agents[node] = start_agent(directory, node)
            wait_quotes(state)
        else:
            print("[3/%d] setting $%s quotes on pools 2-4" % (steps, args.price))
            for node in POOLS: set_quote(nodes[node], args.price)
        print("[4/%d] mining %d signalling blocks round-robin across the automated pools" % (steps, ACTIVATION_BLOCKS + 2))
        auto = auto_pools(state)
        for block in range(ACTIVATION_BLOCKS + 2):
            nodes[auto[block % len(auto)]].generate(1); sync_blocks(nodes)
        wait(nodes, state)
        if attest:
            arm_attestors(state, nodes, args.price, steps)
        if role != "none":
            print("[7/%d] funding the population (node%d, %d YEC), the liquidator (node%d, %d YEC)%s"
                  % (steps, POPULATION, POPULATION_FUND_YEC, LIQUIDATOR, LIQUIDATOR_FUND_YEC,
                     " and your attestor seat (node%d, %d YEC)" % (ATTESTOR4, SEAT_ATTESTOR_FUND_YEC) if role == "attestor" else ""))
            # Several coins each, not one: a two-step mint spends a whole coin and its change is
            # unconfirmed for a block, so a single-coin wallet starves every other persona
            # (`insufficient-yec: have 0.00 confirmed and unlocked`) after each action.
            for _ in range(FUND_COINS):
                nodes[USER].sendtoaddress(nodes[POPULATION].getnewaddress(), POPULATION_FUND_YEC // FUND_COINS)
                nodes[USER].sendtoaddress(nodes[LIQUIDATOR].getnewaddress(), LIQUIDATOR_FUND_YEC // FUND_COINS)
            if role == "attestor":
                nodes[USER].sendtoaddress(nodes[ATTESTOR4].getnewaddress(), SEAT_ATTESTOR_FUND_YEC)
                with open(os.path.join(directory, "attest-%d.toml" % ATTESTOR4), "w") as file:
                    file.write(attest_conf_text(directory, ATTESTOR4, "0   # <- REPLACE with your seq from yed_listattestors once your registration confirms"))
                write_attest_mock(directory, ATTESTOR4, args.price)
            sync_mempools(nodes)
            nodes[auto[0]].generate(1); sync_blocks(nodes); wait(nodes, state)
            state["session"] = make_session(state)
    except Exception:
        _teardown(state, nodes)
        raise
    save(directory, state); check(state, False)
    print("ready at height %d: node0 has %s YEC" % (nodes[USER].getblockcount(), nodes[USER].getbalance()))
    if attest:
        info = rpc(state, USER).yed_getinfo()["attest"]
        print("attestation %s: %d seated, poolFresh %d" % (info["status"], info["seatedCount"], info["poolFresh"]))
    if role != "none":
        if args.stratum:
            print("[stratum] starting yolo --payout <node%d's payout address> beside node%d (your seat); `mine N %d` goes through it" % ((seat_of(state),) * 3))
            stratum_start(state, seat_of(state), args.stratum_text); save(directory, state)
        if not args.no_heartbeat:
            heartbeat_start(state, (HEARTBEAT_RATE * 2 if args.lean else HEARTBEAT_RATE) if args.heartbeat_rate is None else args.heartbeat_rate)
        if not (args.no_walk or args.lean):
            walk_start(state, args.walk_drift, args.walk_vol, args.walk_tick)
        if not args.no_sim:
            sim_start(state, args.sim_profile)
        save(directory, state)
        print(banner(state))
        print("session: %s (NOTES.md seeded with the walk-through; `report` bundles it)" % state["session"])
    if not args.no_viz:
        chainviz_start(state); save(directory, state)      # last: it reads the finished devnet.json
    print("wallet: " + " ".join(wallet_command(directory, seat_of(state))))

# ---------------------------------------------------------------------------------- heartbeat (R1)

def heartbeat_start(state, rate):
    record = state.get("heartbeat") or {}
    if agent_alive(record.get("pid")): print("heartbeat is already running (pid %d)" % record["pid"]); return
    if not auto_pools(state): sys.exit("no automated pool to mine on")
    state["heartbeat"] = {"pid": None, "rate": rate, "started": time.time(), "stopped": False}
    save(state["dir"], state)
    pid = _spawn(state["dir"], "heartbeat", [sys.executable, os.path.abspath(__file__), "_heartbeat", "--dir", state["dir"]])
    state["heartbeat"]["pid"] = pid
    save(state["dir"], state)
    print("heartbeat started (pid %d): one block every %d s on node %s, round-robin"
          % (pid, rate, ", ".join(str(p) for p in auto_pools(state))))

def heartbeat_stop(state):
    record = state.get("heartbeat") or {}
    _kill(record.get("pid"), "heartbeat")
    record["stopped"] = True
    state["heartbeat"] = record
    save(state["dir"], state)

def heartbeat_json(directory): return os.path.join(directory, "heartbeat.json")

def _heartbeat_run(args):
    """The heartbeat process: `mine 1 <next automated pool>` every `rate` seconds, forever, until
    `liveness` fails -- then say why in heartbeat.log and exit, so a broken devnet is not buried
    under a thousand blocks. The rate is re-read from devnet.json every tick (`heartbeat rate N`)."""
    directory = os.path.abspath(args.dir)
    state = load(directory)
    log = lambda text: print("%s %s" % (time.strftime("%H:%M:%S"), text), flush=True)
    log("heartbeat up: pools %s" % list(auto_pools(state)))
    turn, since_check = 0, 0
    while True:
        state = load(directory)
        rate = max(1, int((state.get("heartbeat") or {}).get("rate") or HEARTBEAT_RATE))
        time.sleep(rate)
        pools = auto_pools(state)
        pool = pools[turn % len(pools)]; turn += 1
        try:
            node = rpc(state, pool, timeout=60)
            blockhash = node.generate(1)[0]
            height = node.getblockcount()
            with open(heartbeat_json(directory) + ".tmp", "w") as file:
                json.dump({"height": height, "pool": pool, "time": time.time(), "rate": rate, "blockhash": blockhash}, file)
            os.replace(heartbeat_json(directory) + ".tmp", heartbeat_json(directory))
            log("block %d by node%d" % (height, pool))
        except Exception as error:
            log("node%d could not mine this tick: %s" % (pool, error))
        since_check += 1
        if since_check >= 10:
            since_check = 0
            errors = liveness(state)
            if errors:
                log("HALTING: the devnet is no longer live: %s" % "; ".join(errors))
                log("fix it (or `down`/`up --force`) and run `heartbeat start` again")
                return 3

def heartbeat(args):
    directory, state = os.path.abspath(args.dir), load(os.path.abspath(args.dir))
    record = state.get("heartbeat") or {}
    if args.action == "start": heartbeat_start(state, args.rate or record.get("rate") or HEARTBEAT_RATE); return
    if args.action == "stop":
        if not agent_alive(record.get("pid")): print("heartbeat is not running"); return
        heartbeat_stop(state); print("heartbeat stopped; the chain now advances only when you `mine`"); return
    if args.action == "rate":
        if not args.rate: sys.exit("heartbeat rate needs a number of seconds")
        record["rate"] = args.rate; state["heartbeat"] = record; save(directory, state)
        print("heartbeat rate is now one block every %d s%s" % (args.rate, "" if agent_alive(record.get("pid")) else " (it is not running; `heartbeat start`)"))
        return
    print(heartbeat_line(state))

def heartbeat_line(state):
    record = state.get("heartbeat") or {}
    running = agent_alive(record.get("pid"))
    last = {}
    try: last = json.load(open(heartbeat_json(state["dir"])))
    except (OSError, ValueError): pass
    if not record: return "heartbeat: never started (`heartbeat start`; the chain advances only when you `mine`)"
    return "heartbeat: %s, one block every %s s; last block %s by node%s, %s ago" % (
        "running (pid %d)" % record["pid"] if running else "STOPPED (see %s/heartbeat.log)" % state["dir"],
        record.get("rate"), last.get("height", "?"), last.get("pool", "?"),
        ("%d s" % (time.time() - last["time"])) if last else "never")

# ---------------------------------------------------------------------------------- price and the walk (R4)

def apply_price(state, value, wait_agents=False):
    """Move the market: the pool quote (through the agents' mock file, or yed_setquote when the
    pools run without agents) and every *automated* attestor's mock price, together. Your own
    attestor (the `attestor` preset) is never written: what you attest is your decision."""
    directory = state["dir"]
    since = time.time()
    write_mock(directory, value)
    if not agent_pids(state):
        for node in all_pools(state):
            if alive(state, node) and (state["pool_signal"].get(str(node), True) or role_of(state) == "none"):
                try: set_quote(rpc(state, node), value)
                except Exception: pass
    elif wait_agents:
        wait_quotes(state, since)
    for attestor in auto_attestors(state): write_attest_mock(directory, attestor, value)

def price(args):
    directory, state = os.path.abspath(args.dir), load(os.path.abspath(args.dir))
    if args.shock is not None:
        pct = Decimal(args.shock.rstrip("%"))
        current = read_mock(directory) or Decimal(state["price_usd"])
        value = (current * (1 + pct / 100)).quantize(Decimal("0.000001"))
        if value <= 0: sys.exit("a shock of %s%% from $%s leaves no price" % (pct, current))
        apply_price(state, value)
        print("shock %+s%%: $%s -> $%s on every pool quote and every automated attestor%s"
              % (pct, current, value, "; the walk continues from here" if agent_alive((state.get("walk") or {}).get("pid")) else ""))
        return
    if args.walk is not None:
        if args.walk == "stop":
            record = state.get("walk") or {}
            if not agent_alive(record.get("pid")): print("the price walk is not running"); return
            _kill(record["pid"], "price walk"); record["stopped"] = True; state["walk"] = record; save(directory, state)
            print("price frozen at $%s" % read_mock(directory)); return
        walk_start(state, args.drift, args.vol, args.tick); save(directory, state); return
    if args.usd is None: sys.exit("price needs a USD amount, --walk or --shock")
    value = Decimal(args.usd)
    if value <= 0: sys.exit("price must be positive")
    if agent_alive((state.get("walk") or {}).get("pid")):
        print("note: the walk is running and will keep moving from $%s; `price --walk stop` to freeze it" % value)
    try: apply_price(state, value, wait_agents=bool(agent_pids(state)))
    except RuntimeError as error: sys.exit(str(error))
    state["price_usd"] = str(value); save(directory, state)
    print("set the price to $%s on every pool quote%s; mine a pool block to publish each quote"
          % (value, " and every automated attestor's mock price" if attestors_of(state) else ""))

def walk_start(state, drift, vol, tick):
    record = state.get("walk") or {}
    if agent_alive(record.get("pid")): print("the price walk is already running (pid %d)" % record["pid"]); return
    state["walk"] = {"pid": None, "drift": drift, "vol": vol, "tick": tick, "started": time.time(), "stopped": False,
                     "seed": state.get("seed", 1)}
    save(state["dir"], state)
    pid = _spawn(state["dir"], "walk", [sys.executable, os.path.abspath(__file__), "_walk", "--dir", state["dir"]])
    state["walk"]["pid"] = pid
    save(state["dir"], state)
    print("price walk started (pid %d): drift %+.2f %%/min, volatility %.2f %%/tick, tick %d s, seed %s, from $%s"
          % (pid, drift, vol, tick, state["walk"]["seed"], read_mock(state["dir"])))

def _walk_run(args):
    """The price walk: a seeded geometric random walk over the mock price file, applied to the
    pools and the automated attestors together every tick (so the two populations move
    *honestly* in agreement). `price --shock` writes the same file; the next tick continues from
    it. Divergence stays a deliberate act (`attestor N price USD`)."""
    directory = os.path.abspath(args.dir)
    state = load(directory)
    record = state["walk"]
    rng = random.Random(record.get("seed", 1) * 7919 + 17)
    drift_per_tick = math.log1p(record["drift"] / 100.0) * record["tick"] / 60.0
    vol = record["vol"] / 100.0
    log = lambda text: print("%s %s" % (time.strftime("%H:%M:%S"), text), flush=True)
    log("walk up: drift %+.3f%%/min vol %.3f%%/tick tick %ds seed %s" % (record["drift"], record["vol"], record["tick"], record.get("seed")))
    while True:
        time.sleep(record["tick"])
        state = load(directory)
        current = read_mock(directory) or Decimal(state["price_usd"])
        step = math.exp(drift_per_tick + vol * rng.gauss(0.0, 1.0))
        value = (current * Decimal(repr(step))).quantize(Decimal("0.000001"))
        value = max(Decimal("0.000100"), min(Decimal("100000000"), value))
        try: apply_price(state, value)
        except Exception as error: log("could not apply $%s: %s" % (value, error)); continue
        log("$%s -> $%s" % (current, value))

# ---------------------------------------------------------------------------------- the simulator (R3)

def sim_start(state, profile):
    record = state.get("sim") or {}
    if agent_alive(record.get("pid")): print("the simulator is already running (pid %d)" % record["pid"]); return
    if state.get("population") is None: sys.exit("this devnet has no population node; the simulator needs `up --role`")
    argv = [sys.executable, SIM, "run", "--dir", state["dir"], "--seed", str(state.get("seed", 1)), "--profile", profile]
    state["sim"] = {"pid": None, "profile": profile, "started": time.time(), "stopped": False}
    save(state["dir"], state)
    pid = _spawn(state["dir"], "sim", argv)
    state["sim"]["pid"] = pid
    save(state["dir"], state)
    print("simulator started (pid %d): six personas on node%d (population) and node%d (liquidator), profile %s, seed %s"
          % (pid, state["population"], state["liquidator"], profile, state.get("seed")))

def sim(args):
    directory, state = os.path.abspath(args.dir), load(os.path.abspath(args.dir))
    record = state.get("sim") or {}
    if args.action == "start": sim_start(state, args.profile or record.get("profile") or "demo"); return
    if args.action == "stop":
        if not agent_alive(record.get("pid")): print("the simulator is not running"); return
        _kill(record["pid"], "simulator"); record["stopped"] = True; state["sim"] = record; save(directory, state); return
    return subprocess.call([sys.executable, SIM, "stats", "--dir", directory])

# ---------------------------------------------------------------------------------- pool (the `pool` preset)

def pool(args):
    """`pool N configure|signal on|off|quote start|stop`: the pool operator's moves (scenario 3).

    configure  -- restart pool N with its payout address and -yellowbacksignal=1 (step 2)
    signal off -- restart it with -yellowbacksignal=0: it keeps mining and quoting, but its tags
                  carry no signal bit; two of three silent pools cross the 60 % pause (step 4)
    quote start|stop -- run or kill the real yellowback-quote agent beside it (step 3); a stopped
                  agent shows as quoteKind "signal" once the quote is older than -yellowbackquotemaxage"""
    directory, state = os.path.abspath(args.dir), load(os.path.abspath(args.dir))
    node = args.node
    if node not in all_pools(state): sys.exit("pool must be one of %s" % ", ".join(str(p) for p in all_pools(state)))
    address = pool_address(state, node)
    extra = ["-yellowbackquotemaxage=%d" % QUOTE_MAX_AGE] if agent_pids(state) else []
    if args.action == "configure":
        restart_node(state, node, pool_args(address, extra), "with payout address %s and -yellowbacksignal=1" % address)
        state["pool_signal"][str(node)] = True; save(directory, state)
        print("node%d is now a signalling pool; `pool %d quote start` runs its quote agent, `mine N %d` mines its blocks" % (node, node, node))
        return
    if args.action == "signal":
        if args.value not in ("on", "off"): sys.exit("pool N signal on|off")
        on = args.value == "on"
        restart_node(state, node, pool_args(address, extra + ["-yellowbacksignal=%d" % (1 if on else 0)]),
                     "with -yellowbacksignal=%d" % (1 if on else 0))
        state["pool_signal"][str(node)] = on; save(directory, state)
        silent = [p for p, s in state["pool_signal"].items() if not s]
        print("node%d %s signalling; silent pools: %s. Share of signalling tags over the last 64 blocks decides: below 60 %% minting pauses, below 50 %% rejection pauses, 75 %%/60 %% recover"
              % (node, "resumed" if on else "stopped", ", ".join("node%s" % p for p in silent) or "none"))
        return
    if args.action == "quote":
        if args.value not in ("start", "stop"): sys.exit("pool N quote start|stop")
        pid = agent_pids(state).get(node)
        if args.value == "start":
            if agent_alive(pid): print("the quote agent of node%d is already running (pid %d)" % (node, pid)); return
            if not agent_pids(state) and role_of(state) == "none": sys.exit("this devnet quotes with yed_setquote (`up --agents` runs the agents)")
            state["agents"][str(node)] = start_agent(directory, node); mark_stopped(state, "quote-%d" % node, False); save(directory, state)
            print("quote agent of node%d started (pid %d), reading %s" % (node, state["agents"][str(node)], mock_path(directory)))
            return
        if not agent_alive(pid): print("the quote agent of node%d is not running" % node); return
        stop_agents(state, only=node); mark_stopped(state, "quote-%d" % node, True); save(directory, state)
        print("stopped; node%d keeps its last quote for %d s, then its tags fall back to signal-only (quoteKind \"signal\")" % (node, QUOTE_MAX_AGE))
        return
    if args.action == "stratum":
        if args.value not in ("start", "stop", "status"): sys.exit("pool N stratum start [--stratum-text TEXT]|stop|status")
        if args.value == "start":
            text = args.stratum_text if args.stratum_text is not None else (stratum_of(state, node) or {}).get("text")
            stratum_start(state, node, text); save(directory, state); return
        if args.value == "stop": stratum_stop(state, node); save(directory, state); return
        print(stratum_line(state, node)); return

# ---------------------------------------------------------------------------------- the stratum seat (role-pool-regtest-plan.md 3.4)

def stratum_of(state, node): return (state.get("stratum") or {}).get(str(node))
def stratum_ports(node):
    """The stratum and /status ports of a seat: the seat's rpc port shifted above every framework
    port, so two devnets (two portseeds) never share them."""
    port = STRATUM_PORT_BASE + (rpc_port(node) - _util.PORT_MIN - _util.PORT_RANGE)
    return port, port + STRATUM_STATUS_OFFSET

def zmq_port(node): return ZMQ_PORT_BASE + _util.MAX_NODES * (PortSeed.n % ZMQ_SEED_PERIOD) + node
def zmq_url(node): return "tcp://127.0.0.1:%d" % zmq_port(node)
def zmq_args(node):
    """The node's -zmqpub* options: one endpoint, both topics (chain-viz-plan.md N-4)."""
    return ["-zmqpubhashblock=%s" % zmq_url(node), "-zmqpubhashtx=%s" % zmq_url(node)]
def zmq_record(node): return {"hashblock": zmq_url(node), "hashtx": zmq_url(node)}

def stratum_status(record, timeout=3):
    """yolo's GET /status document, or None."""
    import urllib.request
    try:
        with urllib.request.urlopen("http://127.0.0.1:%d/status" % record["status_port"], timeout=timeout) as reply:
            return json.load(reply)
    except Exception:
        return None

def stratum_start(state, node, text=None):
    """`yolo --payout <the seat's payout address> [--text TEXT]` beside pool `node`, on the node's
    RPC credentials from devnet.json; the seat's blocks then come from `stratum-miner`
    (`mine N <node>`), never from `generate`.

    yolo has no modes (P-6): `--payout` set means every block pays that address whatever the
    miner's username (so the reward lands in the seat's wallet and the username is a free worker
    name, STRATUM_WORKER); `--text` set means the scriptSig is rebuilt as height push ||
    coinbaseaux.flags || text (carrier 3), unset leaves the node's scriptSig alone (carrier 2).
    The tag's payout key comes from -yellowbackpayoutaddress (MINER-2), not from the output, so
    yed_listminers sees the seat whichever address the coinbase pays."""
    if text is not None and len(text.encode()) > 100: sys.exit("--stratum-text is at most 100 bytes (yolo's scriptSig limit)")
    if node not in all_pools(state): sys.exit("stratum runs beside a pool node (%s)" % ", ".join(str(p) for p in all_pools(state)))
    record = stratum_of(state, node) or {}
    if agent_alive(record.get("pid")): print("yolo beside node%d is already running (pid %d, payout %s, text %s)" % (node, record["pid"], record.get("payout"), json.dumps(record.get("text")))); return record
    if not os.access(YOLO, os.X_OK):
        sys.exit("yolo not found at %s\n  build it with: cd %s && cargo build --release\n  (or point YOLO_BIN at it)" % (YOLO, os.path.join(WORKSPACE, "yolo")))
    if not alive(state, node): sys.exit("node%d is down; yolo needs its RPC" % node)
    creds = state["rpc"][str(node)]
    port, status_port = stratum_ports(node)
    # A bare URL, not devnet.json's rpc.url: the framework's credentials carry emoji, which are fine
    # in a Basic auth header and an invalid URI character in a userinfo (F-40).
    payout = pool_address(state, node)
    argv = [YOLO, "--payout", payout, "--bind", "127.0.0.1", "--port", str(port), "--status-port", str(status_port),
            "--rpc", "http://127.0.0.1:%d" % creds["port"], "--rpc-user", creds["user"], "--rpc-password", creds["password"], "--equihash", "auto", "--log", "info"]
    if text is not None: argv += ["--text", text]
    pid = _spawn(state["dir"], "stratum-%d" % node, argv)
    record = {"pid": pid, "payout": payout, "text": text, "port": port, "status_port": status_port, "binary": YOLO, "user": STRATUM_WORKER,
              "miner": STRATUM_MINER, "started": time.time(), "stopped": False}
    state.setdefault("stratum", {})[str(node)] = record
    mark_stopped(state, "stratum-%d" % node, False)
    for _ in range(30):                        # yolo serves work once its first template poll answered
        time.sleep(0.5)
        if not agent_alive(pid): sys.exit("yolo exited at start; see %s/stratum-%d.log" % (state["dir"], node))
        doc = stratum_status(record)
        if doc and doc.get("height") is not None: break
    else:
        print("yolo started (pid %d) but /status has no template after 15 s; see %s/stratum-%d.log" % (pid, state["dir"], node), file=sys.stderr)
    print("yolo started beside node%d (pid %d): payout %s, text %s, stratum 127.0.0.1:%d, status http://127.0.0.1:%d/status, log %s/stratum-%d.log"
          % (node, pid, payout, json.dumps(text), port, status_port, state["dir"], node))
    print("  `mine N %d` now runs stratum-miner --user %s against it; `check-coinbase <height> -regtest -datadir=%s` verifies the tag"
          % (node, record["user"], node_dir(state["dir"], node)))
    return record

def stratum_stop(state, node):
    record = stratum_of(state, node)
    if not record: print("no yolo was started beside node%d" % node); return
    if not agent_alive(record.get("pid")): print("yolo beside node%d is not running" % node)
    else: _kill(record["pid"], "yolo beside node%d" % node)
    record["stopped"] = True
    mark_stopped(state, "stratum-%d" % node, True)
    print("node%d mines with `generate` again until `pool %d stratum start`" % (node, node))

def stratum_line(state, node):
    """One line for `status`: yolo's payout and text, connected miners, last tag kind and last submit verdict."""
    record = stratum_of(state, node)
    if not record: return "stratum: none (`pool %d stratum start` runs yolo beside node%d)" % (node, node)
    if not agent_alive(record.get("pid")):
        return "stratum node%d: yolo (pid %s) %s" % (node, record.get("pid"), "stopped" if record.get("stopped") else "DEAD (see %s/stratum-%d.log)" % (state["dir"], node))
    doc = stratum_status(record)
    if not doc: return "stratum node%d: yolo (pid %d) on :%d, /status on :%d not answering" % (node, record["pid"], record["port"], record["status_port"])
    return ("stratum node%d: yolo (pid %d) on :%d; payout %s; text %s; template height %s (%s s old); miners %s; tag %s; last submit %s; accepted %s rejected %s"
            % (node, record["pid"], record["port"], doc.get("payout"), json.dumps(record.get("text")) if doc.get("text") else "none", doc.get("height"), doc.get("templateAgeSeconds"), doc.get("miners"),
               json.dumps(doc.get("tag")), json.dumps(doc.get("lastSubmitVerdict")), doc.get("accepted"), doc.get("rejected")))

def stratum_mine(state, node, blocks):
    """`mine N <node>` for a stratum seat: node -> yolo -> stratum-miner -> submitblock, N times."""
    record = stratum_of(state, node)
    if not agent_alive(record.get("pid")): sys.exit("yolo beside node%d is not running (`pool %d stratum start`)" % (node, node))
    argv = [sys.executable, record.get("miner") or STRATUM_MINER, "--pool", "127.0.0.1:%d" % record["port"], "--user", record["user"], "--blocks", str(blocks)]
    log = open(os.path.join(state["dir"], "stratum-miner-%d.log" % node), "a")
    log.write("%s %s\n" % (time.strftime("%H:%M:%S"), " ".join(argv))); log.flush()
    rc = subprocess.call(argv, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT)
    log.close()
    if rc != 0: sys.exit("stratum-miner exited %d; see %s/stratum-miner-%d.log and stratum-%d.log" % (rc, state["dir"], node, node))

