def mine(args):
    """`mine N` mines round-robin on the automated pools, as the heartbeat does, so every block
    carries a quote tag. `mine N <node>` mines on one node, and refuses a node whose blocks would
    carry no tag (the user seat, the stock node, a pool with no payout key) unless `--untagged` says
    that is the point: 50 tagless blocks in a 64-block window empty the price windows (NO_PRICE),
    halt minting (PARTICIPATION) and suspend block rejection (ENFORCEMENT, ACT-6) — a majority
    walking away, impersonated by one careless command (chain-viz plan C-F34)."""
    state = load(os.path.abspath(args.dir))
    nodes = [rpc(state, index) for index in range(state["num_nodes"]) if alive(state, index)]
    start = rpc(state, USER).getblockcount()
    if args.node is None:
        pools = auto_pools(state)
        if not pools: sys.exit("no automated pool to mine on; name a node: `mine N <node>`")
        for i in range(args.blocks):                        # one block, then every node on it, before the next pool mines: no stale tips
            rpc(state, pools[i % len(pools)], timeout=60).generate(1)
            sync_blocks(nodes)
        print("mined %d blocks round-robin on node %s: height %d -> %d" % (args.blocks, ", ".join(str(p) for p in pools), start, rpc(state, USER).getblockcount()))
        return
    if not 0 <= args.node < state["num_nodes"]: sys.exit("node must be between 0 and %d" % (state["num_nodes"] - 1))
    node = rpc(state, args.node)
    record = stratum_of(state, args.node)
    stratum = bool(record and not record.get("stopped"))
    if not stratum and not args.untagged:
        try: kind = node.yed_getinfo().get("miner", {}).get("quoteKind", "none")
        except Exception: kind = "none"                     # a stock node: no yed_getinfo
        if kind == "none":
            sys.exit("node%d's blocks would carry no Yellowback tag (no payout key or no -yellowback): %d of them drain the price windows,\n"
                     "halt minting and suspend enforcement. `mine %d` mines on the pools; `mine %d %d --untagged` does this on purpose."
                     % (args.node, args.blocks, args.blocks, args.blocks, args.node))
        if kind == "signal":
            print("note: node%d's quote is stale (quoteKind \"signal\"): its blocks signal but carry no price" % args.node)
    if stratum:
        stratum_mine(state, args.node, args.blocks)        # a stratum seat: node -> yolo -> stratum-miner -> submitblock
    else:
        node.generate(args.blocks)
    sync_blocks(nodes)
    print("mined %d%s blocks on node%d%s: height %d -> %d" % (args.blocks, " untagged" if args.untagged else "", args.node,
          " through yolo and stratum-miner" if stratum else "", start, node.getblockcount()))

def attestor(args):
    """`attestor N stop|start|price USD`: the outage and divergence demos of v3 section 5.

    stop  -- kill that attestor's agent; with K_SLACK the others still cover a mint, and stopping
             two leaves minting refusing with `missing`.
    start -- bring it back (the node keeps its seat; only the pool goes stale).
    price -- give that one attestor a different mock price, so the GUI shows a diverging source
             and, far enough out, DIVERGE_BPS_ATTEST drops it from the selection."""
    directory, state = os.path.abspath(args.dir), load(os.path.abspath(args.dir))
    attestors = attestors_of(state)
    if not attestors: sys.exit("this devnet was brought up with --no-attest; there are no attestors")
    if role_of(state) == "attestor" and args.node == ATTESTOR4:
        sys.exit("node%d is YOUR seat: register with `cli --node %d -- yed_registerattestor %d %d 0`, then run\n"
                 "  %s --conf %s attest --mock-price %s\n"
                 "yourself (doc/yellowback-attestor.md; the scenario 2b checklist is in your session's NOTES.md)"
                 % (ATTESTOR4, ATTESTOR4, ATTEST_BOND_YEC, ATTEST_LOCK_BLOCKS, ATTEST_AGENT,
                    os.path.join(directory, "attest-%d.toml" % ATTESTOR4), attest_mock_path(directory, ATTESTOR4)))
    if args.node not in attestors: sys.exit("attestor must be one of %s" % ", ".join(str(a) for a in attestors))
    name = "attest-%d" % args.node
    pid = attest_pids(state).get(name)
    if args.action == "stop":
        if not (pid and agent_alive(pid)): print("%s is already down" % name); return
        stop_attest_agents(state, only=name)
        state["attest_agents"][name] = pid          # remembered so `start` can report the swap
        mark_stopped(state, name, True)
        save(directory, state)
        print("stopped %s (seq %s); its attestations stop at the next tick, and the pool keeps the last "
              "until it ages past attestMaxAge" % (name, state["attest_seqs"].get(str(args.node), "?")))
        return
    if args.action == "start":
        if pid and agent_alive(pid): print("%s is already up (pid %d)" % (name, pid)); return
        seq = state["attest_seqs"][str(args.node)]
        state["attest_agents"][name] = start_attest_agent(directory, args.node, seq)
        mark_stopped(state, name, False)
        save(directory, state)
        print("started %s (pid %d, seq %d); mine %d blocks for its next tick"
              % (name, state["attest_agents"][name], seq, ATTEST_INTERVAL))
        return
    value = Decimal(args.usd)
    if value <= 0: sys.exit("price must be positive")
    write_attest_mock(directory, args.node, value)
    if agent_alive((state.get("walk") or {}).get("pid")):
        print("note: the walk rewrites every automated attestor's price each tick; `price --walk stop` first to hold a divergence")
    print("node%d (seq %s) now attests $%s (the others are at $%s); mine %d blocks for its next tick"
          % (args.node, state["attest_seqs"].get(str(args.node), "?"), value, read_mock(directory), ATTEST_INTERVAL))

def notice(args):
    """`notice VAULTTXID`: post the emergency claim notice for a vault from node 0 (NOT-1,
    `yed_claimnotice`), the entry point of the emergency flow the GUI demonstrates. Anyone may
    post a notice and it needs YEC, not YED, so node 0 can post one for a vault it does not own.

    Like every bundle-carrying command this is two-step: with `wait` (the default) the call blocks
    until its carrier confirms, so mine a block from another terminal -- `yellowback-devnet mine
    1 2` -- while it waits (the heartbeat does it for you in a role preset)."""
    state = load(os.path.abspath(args.dir))
    node = rpc(state, USER, timeout=700)
    if not attestors_of(state): sys.exit("this devnet was brought up with --no-attest; there is no notice path")
    try:
        result = node.yed_claimnotice(args.vaulttxid)
    except Exception as error:
        sys.exit("yed_claimnotice: %s" % error)
    if result.get("pending"):
        print("carrier %s is in flight; mine a block and run `notice %s` again"
              % (result["carrierTxid"][:16], args.vaulttxid))
        return
    print("notice posted: txid %s, refHeight %s, emergency claim opens at %s"
          % (result.get("txid", "?"), result.get("refHeight"), result.get("emergencyOpenAt")))

def wallet(args):
    directory, state = os.path.abspath(args.dir), load(os.path.abspath(args.dir))
    node = seat_of(state) if args.node is None else args.node
    if not 0 <= node < state["num_nodes"]: sys.exit("node must be between 0 and %d" % (state["num_nodes"] - 1))
    if node == STOCK: sys.exit("node1 is the stock node: it has no Yellowback tab to show")
    command = wallet_command(directory, node, args.app)
    if args.print: print(" ".join(command)); return
    if not os.access(command[0], os.X_OK): sys.exit("wallet not found at %s; pass --app, set YELLOWBACK_WALLET_BIN, or use --print" % command[0])
    subprocess.Popen(command, stdin=subprocess.DEVNULL, start_new_session=True)
    print("launched on node%d%s: %s" % (node, " (your seat)" if node == seat_of(state) and role_of(state) != "none" else "", " ".join(command)))

def cli(args):
    directory, state = os.path.abspath(args.dir), load(os.path.abspath(args.dir))
    if args.datadir is not None:
        if not 0 <= args.datadir < state["num_nodes"]: sys.exit("node must be between 0 and %d" % (state["num_nodes"] - 1))
        print(node_dir(directory, args.datadir)); return 0
    return subprocess.call([os.path.join(os.path.dirname(state["bitcoind"]), "ycash-cli"), "-datadir=" + node_dir(directory, args.node)] + args.args)

def down(args):
    directory, state = os.path.abspath(args.dir), load(os.path.abspath(args.dir))
    chainviz_stop(state)
    for name in ("sim", "walk", "heartbeat", "lightwalletd"):
        _kill((state.get(name) or {}).get("pid"), name)
    for node, record in sorted((state.get("stratum") or {}).items()):
        _kill(record.get("pid"), "yolo beside node%s" % node)
        subprocess.run(["pkill", "-f", "stratum-miner --pool 127.0.0.1:%d " % record["port"]], capture_output=True)    # a `mine` still solving against it
    stop_agents(state); stop_attest_agents(state)
    for node in range(state["num_nodes"]):
        if alive(state, node):
            try: rpc(state, node).stop(); print("stopping node%d" % node)
            except Exception as error: print("node%d: %s" % (node, error))
    # By process too: a node whose RPC is broken looks down to alive() and would survive, holding
    # its ports for the next `up` (F-14). Wait for the clean stops, then terminate what is left.
    left = kill_nodes(directory)
    if left: print("%d node process(es) did not stop over RPC and were terminated" % len(left))
    if args.wipe: shutil.rmtree(directory); print("wiped %s" % directory)

# ---------------------------------------------------------------------------------- sessions, scenarios, reports (R5)

def scenario_files(role):
    names = {"user": ["1-user"], "attestor": ["2a-attestor-gui", "2b-attestor-headless"], "pool": ["3-pool"]}.get(role, [])
    return [os.path.join(SCENARIOS, name + ".md") for name in names]

def fork_commit(repo):
    try: return subprocess.check_output(["git", "-C", repo, "rev-parse", "--short", "HEAD"], text=True, stderr=subprocess.DEVNULL).strip()
    except Exception: return "unknown"

def params_summary(state):
    try:
        params = rpc(state, USER).yed_getinfo()["params"]
        return json.dumps(params, sort_keys=True)
    except Exception as error:
        return "unavailable (%s)" % error

def make_session(state):
    """<dir>/session-<role>-<date>/ with NOTES.md seeded with the walk-through checklist(s) of
    the role, so an observation can be typed against the step that prompted it. The seed is in
    the header: a scenario that produced an interesting liquidation can be replayed exactly."""
    role = role_of(state)
    session = os.path.join(state["dir"], "session-%s-%s" % (role, time.strftime("%Y%m%d-%H%M")))
    os.makedirs(session, exist_ok=True)
    header = ["# Session notes: the `%s` seat" % role, "",
              "- started: %s" % time.strftime("%Y-%m-%d %H:%M:%S"),
              "- seed: %s (`up --role %s --seed %s` replays the personas and the walk)" % (state.get("seed"), role, state.get("seed")),
              "- your node: node%d (rpc port %s)" % (seat_of(state), state["rpc"][str(seat_of(state))]["port"]),
              "- ycash-dd: %s; yecwallet-dd: %s" % (fork_commit(REPO), fork_commit(os.path.join(WORKSPACE, "yecwallet-dd"))),
              "- price at start: $%s" % state["price_usd"], "",
              "Type observations under the step that prompted them. `yellowback-devnet report` bundles this",
              "directory with every log and the simulator's tally.", ""]
    body = []
    for file in scenario_files(role):
        try: body += ["", "---", "", open(file).read()]
        except OSError: body += ["", "(missing scenario file %s)" % file]
    with open(os.path.join(session, "NOTES.md"), "w") as notes: notes.write("\n".join(header + body) + "\n")
    return session

def scenario(args):
    files = sorted(glob.glob(os.path.join(SCENARIOS, "*.md")))
    if not args.name:
        print("scenarios (`scenario NAME` prints one):")
        for file in files: print("  %s" % os.path.basename(file)[:-3])
        return
    matches = [f for f in files if os.path.basename(f)[:-3] == args.name or os.path.basename(f).startswith(args.name)]
    if not matches: sys.exit("no scenario named %s" % args.name)
    print(open(matches[0]).read())

def report(args):
    """Bundle the session directory, devnet.json, every agent and process log, the simulator's
    tally and a REPORT.md header (parameters, both fork commits, seed) into one tarball."""
    directory, state = os.path.abspath(args.dir), load(os.path.abspath(args.dir))
    session = state.get("session") or make_session(state)
    if not os.path.isdir(session): session = make_session(state)
    role = role_of(state)
    lines = ["# Yellowback devnet report: the `%s` seat" % role, "",
             "- generated: %s" % time.strftime("%Y-%m-%d %H:%M:%S"),
             "- devnet created: %s in %s" % (state.get("created"), directory),
             "- seed: %s; heartbeat rate: %s s; walk: %s" % (state.get("seed"), (state.get("heartbeat") or {}).get("rate"), json.dumps({k: v for k, v in (state.get("walk") or {}).items() if k in ("drift", "vol", "tick")})),
             "- ycash-dd: %s; yecwallet-dd: %s" % (fork_commit(REPO), fork_commit(os.path.join(WORKSPACE, "yecwallet-dd"))),
             "- price now: $%s" % read_mock(directory), ""]
    if alive(state, USER):
        node = rpc(state, USER)
        try:
            lines += ["## Chain", "", "```json", json.dumps({"height": node.getblockcount(), "stats": node.yed_getstats(), "attest": node.yed_getinfo()["attest"],
                                                             "attestors": node.yed_listattestors(), "miners": node.yed_listminers()}, indent=1, default=str), "```", ""]
        except Exception as error: lines += ["chain state unavailable: %s" % error, ""]
    lines += ["## Parameters (yed_getinfo.params)", "", "```json", params_summary(state), "```", ""]
    stats_file = os.path.join(directory, "sim-stats.json")
    if os.path.exists(stats_file):
        lines += ["## Simulator tally", "", "```json", open(stats_file).read(), "```", ""]
    with open(os.path.join(session, "REPORT.md"), "w") as file: file.write("\n".join(lines))
    bundle = os.path.join(directory, "report-%s-%s.tar.gz" % (role, time.strftime("%Y%m%d-%H%M")))
    with tarfile.open(bundle, "w:gz") as tar:
        tar.add(session, arcname=os.path.basename(session))
        for name in ["devnet.json", "sim-stats.json", "heartbeat.json", "mock-price"] + [os.path.basename(f) for f in glob.glob(os.path.join(directory, "*.log"))] + [os.path.basename(f) for f in glob.glob(os.path.join(directory, "*.toml"))]:
            full = os.path.join(directory, name)
            if os.path.exists(full): tar.add(full, arcname=os.path.join("devnet", name))
        session_events = os.path.join(directory, "chain-viz", "session.jsonl")
        if os.path.exists(session_events): tar.add(session_events, arcname=os.path.join("devnet", "chain-viz", "session.jsonl"))
        for index in range(state["num_nodes"]):
            debug = os.path.join(node_dir(directory, index), "regtest", "debug.log")
            if os.path.exists(debug): tar.add(debug, arcname=os.path.join("devnet", "node%d-debug.log" % index))
