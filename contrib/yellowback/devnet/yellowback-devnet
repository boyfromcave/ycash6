def _attest_agent():
    """The yellowback-attest binary. CARGO_TARGET_DIR is commonly set to a shared directory here
    (the v3 A4 incident: a `cargo clean` against one), so the crate-local target/ is only the
    first candidate. YELLOWBACK_ATTEST_BIN overrides everything."""
    override = os.environ.get("YELLOWBACK_ATTEST_BIN")
    if override: return os.path.expanduser(override)
    roots = [os.path.join(ATTEST_CRATE, "target")]
    shared = os.environ.get("CARGO_TARGET_DIR")
    if shared: roots.insert(0, os.path.expanduser(shared))
    for root in roots:
        for profile in ("release", "debug"):
            candidate = os.path.join(root, profile, "yellowback-attest")
            if os.access(candidate, os.X_OK): return candidate
    return os.path.join(ATTEST_CRATE, "target", "release", "yellowback-attest")

