class WalkFailure(Exception):
    pass


def jdump(value, limit=None):
    text = json.dumps(value, default=str, sort_keys=True)
    if limit and len(text) > limit:
        text = text[:limit] + " ... (%d bytes)" % len(text)
    return text


def pick(value, keys):
    return {k: value.get(k) for k in keys if k in value}


class Walk:
    def __init__(self, args):
        self.args = args
        self.dir = os.path.abspath(args.dir)
        self.state = dv.load(self.dir)
        self.skip = set(s for s in (args.skip or "").split(",") if s)
        if args.only: self.skip = set(STEPS) - set(args.only.split(","))
        unknown = self.skip - set(STEPS)
        if unknown: sys.exit("unknown step(s) to skip: %s (steps: %s)" % (", ".join(sorted(unknown)), ", ".join(STEPS)))
        self.transcript = open(args.transcript or os.path.join(self.dir, "upgrade-walk-transcript.txt"), "w")
        self.t0 = time.time()
        self.summary = {"steps": {}, "evidence": {}, "findings": []}
        self.n = self.state["num_nodes"]
        self.network = self.state.get("network") or "regtest"
        if self.network != "regtest":
            return                    # a joined testnet: run() walks the network step only
        if self.n < 11 or self.state.get("role") != "attestor":
            sys.exit("upgrade-walk needs `up --role attestor --no-heartbeat --no-walk --no-sim` (eleven nodes, node 8 empty)")
        for name in ("heartbeat", "walk", "sim"):
            if dv.agent_alive((self.state.get(name) or {}).get("pid")):
                sys.exit("the %s is running; this walk mines every block itself (`up ... --no-heartbeat --no-walk --no-sim`)" % name)
        self.set_id = self.state["attestor_set"]
        self.yed_nodes = [i for i in range(self.n) if i != STOCK]
        self.vaults = {}
        self.last_divergence = None

    # ------------------------------------------------------------------ transcript
    def out(self, text=""):
        print(text, flush=True)
        self.transcript.write(text + "\n")
        self.transcript.flush()

    def step(self, name, title):
        self.current = name
        self.out("")
        self.out("=" * 100)
        self.out("[%s +%ds] %s  (height %d)" % (name, time.time() - self.t0, title, self.tip()))
        self.out("=" * 100)

    def note(self, text):
        self.out("  # " + text)

    def ok(self, condition, text):
        if not condition:
            self.out("  FAIL: " + text)
            raise WalkFailure("%s: %s" % (self.current, text))
        self.out("  PASS: " + text)

    def evidence(self, key, value):
        self.summary["evidence"][key] = value

    def finding(self, text):
        self.summary["findings"].append(text)
        self.out("  FINDING: " + text)

    # ------------------------------------------------------------------ rpc and devnet
    def node(self, i, timeout=120):
        return dv.rpc(self.state, i, timeout=timeout)

    def call(self, i, method, *args, show=True, keys=None, limit=600, quiet=False):
        """One RPC on node i, echoed into the transcript with its (trimmed) result."""
        if not quiet:
            self.out("  $ node%d %s %s" % (i, method, " ".join(jdump(a) for a in args)))
        result = getattr(self.node(i), method)(*args)
        if show and not quiet:
            shown = pick(result, keys) if keys and isinstance(result, dict) else result
            self.out("    = " + jdump(shown, limit))
        return result

    def fails(self, i, method, *args, expect):
        """An RPC that must fail with ``expect`` in its message."""
        self.out("  $ node%d %s %s   (must fail: %s)" % (i, method, " ".join(jdump(a, 80) for a in args), expect))
        try:
            result = getattr(self.node(i), method)(*args)
        except Exception as error:
            message = getattr(error, "error", {}).get("message") if hasattr(error, "error") else str(error)
            message = message or str(error)
            self.out("    ! " + message[:300])
            self.ok(expect in message, "node%d %s refused: %s" % (i, method, expect))
            return message
        self.out("    = " + jdump(result, 300))
        self.ok(False, "node%d %s should have failed with %s" % (i, method, expect))

    def devnet(self, *argv, check=True):
        """A yellowback-devnet command, as a person would type it; state is reloaded after."""
        dv.save(self.dir, self.state)
        command = [sys.executable, DEVNET] + list(argv) + ["--dir", self.dir]
        self.out("  $ yellowback-devnet %s" % " ".join(argv))
        proc = subprocess.run(command, capture_output=True, text=True, timeout=600)
        for line in (proc.stdout + proc.stderr).strip().splitlines():
            if "SyntaxWarning" in line or "re.match(" in line: continue
            self.out("    | " + line[:240])
        self.state = dv.load(self.dir)
        if check and proc.returncode != 0:
            self.ok(False, "yellowback-devnet %s exited %d" % (" ".join(argv), proc.returncode))
        return proc

    def tip(self):
        return self.node(USER).getblockcount()

    def all_nodes(self):
        return [self.node(i) for i in range(self.n)]

    def refresh_peer_views(self, timeout=60):
        """Drop and re-make every peer link of the devnet's mesh, so each node starts a fresh per-peer download
        state. Needed after an invalidateblock that rewinds every node below a branch all of them had announced:
        6.20.0 fetches blocks only toward a peer's best known block (headers-first), which stays pinned on the
        invalidated higher-work branch, so a new shorter-chain block is never fetched (yellowback_util
        refresh_peer_views, mapping section 19). Harmless on v4.5.0."""
        from test_framework import util as _fw
        _fw.PortSeed.n = self.state["portseed"]
        nodes = self.all_nodes()
        pairs = [(a, b) for a in range(self.n) for b in range(a + 1, self.n)]
        def linked(x, y):
            return any(p["addr"] == "127.0.0.1:%d" % _fw.p2p_port(y) for p in nodes[x].getpeerinfo())
        for a, b in pairs:
            for x, y in ((a, b), (b, a)):
                try: nodes[x].disconnectnode("127.0.0.1:%d" % _fw.p2p_port(y))
                except Exception: pass                                  # not an outbound link of x
        deadline = time.time() + timeout
        for a, b in pairs:
            while linked(a, b) or linked(b, a):
                if time.time() > deadline: raise WalkFailure("nodes %d and %d did not disconnect" % (a, b))
                time.sleep(0.1)
        for a, b in pairs:
            _fw.connect_nodes_bi(nodes, a, b)

    def wait_mempool(self, txid, nodes=POOLS, timeout=60):
        deadline = time.time() + timeout
        while time.time() < deadline:
            if all(txid in self.node(i).getrawmempool() for i in nodes): return
            time.sleep(0.2)
        raise WalkFailure("%s did not reach the mempools of nodes %s" % (txid, nodes))

    def mine(self, blocks, stratum=False, quiet=False):
        """Round-robin on the automated pools (every block carries a quote tag), or through yolo."""
        start = self.tip()
        nodes = self.all_nodes()
        if stratum:
            dv.stratum_mine(self.state, STRATUM_POOL, blocks)
        else:
            for k in range(blocks):
                self.node(POOLS[(start + k) % len(POOLS)], timeout=180).generate(1)
                sync_blocks(nodes)
        sync_blocks(nodes)
        if not quiet:
            self.out("  ~ mined %d block(s)%s: %d -> %d" % (blocks, " through yolo + stratum-miner" if stratum else "", start, self.tip()))
        return self.tip()

    def mine_to(self, height, quiet=False):
        if self.tip() < height: self.mine(height - self.tip(), quiet=quiet)

    def wait_spender(self, i, txid, timeout=90):
        deadline = time.time() + timeout
        node = self.node(i)
        while time.time() < deadline:
            for cand in node.getrawmempool():
                try: raw = node.getrawtransaction(cand, 1)
                except Exception: continue
                if any(vin.get("txid") == txid for vin in raw["vin"]): return cand
            time.sleep(0.2)
        raise WalkFailure("node%d: nothing spent the carrier %s within %ds" % (i, txid, timeout))

    def fresh(self, i, tries=20):
        """Before a bundle-carrying call: every running attest agent has a fresh attestation in node i's pool.
        A burst of blocks outruns the agents (they sign every ATTEST_INTERVAL blocks, the pool keeps
        attestMaxAge), so wait, and mine into the next tick when waiting alone does not help."""
        self.state = dv.load(self.dir)
        running = len([1 for name, pid in dv.attest_pids(self.state).items() if name.startswith("attest-") and dv.agent_alive(pid)])
        for k in range(tries):
            info = self.node(i).yed_getinfo()["attest"]
            want = min(running, info["seatedCount"])
            if info["poolFresh"] >= want: return info
            time.sleep(1.5)
            if k % 2 == 1: self.mine(1, quiet=True)
        raise WalkFailure("node%d: poolFresh %d < %d running agents after %d tries" % (i, info["poolFresh"], want, tries))

    def fresh_spend(self, i, txid, vout=0, tries=20):
        """Before a spend of a vault that must reach the wallet's own verdict: fresh(), then selected(tip, outpoint) on node i
        has mSelect fresh attestations. A REDEEM / CLAIM cites R = tip, while fresh() (yed_getinfo.poolFresh) reads a mint's
        R = tip - REF_LAG, so an attestation REF_LAG blocks from aging out passes fresh() and is stale for the spend."""
        self.fresh(i)
        selector = bytes_to_hex_str(hex_str_to_bytes(txid)[::-1]) + bytes_to_hex_str(struct.pack("<I", vout))
        for k in range(tries):
            sel = self.node(i).yed_getselection(self.node(i).getblockcount(), selector)
            if sel["reachable"] >= sel["mSelect"]: return sel
            time.sleep(1.5)
            if k % 2 == 1: self.mine(1, quiet=True)
        raise WalkFailure("node%d: %d of mSelect %d selected attestors fresh for a spend of %s at the tip after %d tries"
                          % (i, sel["reachable"], sel["mSelect"], txid[:16], tries))

    def two_step(self, i, method, *args, keys=None, after_wait=()):
        """yed_mint / yed_claim with wait=false: the carrier, one block, then the main transaction.
        `after_wait` are the arguments that follow `wait` (yed_claim's minOutZat, maxBurnCents)."""
        keys = keys or ["pending", "carrierTxid", "refHeight", "xMint", "aMint", "pMint", "xClaim", "aClaim", "pClaim", "bundleSeqs"]
        for attempt in range(4):
            self.fresh(i)
            try:
                res = self.call(i, method, *args, False, *after_wait, keys=keys)
                break
            except Exception as error:
                message = str(getattr(error, "error", {}).get("message", error))
                if "bundle-insufficient" not in message or attempt == 3: raise
                # the agents sign every ATTEST_INTERVAL blocks; a selection can still miss a tick that lands a moment later
                self.out("    ! %s -- the agents lag the tip; one more block and retry" % message[:160])
                time.sleep(2); self.mine(1, quiet=True)
        self.ok(res["pending"] is True and res.get("carrierTxid"), "%s took the carrier step (carrier %s)" % (method, res.get("carrierTxid")))
        self.wait_mempool(res["carrierTxid"])
        self.mine(1, quiet=True)
        txid = self.wait_spender(i, res["carrierTxid"])
        self.wait_mempool(txid)
        self.out("    -> main transaction %s (spends the carrier)" % txid)
        return res, txid

    def statehashes(self, label):
        sync_blocks(self.all_nodes())
        yed = {i: self.node(i).yed_getstatehash()["statehash"] for i in self.yed_nodes}
        # The vault state hash is compared on the module nodes only: on regtest the attestor set is a per-node
        # consensus parameter (-yellowbackattestorset; on mainnet a network constant), and the YED module's liveness
        # hook (seats review B2, vault/state.cpp ApplyEjectionsOf) writes the set's member lastAct, which is hashed
        # and feeds IsDormant. The stock node, without the set, does not run that hook: it follows the same tip
        # and its set state differs from the module nodes' in the governed set's lastAct alone (stock_divergence).
        infos = {i: self.node(i).vault_getinfo() for i in range(self.n)}
        vault = {i: infos[i]["statehash"] for i in self.yed_nodes}
        tips = {i: self.node(i).getbestblockhash() for i in range(self.n)}
        self.out("  $ yed_getstatehash and vault_getinfo on every node; getbestblockhash on every node")
        self.out("    = yed %s ; vault %s ; stock vault %s" % (sorted(set(yed.values())), sorted(set(vault.values())), infos[STOCK]["statehash"]))
        self.ok(len(set(yed.values())) == 1, "%s: one YED state hash on all %d Yellowback nodes" % (label, len(yed)))
        self.ok(len(set(vault.values())) == 1, "%s: one vault state hash on all %d module nodes" % (label, len(vault)))
        self.ok(len(set(tips.values())) == 1, "%s: one tip on all %d nodes, the stock node included" % (label, len(tips)))
        # 01/V-7: until P8 the attestor set is a node parameter; every module node names the walk's set, the stock none
        named = {i: infos[i].get("attestorsetid") for i in range(self.n)}
        self.ok(all(named[i] == self.set_id and infos[i].get("moduleactive") is True for i in self.yed_nodes)
                and named[STOCK] is None and infos[STOCK].get("moduleactive") is False,
                "%s: vault_getinfo.attestorsetid is the walk's set on the %d module nodes, null on the stock node" % (label, len(self.yed_nodes)))
        self.last_divergence = self.stock_divergence(label, infos)
        return yed[USER], vault[USER]

    def stock_divergence(self, label, infos):
        """07/F-4: the stock node's set state differs from a module node's (USER's) in the governed set's member lastAct
        and what is derived from it (member live; set dormant / released) alone. Every other set, every count, the
        locked value and every other member field are equal, and the state hashes differ iff some lastAct does."""
        for k in ("sets", "vaults", "intents", "lockedvalue", "height", "dbtip"):
            self.ok(infos[USER].get(k) == infos[STOCK].get(k), "%s: vault_getinfo.%s equal on the module and the stock node (%s)"
                    % (label, k, jdump(infos[USER].get(k), 120)))
        h = infos[USER]["height"] + 1
        sets_user = {s["setid"]: s for s in self.node(USER).set_list()}
        sets_stock = {s["setid"]: s for s in self.node(STOCK).set_list()}
        self.ok(set(sets_user) == set(sets_stock), "%s: the same %d sets on the module and the stock node" % (label, len(sets_user)))
        derived_set = ("dormant", "released")
        derived_member = ("lastact", "live", "wallet")      # wallet: whether that node's wallet holds the key
        lastact_diff = {}
        for sid in sorted(sets_user):
            a, b = self.node(USER).set_getinfo(sid, h), self.node(STOCK).set_getinfo(sid, h)
            governed = sid == self.set_id
            skip = derived_set if governed else ()
            for k in sorted(set(a) | set(b)):
                if k in skip or k == "memberlist": continue
                if a.get(k) != b.get(k):
                    self.ok(False, "%s: set %s.%s equal on both (%r vs %r)" % (label, sid[:12], k, a.get(k), b.get(k)))
            ma = {m["key"]: m for m in a.get("memberlist", [])}
            mb = {m["key"]: m for m in b.get("memberlist", [])}
            if set(ma) != set(mb):
                self.ok(False, "%s: set %s has the same members on both" % (label, sid[:12]))
            for key in ma:
                for k in sorted(set(ma[key]) | set(mb[key])):
                    if k == "wallet" or (governed and k in derived_member): continue
                    if ma[key].get(k) != mb[key].get(k):
                        self.ok(False, "%s: set %s member %s.%s equal on both (%r vs %r)" % (label, sid[:12], key[:12], k, ma[key].get(k), mb[key].get(k)))
                if ma[key].get("lastact") != mb[key].get("lastact"):
                    if not governed:
                        self.ok(False, "%s: set %s member %s lastact equal on both" % (label, sid[:12], key[:12]))
                    lastact_diff[key] = (ma[key]["lastact"], mb[key]["lastact"])
        hashes_differ = infos[USER]["statehash"] != infos[STOCK]["statehash"]
        self.ok(hashes_differ == bool(lastact_diff), "%s: the stock node's state hash %s the module nodes' and %d member lastAct differ "
