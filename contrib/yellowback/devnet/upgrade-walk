        env = dict(os.environ, LWD_DEVNET_DIR=self.dir, LWD_FORK_ADDR="127.0.0.1:%d" % lwd["port"],
                   LWD_BASELINE_ADDR="127.0.0.1:%d" % base["port"], GOFLAGS="-mod=vendor")
        command = ["go", "test", "-tags", "devnet", "-count=1", "-v", "-run", "TestDevnetVaultUpgradeThroughServer", "./frontend/"]
        self.out("  $ (cd %s && LWD_DEVNET_DIR=... go test -tags devnet -run TestDevnetVaultUpgradeThroughServer ./frontend/)   (%s)" % (dv.LWD_REPO, label))
        proc = subprocess.run(command, cwd=dv.LWD_REPO, env=env, capture_output=True, text=True, timeout=600)
