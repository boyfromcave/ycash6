                                            "dormancy_bundles": n6, "bundles_selecting_since_stop": since6}

    def bundle_row(self, h):
        """BundleLog[h] as the node builds it (R12): the union over block h's verified bundles of selected(R, selector) and of
        the signers. Read from the node's own facts: each transaction's TxLog (yed_gettxinfo.bundleSeqs, the signers) and the
        consensus selection at its refHeight (yed_getselection; selected() reads Snapshots[R] and bond/registerHeight only, so
        it is the same after the fact). None when no transaction of block h carried a bundle."""
        node = self.node(USER)
        selected, signers, found = set(), set(), False
        for txid in node.getblock(node.getblockhash(h))["tx"][1:]:
            try: log = node.yed_gettxinfo(txid)
            except Exception: continue                       # not a Yellowback transaction
            if not log.get("bundleSeqs"): continue
            if log.get("type") != "mint":
                raise WalkFailure("block %d carries a %s bundle (%s): this step models MINT bundles (selector \"\") only" % (h, log.get("type"), txid[:16]))
            ref = node.yed_getvault(txid)["refHeight"]
            sel = {e["seq"] for e in node.yed_getselection(ref, "")["selected"]}
            if not set(log["bundleSeqs"]) <= sel:
                raise WalkFailure("mint %s at %d: signers %s are not within selected(%d, \"\") = %s" % (txid[:16], h, log["bundleSeqs"], ref, sorted(sel)))
            selected |= sel; signers |= set(log["bundleSeqs"]); found = True
        return (selected, signers) if found else None

    def s15_dormancy(self, pub6, max_mints=8, max_steer=40):
        """S15, driven from the node's facts: mint (bounded) only at reference heights whose selection holds node 6 with no fresh
        attestation of it in the pool, keep BundleLog's rows as the node builds them, and at every H % DORMANCY_CHECK == 0
        compare the node's verdict with the rule: DORMANT at H iff node 6 was ELIGIBLE and seated by H - DORMANCY_BLOCKS and
        sits in >= DORMANCY_MIN_BUNDLES rows of (H - DORMANCY_BLOCKS, H] while signing none of them. Returns (H, rows in the
        window, rows selecting node 6 since the stop, of which signed)."""
        ap = self.yed_params()["attest"]
        blocks, min_bundles, check = ap["dormancyBlocks"], max(1, ap["dormancyMinBundles"]), ap["dormancyCheck"]
        self.note("S15 on regtest: an ELIGIBLE attestor selected in >= DORMANCY_MIN_BUNDLES (%d) bundles of the last DORMANCY_BLOCKS (%d) "
                  "without signing any is DORMANT at the next H %% DORMANCY_CHECK (%d) == 0; the pool keeps its last attestation for "
                  "attestMaxAge (%d), so a bundle may still carry it" % (min_bundles, blocks, check, ap["attestMaxAge"]))
        row6 = self.attestor_row(pub6)
        seq6 = row6["seq"]
        stop_h = self.tip()
        self.ok(row6["status"] == "ELIGIBLE" and row6["seatedSince"] is not None, "node 6 (seq %d) is ELIGIBLE and seated since %s when its agent stops at %d"
                % (seq6, row6["seatedSince"], stop_h))
        rows, seen = {}, [stop_h - blocks]                    # every row a window after the stop can reach

        def observe():
            for h in range(seen[0] + 1, self.tip() + 1):
                rows[h] = self.bundle_row(h)
                seen[0] = h

        def verdict(H):
            win = [rows[h] for h in range(H - blocks + 1, H + 1) if rows.get(h)]
            picked = sum(1 for r in win if seq6 in r[0])
            signed = any(seq6 in r[1] for r in win)
            return picked, signed, row6["seatedSince"] <= H - blocks and picked >= min_bundles and not signed

        observe()
        expect, next_check = None, [stop_h + 1]
        for k in range(max_mints):
            self.fund_user()
            for _ in range(max_steer):                        # a reference height whose selection holds node 6, unsigned
                ref = self.tip() - REF_LAG
                e6 = [e for e in self.node(USER).yed_getselection(ref, "")["selected"] if e["seq"] == seq6]
                if e6 and not e6[0]["poolFresh"]: break
                self.mine(1, quiet=True)
            else:
                raise WalkFailure("no reference height in %d blocks selected node 6 without a fresh attestation of it" % max_steer)
            res, txid = self.two_step(USER, "yed_mint", MINT_CENTS, LOCK_BLOCKS, "", "")
            self.mine(1, quiet=True)
            self.vaults.setdefault("mints", []).append(txid)
            mined = self.node(USER).yed_gettxinfo(txid)["height"]
            self.mine_to(-(-mined // check) * check, quiet=True)      # through the first check height that sees this row
            observe()
            r = rows[mined] or (set(), set())
            self.out("    mint %d: %s refHeight %s at %d: selected %s, signed %s" % (k, txid[:16], res.get("refHeight"), mined, sorted(r[0]), sorted(r[1])))
            for H in range(next_check[0], self.tip() + 1):       # each check height once: its window is all observed
                next_check[0] = H + 1
                if H % check: continue
                picked, signed, fires = verdict(H)
                self.out("      H %d: node 6 in %d row(s) of (%d, %d], signed %s -> %s" % (H, picked, H - blocks, H, signed, "DORMANT" if fires else "stays"))
                if fires:
                    since = [rows[h] for h in range(stop_h + 1, H + 1) if rows.get(h) and seq6 in rows[h][0]]
                    expect = (H, picked, len(since), sum(1 for r in since if seq6 in r[1])); break
            row = self.attestor_row(pub6)
            got = row["statusHeight"] if row["status"] == "DORMANT" else None
            if (expect and expect[0]) != got:
                raise WalkFailure("S15 mismatch: the rule over the node's BundleLog rows says %s, the node's record says %s (%s)"
                                  % ("DORMANT at %d" % expect[0] if expect else "not yet DORMANT", "DORMANT at %d" % got if got else row["status"],
                                     jdump(pick(row, ["seq", "status", "statusHeight", "lastAct", "seatedSince"]))))
            if expect:
                self.out("    node 6's record: " + jdump(pick(row, ["seq", "status", "statusHeight", "lastAct", "seated", "seatedSince"])))
                return expect
        raise WalkFailure("node 6 was not selected without signing in %d rows of one %d-block window after %d mints (rows: %s)"
                          % (min_bundles, blocks, max_mints, {h: [sorted(r[0]), sorted(r[1])] for h, r in rows.items() if r}))

    def fund_user(self):
        """Node 0 spent most of its coinbase funding the personas: top it up from the pools."""
        if self.node(USER).getbalance() >= 120: return
        txids = [self.call(p, "sendtoaddress", self.node(USER).getnewaddress(), 60) for p in POOLS]
        for t in txids: self.wait_mempool(t)
        self.mine(1)

    # ------------------------------------------------------------------ mint
    def s_mint(self):
        self.step("mint", "arming and mint -> the V template")
        info = self.call(USER, "yed_getinfo", keys=["attest", "mintRequiresArmed"])
        self.ok(info["attest"]["status"] == "ARMED", "ARMED since %s (triggered %s)" % (info["attest"]["armHeight"], info["attest"]["triggerHeight"]))
        self.fund_user()
        made = list(self.vaults.get("mints", []))         # the members step's mints carried the dormancy bundles
        while len(made) < 5:
            res, txid = self.two_step(USER, "yed_mint", MINT_CENTS, LOCK_BLOCKS, "", "")
            made.append(txid)
        self.mine(1)
        mints = dict(zip(("A", "B", "C", "D", "E"), made))
        self.note("vaults A..E: %s" % ", ".join("%s %s" % (k, v[:16]) for k, v in mints.items()))
        self.vaults.update(mints)
        va = self.call(USER, "yed_getvault", mints["A"], keys=["status", "mintedCents", "collateralZat", "lockHeight", "claimHeight", "refHeight", "scriptPubKey", "termClass"])
        dec = self.call(USER, "vault_decodescript", va["scriptPubKey"])
        self.ok(dec["type"] == "vault" and dec["tag"] == "59454400" and dec["setid"] == self.set_id and dec["cancelsetid"] == self.set_id,
                "vault A's output is the primitive's V: tag YED\\0, set = cancel set = the attestor set")
        if self.in_term_claims():
            self.ok(dec["delay"] == CLAIM_DELAY and dec["ownerheight"] == va["refHeight"] + 1 and dec["appheight"] == va["refHeight"] + 1,
                    "delay = CLAIM_DELAY (%d), ownerHeight = appHeight = refHeight + 1 (%d): the owner and APP branches are open from the mint (IT-1, D-IT-15)"
                    % (CLAIM_DELAY, va["refHeight"] + 1))
        else:
            self.ok(dec["delay"] == CLAIM_DELAY and dec["ownerheight"] == va["lockHeight"] and dec["appheight"] == va["claimHeight"],
                    "delay = CLAIM_DELAY (%d), ownerHeight = lockHeight (%d), appHeight = claimHeight (%d) (U-23)" % (CLAIM_DELAY, va["lockHeight"], va["claimHeight"]))
        listed = self.call(USER, "vault_list", {"tag": "YED"}, show=False)
        self.out("    = vault_list {tag: YED}: %d V outputs: %s" % (len(listed), ", ".join(r["outpoint"][:16] + ".." for r in listed)))
        self.ok(all(m + ":0" in {r["outpoint"] for r in listed} for m in mints.values()), "vault_list sees the YED vaults")
        stats = self.call(USER, "yed_getstats", keys=["supplyCents", "activeVaults", "mintingAllowed"])
        for name, txid in mints.items(): self.evidence("mint_" + name, txid)
        self.chainviz("after the mints")

    # ------------------------------------------------------------------ transfer
    def s_transfer(self):
        self.step("transfer", "YED transfers: to the holder (node 9) and the claimant (node 10)")
        to_claimant = self.call(CLAIMANT, "yed_getnewaddress")
        to_holder = self.call(HOLDER, "yed_getnewaddress")
        a = self.call(USER, "yed_send", to_claimant, 2 * MINT_CENTS, keys=["txid", "burnedCents", "outputs"])
        self.wait_mempool(a["txid"]); self.mine(1, quiet=True)
        b = self.call(USER, "yed_send", to_holder, 1_000, keys=["txid"])
        self.wait_mempool(b["txid"]); self.mine(1)
        info = self.call(USER, "yed_gettxinfo", a["txid"], keys=["type", "verdict", "outputs"])
        bal_c = self.call(CLAIMANT, "yed_getbalance")
        bal_h = self.call(HOLDER, "yed_getbalance")
        self.ok(bal_c["confirmedCents"] == 2 * MINT_CENTS and bal_h["confirmedCents"] == 1_000, "the claimant holds 200 YED, the holder 10 YED")
        self.evidence("transfer_txids", [a["txid"], b["txid"]])

    # ------------------------------------------------------------------ pq (the post-quantum line)
    def pq_params(self):
        return self.yed_params().get("pq") or {}

    def falcon_active(self):
        """Judged for the next block, as the node judges it (yed_getinfo.params.pq.falconActive)."""
        return self.pq_params().get("falconActive") is True

    def holder_kind(self, spk_hex):
        """'falcon' / 'slh' (TX_PQPKH by scheme), 'p2pkh', or 'other' for a token output's script."""
        if len(spk_hex) == 70 and spk_hex.startswith("20") and spk_hex.endswith("c2"):
            return {"51": "slh", "52": "falcon"}.get(spk_hex[66:68], "other")
        if len(spk_hex) == 50 and spk_hex.startswith("76a914"): return "p2pkh"
        return "other"

    def raw_transfer(self, i, coins, outputs, assignments, extra_fee=20_000):
        """A raw TRANSFER on node i: ``coins`` [(txid, vout, zat)] (YED inputs), ``outputs`` [(spk, zat)], YEC change,
        then the payload; signed by node i's wallet (P2PKH and TX_PQPKH inputs alike, sign.cpp SignPQ) but for any input
        the wallet cannot sign (a channel), which the caller completes. Returns the hex."""
        n = self.node(i)
        need = sum(v for _s, v in outputs) - sum(v for _t, _n, v in coins) + extra_fee
        utxos, total = _select_funding(n, max(need, 1))
        vouts = [(v, s) for s, v in outputs] + [(total - need, _spk_of_address(n.getnewaddress()))]
        vouts.append((0, bytes([ym.OP_RETURN]) + ym.push(ym.encode_transfer(assignments))))
        ins = [(t, k, b"", 0xFFFFFFFF) for t, k, _v in coins] + [(u["txid"], u["vout"], b"", 0xFFFFFFFF) for u in utxos]
        raw = ym.serialize_tx_v4(ins, vouts, 0, n.getblockcount() + 30)
        return n.signrawtransaction(bytes_to_hex_str(raw))["hex"]

    def yed_coin(self, i, kinds, cents=None):
        """A confirmed, unspent YED coin of node i's wallet whose holder script is one of ``kinds`` (and of ``cents``)."""
        n = self.node(i)
        for c in n.yed_listunspent():
            if c.get("spentUnconfirmed") or (cents is not None and c["cents"] != cents): continue
            spk = n.getrawtransaction(c["txid"], 1)["vout"][c["vout"]]["scriptPubKey"]["hex"]
            if self.holder_kind(spk) in kinds: return c
        return None

    def channel_script(self, client33, server_pk, refund):
        """D-Q-19 TX_PQCHANNEL: IF <client> CHECKPQSIG VERIFY <server> CHECKSIG ELSE <refund> CLTV DROP <client> CHECKPQSIG ENDIF."""
        return (bytes([0x63]) + ym.pq_owner_slot(client33)[:-1] + bytes([0xc2, 0x69]) + ym.push(server_pk) + bytes([0xac, 0x67])
                + ym.push_int(refund) + bytes([0xb1, 0x75]) + ym.pq_owner_slot(client33) + bytes([0x68]))

    CHANNEL_CENTS = 1_000             # what the walk puts into a channel; the rest of the coin returns to node 0

    def channel_fund(self, coin, spk):
        """A TRANSFER of CHANNEL_CENTS of node 0's ``coin`` into the channel ``spk`` (vout 0), the rest back to a node-0 holder."""
        outs, assign = [(spk, 10_000)], [(0, min(self.CHANNEL_CENTS, coin["cents"]))]
        if coin["cents"] > self.CHANNEL_CENTS:
            outs.append((self.holder_script(self.node(USER)), 10_000)); assign.append((1, coin["cents"] - self.CHANNEL_CENTS))
        return self.raw_transfer(USER, [(coin["txid"], coin["vout"], coin["valueZat"])], outs, assign)

    def s_pq(self):
        falcon = self.falcon_active()
        self.step("pq", "post-quantum owners and holders: PQ vault owners (YED and the primitive), PQ holder transfers, the hybrid channel "
                        "(Falcon %s)" % ("ACTIVE" if falcon else "inactive"))
        pq = self.call(USER, "yed_getinfo", keys=["rpcversion"])
        pq = self.pq_params()
        self.out("    = params.pq %s" % jdump(pq))
        self.ok(self.node(USER).yed_getinfo()["rpcversion"] == 8 and pq.get("schemes") == ([1, 2] if falcon else [1]),
                "rpcversion 8; params.pq.schemes %s, falconActive %s, falconHeight %s" % (pq.get("schemes"), pq.get("falconActive"), pq.get("falconHeight")))
        # every YED vault's owner is SLH-DSA (D-Q-1): vault E, minted by the wallet's yed_mint (with --only: the wallet's newest)
        if "E" not in self.vaults:
            self.vaults["E"] = max(self.node(USER).yed_listpositions("ACTIVE"), key=lambda r: r.get("refHeight", 0))["txid"]
        va = self.call(USER, "yed_getvault", self.vaults["E"], keys=["ownerScheme", "ownerHash", "ownerAddress", "scriptPubKey"])
        raw = self.node(USER).getrawtransaction(self.vaults["E"], 1)
        payload = self.node(USER).yed_decodepayload(raw["vout"][2]["scriptPubKey"]["hex"])
        token = self.holder_kind(raw["vout"][1]["scriptPubKey"]["hex"])
        self.ok(va["ownerScheme"] == 1 and len(va["ownerAddress"]) == 53 and va["ownerAddress"][:2] == "yr" and "ownerPubKey" not in va
                and ("20" + va["ownerHash"] + "51c2") in va["scriptPubKey"] and payload["version"] == 4 and payload["ownerHash"] == va["ownerHash"],
                "vault E's owner is SLH-DSA: ownerScheme 1, a 53-character yr… owner address, the V's owner slot <hash> OP_1 OP_CHECKPQSIG, a v4 MINT payload")
        self.ok(token == ("falcon" if falcon else "p2pkh"), "the wallet mint's token went to a %s holder (the holder policy, A-13): %s" % ("Falcon" if falcon else "P2PKH", token))
        self.evidence("pq_mint", {"vault": self.vaults["E"], "ownerAddress": va["ownerAddress"], "token": token})

        # the primitive with a PQ owner (vault_getnewowner -> vault_lock -> vault_ownerspend), SLH-DSA always, Falcon once active
        schemes = [1, 2] if falcon else [1]
        spends = {}
        for scheme in schemes:
            owner = self.call(USER, "vault_getnewowner", scheme, keys=["scheme", "owner", "address"])
            oh = self.tip() + 3
            lock = self.call(USER, "vault_lock", {"tag": "PQOW", "setid": self.set_id, "delay": 5, "ownerheight": oh, "amount": 2, "owner": owner["owner"]},
                             keys=["outpoint", "owner"])
            self.wait_mempool(lock["txid"]); self.mine(1)
            dec = self.node(USER).vault_decodescript(lock["script"])
            self.ok(lock["owner"] == owner["owner"] and dec["owner"] == owner["owner"] and dec.get("ownerscheme", scheme) == scheme,
                    "vault_lock under the attestor set with the wallet's scheme-%d owner %s…" % (scheme, owner["owner"][:18]))
            self.fails(USER, "vault_ownerspend", lock["outpoint"], self.node(USER).getnewaddress(), expect="owner branch opens at height")
            self.mine_to(oh)
            spent = self.call(USER, "vault_ownerspend", lock["outpoint"], self.node(USER).getnewaddress())
            self.wait_mempool(spent["txid"]); self.mine(1)
            ss = self.node(USER).getrawtransaction(spent["txid"], 1)["vin"][0]["scriptSig"]["hex"]
            want = 7_900 if scheme == 1 else 1_500
            self.ok(spent["selector"] == 2 and ss.endswith("52") and len(ss) // 2 > want and lock["outpoint"] not in {r["outpoint"] for r in self.node(USER).vault_list()},
                    "vault_ownerspend: selector 2 with a %s owner signature (scriptSig %d bytes), mined; the vault is gone"
                    % ("SLH-DSA" if scheme == 1 else "FN-DSA-512", len(ss) // 2))
            spends[scheme] = {"lock": lock["outpoint"], "spend": spent["txid"], "scriptSigBytes": len(ss) // 2}
        self.evidence("pq_primitive", spends)

        # PQ holder transfers: user -> the holder's PQ address; the holder spends its PQ coin on to the claimant's PQ address
        to_h = self.call(HOLDER, "yed_getnewaddress", "pq")
        vh = self.node(HOLDER).yed_validateaddress(to_h)
        kind = "falcon" if vh["pqscheme"] == 2 else "slh"
        self.ok(len(to_h) == 53 and vh["type"] == "pq" and vh["pqscheme"] == (2 if falcon else 1),
                "yed_getnewaddress pq: a 53-character %s holder address" % ("FN-DSA-512" if falcon else "SLH-DSA (Falcon inactive)"))
        a = self.call(USER, "yed_send", to_h, 2_000, keys=["txid"])
        self.wait_mempool(a["txid"]); self.mine(1)
        coin = self.yed_coin(HOLDER, (kind,), 2_000)
        self.ok(coin is not None and coin["cents"] == 2_000, "the holder holds 20 YED behind a %s TX_PQPKH" % kind)
        to_c = self.node(CLAIMANT).yed_getnewaddress("pq")
        bal = self.node(HOLDER).yed_getbalance()["confirmedCents"]
        b = self.call(HOLDER, "yed_send", to_c, bal, keys=["txid", "burnedCents"])
        self.wait_mempool(b["txid"]); self.mine(1)
        # node 0 has -txindex: a spent input's transaction is not found elsewhere once all its outputs are spent
        tx = self.node(USER).getrawtransaction(b["txid"], 1)
        pq_in = [v for v in tx["vin"] if self.holder_kind(self.node(USER).getrawtransaction(v["txid"], 1)["vout"][v["vout"]]["scriptPubKey"]["hex"]) == kind]
        self.ok(pq_in and min(len(v["scriptSig"]["hex"]) // 2 for v in pq_in) > (7_800 if kind == "slh" else 1_500) and not b.get("burnedCents"),
                "the holder's %s coin moved on to the claimant's PQ address: a %s holder signature (scriptSig %d bytes), nothing burned"
                % (kind, "SLH-DSA" if kind == "slh" else "FN-DSA-512", len(pq_in[0]["scriptSig"]["hex"]) // 2 if pq_in else 0))
        self.evidence("pq_transfer", {"in": a["txid"], "on": b["txid"], "kind": kind})

        # D-Q-19, the hybrid channel: a TRANSFER into TX_PQCHANNEL (client PQ, server secp256k1)
        server_addr = self.node(USER).getnewaddress()
        server_pk = hex_str_to_bytes(self.node(USER).validateaddress(server_addr)["pubkey"])
        refund = self.tip() + 1000
        if not falcon:
            # an SLH-DSA client before Falcon: funded and closed cooperatively, the client signature by the Python signer
            from test_framework import pq as _pq
            from test_framework.key import CECKey
            from test_framework.script import CScript, SIGHASH_ALL, SignatureHash
            client = new_pq_owner("devnet-walk-channel-client")
            spk = self.channel_script(client, server_pk, refund)
            c = self.yed_coin(USER, ("p2pkh", "slh", "falcon"))
            hex1 = self.channel_fund(c, spk)
            t1 = self.call(USER, "sendrawtransaction", hex1)
            self.wait_mempool(t1); self.mine(1)
            client_addr = ym.base58check_encode(bytes.fromhex(self.yed_params()["pqAddressVersion"]) + client)
            rows = self.node(USER).yed_listtokens([client_addr])
            self.ok(self.node(USER).getrawtransaction(t1, 1)["vout"][0]["scriptPubKey"]["type"] == "pqchannel" and [r["cents"] for r in rows] == [min(self.CHANNEL_CENTS, c["cents"])],
                    "TRANSFER %s into a hybrid channel (SLH-DSA client, EC server): type pqchannel, %d cents listed under the client's address" % (t1[:16], min(self.CHANNEL_CENTS, c["cents"])))
            hex2 = self.raw_transfer(USER, [(t1, 0, 10_000)], [(self.holder_script(self.node(USER)), 10_000)], [(0, min(self.CHANNEL_CENTS, c["cents"]))])
            tx = CTransaction(); tx.deserialize(BytesIO(hex_str_to_bytes(hex2)))
            sighash = SignatureHash(CScript(spk), tx, 0, SIGHASH_ALL, 10_000, SIGNING_BRANCH_ID)[0]
            key = CECKey(); key.set_secretbytes(wif_to_secret(self.node(USER).dumpprivkey(server_addr))); key.set_compressed(True)
            ec = _low_s(key.sign(sighash)) + bytes([SIGHASH_ALL])
            pushes = _pq.pq_sign_input(tx, 0, spk, 10_000, SIGNING_BRANCH_ID, PQ_OWNER_SECRETS[client])
            tx.vin[0].scriptSig = ym.push(ec) + _pq.pq_scriptsig_from_pushes(pushes) + bytes([0x51])
            t2 = self.call(USER, "sendrawtransaction", bytes_to_hex_str(tx.serialize()))
            self.wait_mempool(t2); self.mine(1)
            self.ok(self.node(USER).yed_listtokens([client_addr]) == [] and self.node(USER).yed_gettxinfo(t2)["type"] == "transfer",
                    "the cooperative close %s (server ECDSA + client SLH-DSA, selector OP_1) moved the YED out of the channel" % t2[:16])
            self.evidence("pq_channel", {"fund": t1, "close": t2, "client": "slh"})
        else:
            # Falcon active: TOK-PQ admits a channel only with a scheme-2 client; an SLH-DSA client is bad-yed-holder everywhere
            slh = hex_str_to_bytes(self.node(USER).vault_getnewowner(1)["owner"])
            c = self.yed_coin(USER, ("falcon", "p2pkh", "slh"))
            bad = self.channel_fund(c, self.channel_script(slh, server_pk, refund))
            for i in self.yed_nodes:
                self.fails(i, "sendrawtransaction", bad, expect="bad-yed-holder")
            from test_framework import pq as _pq
            if not _pq.falcon_signer_available():
                # no C compiler for the framework's optional Falcon signer: a wallet-held Falcon client, funded only
                fal = self.node(USER).yed_validateaddress(self.node(USER).yed_getnewaddress("pq"))
                client = hex_str_to_bytes(fal["keyid"])
                good = self.channel_fund(c, self.channel_script(client, server_pk, refund))
                t1 = self.call(USER, "sendrawtransaction", good)
                self.wait_mempool(t1); self.mine(1)
                rows = self.node(USER).yed_listtokens([fal["address"]])
                self.ok(self.node(USER).getrawtransaction(t1, 1)["vout"][0]["scriptPubKey"]["type"] == "pqchannel" and [r["cents"] for r in rows] == [min(self.CHANNEL_CENTS, c["cents"])],
                        "TRANSFER %s into a hybrid channel with a Falcon client: type pqchannel, %d cents listed under the client's address (TOK-PQ admits it)" % (t1[:16], min(self.CHANNEL_CENTS, c["cents"])))
                self.note("the channel is not closed here: no C compiler for the framework's optional Falcon signer (pq.falcon_signer_available) "
                          "and the node wallet does not sign TX_PQCHANNEL; its %d cents stay in the channel on this devnet" % min(self.CHANNEL_CENTS, c["cents"]))
                self.evidence("pq_channel", {"fund": t1, "refusedSlhClient": True, "client": "falcon", "closed": False})
            else:
                # a Falcon client funded and closed cooperatively: the client's FN-DSA-512 signature by the framework's
                # Falcon signer (the tree's vendored PQClean C through ctypes), the server's ECDSA by node 0's key
                from test_framework.key import CECKey
                from test_framework.script import CScript, SIGHASH_ALL, SignatureHash
                import hashlib
                fpk, fsk = _pq.falcon_keygen(hashlib.sha384(b"devnet-walk-channel-client-falcon %d" % refund).digest())
                client = bytes([_pq.SCHEME_FN_DSA_512]) + _pq.key_hash(_pq.SCHEME_FN_DSA_512, fpk)
                client_addr = ym.base58check_encode(bytes.fromhex(self.yed_params()["pqAddressVersion"]) + client)
                spk = self.channel_script(client, server_pk, refund)
                cents = min(self.CHANNEL_CENTS, c["cents"])
                good = self.channel_fund(c, spk)
                t1 = self.call(USER, "sendrawtransaction", good)
                self.wait_mempool(t1); self.mine(1)
                rows = self.node(USER).yed_listtokens([client_addr])
                self.ok(self.node(USER).getrawtransaction(t1, 1)["vout"][0]["scriptPubKey"]["type"] == "pqchannel" and [r["cents"] for r in rows] == [cents],
                        "TRANSFER %s into a hybrid channel with a Falcon client: type pqchannel, %d cents listed under the client's address (TOK-PQ admits it)" % (t1[:16], cents))
                before = self.node(USER).yed_getbalance()["confirmedCents"]
                hex2 = self.raw_transfer(USER, [(t1, 0, 10_000)], [(self.holder_script(self.node(USER)), 10_000)], [(0, cents)])
                tx = CTransaction(); tx.deserialize(BytesIO(hex_str_to_bytes(hex2)))
                sighash = SignatureHash(CScript(spk), tx, 0, SIGHASH_ALL, 10_000, SIGNING_BRANCH_ID)[0]
                key = CECKey(); key.set_secretbytes(wif_to_secret(self.node(USER).dumpprivkey(server_addr))); key.set_compressed(True)
                ec = _low_s(key.sign(sighash)) + bytes([SIGHASH_ALL])
                pushes = _pq.pq_sign_input(tx, 0, spk, 10_000, SIGNING_BRANCH_ID, fsk, scheme=_pq.SCHEME_FN_DSA_512, pk=fpk)
                tx.vin[0].scriptSig = ym.push(ec) + _pq.pq_scriptsig_from_pushes(pushes) + bytes([0x51])
                t2 = self.call(USER, "sendrawtransaction", bytes_to_hex_str(tx.serialize()))
                self.wait_mempool(t2); self.mine(1)
                after = self.node(USER).yed_getbalance()["confirmedCents"]
                close = self.node(USER).getrawtransaction(t2, 1)
                self.ok(self.node(USER).yed_listtokens([client_addr]) == [] and self.node(USER).yed_gettxinfo(t2)["type"] == "transfer"
                        and close["confirmations"] >= 1 and after - before == cents
                        and self.holder_kind(close["vout"][0]["scriptPubKey"]["hex"]) == "falcon",
                        "the cooperative close %s (server ECDSA + client FN-DSA-512, selector OP_1, scriptSig %d bytes) released the channel's "
                        "%d cents to node 0's Falcon holder (yed_getbalance +%d)" % (t2[:16], len(tx.vin[0].scriptSig), cents, after - before))
                self.evidence("pq_channel", {"fund": t1, "close": t2, "refusedSlhClient": True, "client": "falcon", "closed": True})
        self.statehashes("pq")


    # ------------------------------------------------------------------ redeem / renew
    def s_redeem(self):
        self.step("redeem", "owner redeem at lockHeight (selector 2), and renew (redeem + mint the same debt)")
        va = self.node(USER).yed_getvault(self.vaults["A"])
        in_term = self.node(USER).yed_getinfo()["params"].get("inTermClaims") is True
        if in_term:
            # D-IT-15: the owner path is open in term; IT-9: a redeem before lockHeight pays the early-redeem fee
            q = self.call(USER, "yed_estimateredeem", self.vaults["A"], keys=["early", "earlyRedeemFeeBps", "earlyRedeemFeeZat", "feeZat", "canRedeem", "lockHeight"])
            self.ok(q["early"] is True and q["canRedeem"] is True and q["earlyRedeemFeeZat"] == ym.early_redeem_fee_zat(va["mintedCents"], q["earlyRedeemFeeBps"], va["pMint"]),
                    "in term the redeem is open and quoted with the early-redeem fee (IT-9', D-Q-23: %d bps of the debt at pMint = %d zat); the walk waits for lockHeight here"
                    % (q["earlyRedeemFeeBps"], q["earlyRedeemFeeZat"]))
        else:
            self.fails(USER, "yed_redeem", self.vaults["A"], expect="vault-locked")
        self.mine_to(va["lockHeight"] - 1)                 # the redeem confirms at lockHeight, the first block without the early fee
        red = self.call(USER, "yed_redeem", self.vaults["A"], keys=["txid", "burnedCents", "collateralZat", "feeZat", "earlyRedeemFeeZat"])
        self.wait_mempool(red["txid"]); self.mine(1)
        if in_term:
            self.ok(red.get("earlyRedeemFeeZat") == 0, "a redeem confirming at lockHeight pays FEE-1 only (earlyRedeemFeeZat 0)")
        tx = self.node(USER).getrawtransaction(red["txid"], 1)
        self.ok(tx["vin"][0]["scriptSig"]["hex"].endswith("52"), "the redeem spends V with selector 2 (scriptSig ends OP_2)")
        self.ok(self.node(USER).yed_getvault(self.vaults["A"])["status"] == "CLOSED", "vault A CLOSED")
        self.evidence("redeem_txid", red["txid"])
        # renew: the wallet's renew flow is redeem then a new mint of the same debt (hardening H-8)
        vb = self.node(USER).yed_getvault(self.vaults["B"])
        self.mine_to(vb["lockHeight"])
        red_b = self.call(USER, "yed_redeem", self.vaults["B"], keys=["txid", "burnedCents"])
        self.wait_mempool(red_b["txid"]); self.mine(1, quiet=True)
        res, renewed = self.two_step(USER, "yed_mint", vb["mintedCents"], LOCK_BLOCKS, "", "")
        self.mine(1)
        nb = self.call(USER, "yed_getvault", renewed, keys=["status", "mintedCents", "lockHeight", "claimHeight"])
        self.ok(self.node(USER).yed_getvault(self.vaults["B"])["status"] == "CLOSED" and nb["status"] == "ACTIVE" and nb["mintedCents"] == vb["mintedCents"],
                "renewed: B CLOSED, B' ACTIVE with the same %d cents and a later lockHeight (%d -> %d)" % (vb["mintedCents"], vb["lockHeight"], nb["lockHeight"]))
        self.vaults["B2"] = renewed
        self.evidence("renew", {"redeem": red_b["txid"], "mint": renewed})

    # ------------------------------------------------------------------ claim
    def s_claim(self):
        self.step("claim", "an underwater claim -> claimant intent -> a reorg across it -> release after CLAIM_DELAY")
        vc = self.node(USER).yed_getvault(self.vaults["C"])
        self.devnet("price", CRASH)
        self.note("the pools' quote agents and every automated attestor now see $%s; P_claim falls once the slow window fills" % CRASH)
        target = max(vc["claimHeight"], self.tip() + 66)
        while self.tip() < target:
            self.mine(min(20, target - self.tip()), quiet=True)
        self.mine(2, stratum="clients" not in self.skip)
        price = self.call(USER, "yed_getprice", keys=["pClaim", "pMid", "pSlow", "aClaim", "xClaim"])
        claimable = self.call(USER, "yed_listclaimable", show=False)
        self.out("    = yed_listclaimable: %s" % jdump([pick(c, ["vault", "mintedCents", "pClaim", "collateralZat"]) for c in claimable], 600))
        self.ok(self.vaults["C"] + ":0" in {c["vault"] for c in claimable}, "vault C is claimable at P_claim %s" % price.get("pClaim"))
        res, claim = self.two_step(CLAIMANT, "yed_claim", self.vaults["C"], "", "")
        claim_block = self.node(POOLS[self.tip() % 3]).generate(1)[0]
        sync_blocks(self.all_nodes())
        self.out("  ~ mined the claim in %s at %d" % (claim_block[:16], self.tip()))
        v = self.call(USER, "yed_getvault", self.vaults["C"], keys=["status", "intents", "burnedCents"])
        raw = self.node(USER).getrawtransaction(claim, 1)
        idec = self.call(USER, "vault_decodescript", raw["vout"][0]["scriptPubKey"]["hex"], keys=["type", "tag", "setid", "cancelsetid", "delay"])
        self.ok(v["status"] == "CLAIMING" and raw["vin"][0]["scriptSig"]["hex"] == "54" and idec["type"] == "intent",
                "claim %s: selector 4 (OP_4) moved vault C into a claimant intent (CLAIMING)" % claim[:16])
        intents = self.call(USER, "vault_list", {"kind": "intent"}, keys=None, limit=800)
        self.ok(any(r["outpoint"] == claim + ":0" for r in intents), "vault_list shows the intent %s:0 (matures at %s)" % (claim[:16], claim and [r.get("matureheight") for r in intents if r["outpoint"] == claim + ":0"]))
        claiming = self.statehashes("claim C")
        self.chainviz("an intent outstanding", intent=claim + ":0")
        self.lwd_probe("an intent outstanding")
        self.lwd_equality("an intent outstanding")

        self.note("a reorg across the claim: invalidateblock on every node, then reconsiderblock")
        for i in range(self.n): self.node(i).invalidateblock(claim_block)
        self.out("  $ invalidateblock %s on all %d nodes" % (claim_block[:16], self.n))
        sts = {i: self.node(i).yed_getvault(self.vaults["C"])["status"] for i in self.yed_nodes}
        self.out("    = vault C status per node: %s" % jdump(sts))
        self.ok(set(sts.values()) == {"ACTIVE"}, "after the reorg vault C is ACTIVE again on every Yellowback node, no intent")
        in_mempool = claim in self.node(USER).getrawmempool()
        self.out("    claim back in node0's mempool: %s" % in_mempool)
        for i in range(self.n): self.node(i).reconsiderblock(claim_block)
        sync_blocks(self.all_nodes())
        self.out("  $ reconsiderblock %s on all %d nodes" % (claim_block[:16], self.n))
        sts = {i: self.node(i).yed_getvault(self.vaults["C"])["status"] for i in self.yed_nodes}
        self.ok(set(sts.values()) == {"CLAIMING"}, "reconsidered: CLAIMING again everywhere")
        self.ok(self.statehashes("reconsidered") == claiming, "the state hashes after the reorg round trip equal those before it")

        self.fails(CLAIMANT, "vault_release", claim + ":0", expect="matures at height")
        claim_h = self.node(USER).getblock(claim_block)["height"]
        self.mine_to(claim_h + CLAIM_DELAY - 1)
        rel = self.call(CLAIMANT, "vault_release", claim + ":0")
        self.wait_mempool(rel); self.mine(1)
        v = self.call(USER, "yed_getvault", self.vaults["C"], keys=["status", "burnedCents"])
        self.ok(v["status"] == "CLAIMED", "release %s after CLAIM_DELAY: vault C CLAIMED" % rel[:16])
        self.evidence("claim", {"claim": claim, "claim_block": claim_block, "release": rel})

    # ------------------------------------------------------------------ cancel
    def s_cancel(self):
        self.step("cancel", "a wrong-price claim cancelled by one attestor: the vault ACTIVE again, the burn refunded (CAN-1)")
        stats0 = self.node(USER).yed_getstats()
        spk = self.node(USER).yed_getvault(self.vaults["D"])["scriptPubKey"]
        res, claim = self.two_step(CLAIMANT, "yed_claim", self.vaults["D"], "", "")
        self.mine(1)
        v = self.call(USER, "yed_getvault", self.vaults["D"], keys=["status", "intents", "burnedCents"])
        self.ok(v["status"] == "CLAIMING", "claim %s on vault D: CLAIMING" % claim[:16])
        mid = self.call(USER, "yed_getstats", keys=["supplyCents"])
        self.ok(mid["supplyCents"] == stats0["supplyCents"] - MINT_CENTS, "the claim burned its %d cents" % MINT_CENTS)
        self.devnet("price", PRICE)
        base = [c for c in self.yed_params()["classes"] if c["class"] == "A"][0]["baseRatioBps"] // 100
        self.note("the attestors' reference is back at $%s: at their price vault D is %d %% collateralised, so the claim is wrong "
                  "and one attestor (node %d) cancels it; consensus never learns why (§3.4)" % (int(PRICE), base, CANCELLER))
        self.fails(CANCELLER, "vault_buildcancel", claim + ":0", expect="is cancelled with yed_buildcancel")
        claimant_before = self.call(CLAIMANT, "yed_getbalance", keys=["confirmedCents"])["confirmedCents"]
        holder = self.node(USER).yed_getvault(self.vaults["D"])["refundHolder"]
        # the cancel-limit design (CAN-2 + C4b): the first cancel of a vault needs one member's co-signature, which is its
        # signed price statement at the claim's refHeight saying the vault was not claimable. The node's equivocation
        # guard states the price this attestor already signed for that height; only when it signed none is $PRICE stated.
        # A canceller whose own attestation at that height said "claimable" cannot co-sign (cancel-statement-claimable):
        # under C4b that cancel is the slashable kind, so the scenario needs an attestor that did not attest the crash there.
        self.fails(CANCELLER, "yed_buildcancel", claim + ":0", expect="cancel-cosign-needed")
        # The agents sign every ATTEST_INTERVAL blocks on their own phase, so whether node 5 attested at the claim's refHeight
        # depends on the run's heights. If it did (cancel-statement-claimable), another member whose agent did not co-signs:
        # yed_buildcancel takes any distinct current member's co-signature, and node 5 still builds and signs the cancel.
        cos, refused = None, []
        for i in (CANCELLER,) + tuple(a for a in ATTESTORS + (SEAT,) if a != CANCELLER):
            try:
                cos = self.node(i).yed_signcancelcosign(claim + ":0")
            except Exception as error:
                message = str(getattr(error, "error", {}).get("message", error))
                if "price-required" in message:
                    cos = self.call(i, "yed_signcancelcosign", claim + ":0", int(PRICE) * 1_000_000, keys=["cosig", "seq", "citedHeight"])
                elif "cancel-statement-claimable" in message:
                    refused.append(i)
                    self.note("node %d attested the crash at the claim's refHeight and cannot co-sign its cancel (C4b): %s" % (i, message[:120]))
                    continue
                else:
                    raise
            break
        self.ok(cos is not None, "a member co-signs the cancel (nodes refused: %s)" % (refused or "none"))
        built = self.call(CANCELLER, "yed_buildcancel", claim + ":0", [cos["cosig"]],
                          keys=["required", "cancelsetid", "deadline", "refund", "cancelsRequired", "cosigners"])
        self.ok(built["cancelsRequired"] == 1 and built["cosigners"] == [cos["seq"]],
                "the vault's first cancel needs one co-signer (CAN-2): seq %d, its statement citing %d" % (cos["seq"], cos["citedHeight"]))
        self.ok(built["refund"]["cents"] == MINT_CENTS and built["refund"]["script"] == holder and built["refund"]["vout"] == 1,
                "yed_buildcancel adds CAN-1's refund of %d cents to the claim's YED holder at output 1" % MINT_CENTS)
        signed = self.call(CANCELLER, "set_signcancel", built["hex"], keys=["complete", "signatures", "required", "sighash"])
        self.ok(signed["complete"] and signed["signatures"] == 1, "one attestor signature completes the cancel (cancelThreshold 1)")
        cancel = self.call(CANCELLER, "vault_send", signed["hex"])
        self.wait_mempool(cancel); self.mine(1)
        self.fails(USER, "yed_getvault", self.vaults["D"], expect="")
        vd = self.call(USER, "yed_getvault", cancel, keys=["status", "mintedCents", "scriptPubKey"])
        self.ok(vd["status"] == "ACTIVE" and vd["scriptPubKey"] == spk, "the position is ACTIVE at the cancel's output 0, byte-identical V")
        after = self.call(USER, "yed_getstats", keys=["supplyCents", "activeVaults"])
        self.ok(after["supplyCents"] == stats0["supplyCents"], "the burn is refunded (CAN-1): supply back at %d" % after["supplyCents"])
        log = self.call(USER, "yed_gettxinfo", cancel, keys=["type", "reopenedVaults", "assigned"])
        self.ok(log["type"] == "claim_cancel" and log["assigned"] == [{"vout": 1, "cents": MINT_CENTS}], "yed_gettxinfo calls it claim_cancel, the refund at output 1")
        got = self.call(CLAIMANT, "yed_getbalance", keys=["confirmedCents"])["confirmedCents"]
        self.ok(got == claimant_before + MINT_CENTS, "the claimant holds its %d cents again (%d -> %d)" % (MINT_CENTS, claimant_before, got))
        self.fails(CLAIMANT, "vault_release", claim + ":0", expect="")
        self.vaults["D2"] = cancel
        self.evidence("cancel", {"claim": claim, "cancel": cancel})
        self.chainviz("after the cancel", cancelled=claim + ":0")

    # ------------------------------------------------------------------ interm (in-term claims plan)
    def s_interm(self):
        self.step("interm", "an in-term claim: the claim path opens at theta, not at the term end (in-term claims plan IT-2, IT-7)")
        params = self.call(USER, "yed_getinfo", keys=["rpcversion", "params"])["params"]
        if params.get("inTermClaims") is not True:
            self.note("SKIP: yed_getinfo.params.inTermClaims is %r on this node: a vault is claimable post-term only (the pre-plan rule set), "
                      "so there is no in-term claim to walk" % params.get("inTermClaims"))
            self.summary["steps"]["interm"] = "SKIP: inTermClaims is not true on this node"
            return
        theta, delay = params["claimThresholdBps"], params["claimDelay"]
        base = [c for c in params["classes"] if c["class"] == "A"][0]["baseRatioBps"]
        self.note("theta %d %%, claimDelay %d, class A %d %% (D-IT-2, D-IT-4, D-IT-13)" % (theta // 100, delay, base // 100))
        p0 = self.node(USER).yed_getprice()["pClaim"]
        if p0 is None or abs(p0 - int(PRICE) * 1_000_000) > int(PRICE) * 50_000:
            self.devnet("price", PRICE)
            self.mine(66, quiet=True)
            p0 = self.call(USER, "yed_getprice", keys=["pClaim"])["pClaim"]
        self.fund_user()
        res, f = self.two_step(USER, "yed_mint", MINT_CENTS, IN_TERM_LOCK, "", "")
        res, g = self.two_step(USER, "yed_mint", MINT_CENTS, IN_TERM_LOCK, "", "")
        res, h = self.two_step(USER, "yed_mint", MINT_CENTS, IN_TERM_LOCK, "", "")
        self.mine(1)
        # the claimant burned 100 YED on C (D's burn came back with the cancel, CAN-1): fund it for the claim of F if short
        bal = self.call(CLAIMANT, "yed_getbalance", keys=["confirmedCents"])
        if bal["confirmedCents"] < MINT_CENTS + 100:
            fund = self.call(USER, "yed_send", self.node(CLAIMANT).yed_getnewaddress(), 2 * MINT_CENTS, keys=["txid"])
            self.wait_mempool(fund["txid"]); self.mine(1)
            self.note("the claimant (node 10) now holds %s YED for the in-term claim" % (Decimal(self.node(CLAIMANT).yed_getbalance()["confirmedCents"]) / 100))
        self.vaults["F"], self.vaults["G"], self.vaults["H"] = f, g, h
        vf = self.call(USER, "yed_getvault", f, keys=["status", "termClass", "mintedCents", "collateralZat", "lockHeight", "claimHeight", "refHeight", "claimable", "underwaterAt"])
        self.ok(vf["status"] == "ACTIVE" and vf["termClass"] == "A" and self.tip() < vf["lockHeight"], "vault F is ACTIVE, class A, in term (lockHeight %d, tip %d)" % (vf["lockHeight"], self.tip()))
        dec = self.call(USER, "vault_decodescript", self.node(USER).yed_getvault(f)["scriptPubKey"], keys=["appheight", "ownerheight", "delay"])
        self.ok(dec["appheight"] == vf["refHeight"] + 1, "F's V has appHeight = refHeight + 1 = %d: the APP branch is open from the mint, RED-4 governs (IT-1)" % (vf["refHeight"] + 1))
        at = (vf["mintedCents"] * theta * 100_000_000 + vf["collateralZat"] - 1) // vf["collateralZat"]     # ceil, as the node's UnderwaterAt
        self.out("    computed: F becomes claimable at pClaim < $%s (%d cents x %d bps x COIN / %d zat); the node's underwaterAt is $%s"
                 % (Decimal(at) / 1_000_000, vf["mintedCents"], theta, vf["collateralZat"], Decimal(vf["underwaterAt"] or 0) / 1_000_000))
        self.ok(vf["underwaterAt"] == at, "yed_getvault.underwaterAt equals the computed threshold price (theta %d %%)" % (theta // 100))

        # above theta: refused everywhere
        self.ok(vf["claimable"] is False, "above theta (pClaim $%s): yed_getvault says claimable: false" % (Decimal(p0) / 1_000_000))
        for i in self.yed_nodes:
            rows = [r for r in self.node(i).yed_listclaimable() if r["vault"] == f + ":0"]
            if rows:
                self.out("    node%d yed_listclaimable row for F: %s" % (i, jdump(pick(rows[0], ["claimable", "underwaterAt", "pClaim", "claimPath"]))))
            self.ok(not rows or rows[0].get("claimable") is False, "node%d: F is not claimable above theta (yed_listclaimable)" % i)
            self.ok(self.node(i).yed_getvault(f)["claimable"] is False, "node%d: yed_getvault F claimable: false" % i)
        self.fresh_spend(CLAIMANT, f)
        self.fails(CLAIMANT, "yed_claim", f, "", "", False, 0, 0, expect="claim-not-underwater")
        self.note("the wallet refuses before anything is signed; a claim transaction above theta would fail RED-4 in every Yellowback mempool and block (IT-2)")
        # D-IT-15: the owner redeems G in term, above theta; IT-9: it pays the early-redeem fee
        early_g = self.redeem_in_term(g, "G", "above theta")

        # the price falls until F crosses theta in term
        crash = (Decimal(at) * 9 / 10 / 1_000_000).quantize(Decimal("0.01"))
        self.devnet("price", str(crash))
        self.note("$%s puts F's collateral at %d %% of its debt, under theta (%d %%); the slow window fills over the next blocks" % (crash, theta * 9 // 1000, theta // 100))
        self.mine(66, quiet=True)
        self.mine(2)
        price = self.call(USER, "yed_getprice", keys=["pClaim", "pMid", "pSlow", "aClaim", "xClaim"])
        self.ok(price["pClaim"] is not None and price["pClaim"] < at, "pClaim $%s is under F's threshold price $%s" % (Decimal(price["pClaim"] or 0) / 1_000_000, Decimal(at) / 1_000_000))
        self.ok(self.tip() < vf["lockHeight"], "still in term: tip %d < lockHeight %d (claimHeight would have been %d)" % (self.tip(), vf["lockHeight"], vf["claimHeight"]))
        rows = []
        for attempt in range(8):
            # after a burst of blocks the agents lag and the row carries claimPath "" (no bundle yet): wait for fresh attestations
            self.fresh(USER)
            rows = [r for r in self.call(USER, "yed_listclaimable", show=False, quiet=attempt > 0) if r["vault"] == f + ":0"]
            if rows and rows[0].get("claimPath"): break
            time.sleep(1.5); self.mine(1, quiet=True)
        self.out("    = yed_listclaimable row for F: %s" % jdump(rows and pick(rows[0], ["claimable", "claimPath", "pClaim", "underwaterAt", "residualZat", "mintedCents", "collateralZat"])))
        self.ok(rows and rows[0].get("claimable", True) is True and rows[0].get("claimPath") == "a", "F is claimable in term by clause (a)")
        # IT-8 "redeeming stops it": H is as underwater as F; its owner redeems it in term before anyone claims it
        self.ok(self.node(USER).yed_getvault(h)["claimable"] is True, "H is claimable in term too (yed_getvault)")
        early_h = self.redeem_in_term(h, "H", "under theta, pre-empting a claim")
        self.fails(CLAIMANT, "yed_claim", h, "", "", False, 0, 0, expect="vault-not-active")
        min_out = (rows[0]["collateralZat"] - int(rows[0].get("residualZat") or 0)) * 95 // 100
        max_burn = rows[0]["mintedCents"] + 99
        res, claim = self.two_step(CLAIMANT, "yed_claim", f, "", "", after_wait=(min_out, max_burn),
                                   keys=["pending", "carrierTxid", "refHeight", "xClaim", "aClaim", "pClaim", "bundleSeqs"])
        self.note("H-9.3 bounds: minOutZat %d (95 %% of collateral - residual), maxBurnCents %d (the debt + a sub-dollar remainder)" % (min_out, max_burn))
        claim_h = self.mine(1)
        v = self.call(USER, "yed_getvault", f, keys=["status", "intents", "burnedCents"])
        raw = self.node(USER).getrawtransaction(claim, 1)
        self.ok(v["status"] == "CLAIMING" and raw["vin"][0]["scriptSig"]["hex"] == "54", "claim %s at height %d (in term): selector 4, F is CLAIMING" % (claim[:16], claim_h))
        info = self.call(USER, "yed_gettxinfo", claim, keys=["path", "claimPath", "burned", "pClaim", "residualZat", "collateralOut"])
        residual = [x for x in v.get("intents") or [] if x.get("role") == "residual"]
        self.statehashes("in-term claim")
        self.fails(CLAIMANT, "vault_release", claim + ":0", expect="matures at height")
        self.mine_to(claim_h + delay - 1)
        rel = self.call(CLAIMANT, "vault_release", claim + ":0")
        self.wait_mempool(rel); self.mine(1)
        v = self.call(USER, "yed_getvault", f, keys=["status", "burnedCents", "closingTxid"])
        self.ok(v["status"] == "CLAIMED", "release %s after claimDelay (%d): F CLAIMED" % (rel[:16], delay))
        if residual:
            r = residual[0]
            rr = self.call(USER, "vault_release", "%s:%d" % (r["txid"], r["vout"]))
            self.wait_mempool(rr); self.mine(1)
            paid = self.node(USER).getrawtransaction(rr, 1)["vout"][0]
            self.ok(paid["valueZat"] > 0, "the residual intent released to the owner: %s zat (RED-5)" % paid["valueZat"])
        else:
            self.note("no residual intent: at the claim price the collateral was worth less than theta x debt, so nothing lies above %d %% of the debt "
                      "(RED-5's residual is 0 for a clause-(a) claim at the threshold; the explainer's 'owner receives the rest' case needs a claim judged above it)" % (theta // 100))
        self.statehashes("in-term claim released")

        self.devnet("price", PRICE)
        self.evidence("interm", {"mint": f, "claim": claim, "release": rel, "redeemAboveTheta": early_g["txid"], "redeemUnderTheta": early_h["txid"],
                                 "earlyRedeemFeeZat": [early_g["earlyRedeemFeeZat"], early_h["earlyRedeemFeeZat"]],
                                 "thresholdMicroUsd": at, "crashPrice": str(crash)})
        self.summary["steps"]["interm"] = {"theta": theta, "claimHeightWouldHaveBeen": vf["claimHeight"], "claimedAt": claim_h, "residual": bool(residual),
                                           "earlyRedeemFeeZat": early_g["earlyRedeemFeeZat"]}

    def redeem_in_term(self, vault, label, why):
        """D-IT-15 + IT-9: the owner redeems `vault` before lockHeight; the fee output carries FEE-1 plus
        earlyRedeemFeeBps[class] of the debt at pMint (IT-9', D-Q-23; 5 % for class A), quoted first by yed_estimateredeem."""
        v = self.node(USER).yed_getvault(vault)
        cls = [c for c in self.node(USER).yed_getinfo()["params"]["classes"] if c["class"] == v["termClass"]][0]
        want = ym.early_redeem_fee_zat(v["mintedCents"], cls["earlyRedeemFeeBps"], v["pMint"])
        self.ok(self.tip() + 1 < v["lockHeight"], "%s is in term: the redeem confirms at %d < lockHeight %d" % (label, self.tip() + 1, v["lockHeight"]))
        q = self.call(USER, "yed_estimateredeem", vault, keys=["early", "earlyRedeemFeeBps", "earlyRedeemFeeZat", "feeZat", "payee", "canRedeem", "error"])
        self.ok(q["early"] is True and q["canRedeem"] is True and q["earlyRedeemFeeZat"] == want,
                "yed_estimateredeem quotes the early-redeem fee before the owner confirms: %d bps (class %s) of the debt %d cents at pMint %d = %d zat"
                % (cls["earlyRedeemFeeBps"], v["termClass"], v["mintedCents"], v["pMint"], want))
        red = self.call(USER, "yed_redeem", vault, keys=["txid", "burnedCents", "feeZat", "earlyRedeemFeeZat", "payee", "collateralOut"])
        self.ok(red["earlyRedeemFeeZat"] == want and red["feeZat"] == q["feeZat"] and red["burnedCents"] == v["mintedCents"],
                "the owner redeems %s in term (%s): burns the full debt, pays the early-redeem fee %d zat (%s %% of the debt at pMint) on top of FEE-1 (feeZat %d)"
                % (label, why, want, Decimal(cls["earlyRedeemFeeBps"]) / 100, red["feeZat"]))
        self.wait_mempool(red["txid"]); self.mine(1)
        tx = self.node(USER).getrawtransaction(red["txid"], 1)
        paid = sum(o["valueZat"] for o in tx["vout"] if o["scriptPubKey"].get("addresses") == [red["payee"]])
        self.ok(tx["vin"][0]["scriptSig"]["hex"].endswith("52") and paid >= red["feeZat"],
                "selector 2 (OP_2); the payee %s receives %d zat >= feeZat (IT-9: through the FEE-1 output)" % (red["payee"], paid))
        self.ok(self.node(USER).yed_getvault(vault)["status"] == "CLOSED", "%s CLOSED by its owner in term" % label)
        return red

    # ------------------------------------------------------------------ invalid
    def bad_mint(self, node):
        """A $50 mint (MINT-2: bad-mint-amount) on the YED V, signed by node's wallet (yellowback_upgrade.py)."""
        n = self.node(node)
        params = ym.Params.regtest(VAULT_ACTIVATION, attestor_set=self.set_id)
        owner = hex_str_to_bytes(n.vault_getnewowner()["owner"])     # a post-quantum (SLH-DSA) owner: every vault's (D-Q-1)
        holder = self.holder_script(n)                                 # P2PKH, or a Falcon TX_PQPKH once TOK-PQ binds
        change = hex_str_to_bytes(n.validateaddress(n.getnewaddress())["scriptPubKey"])
        ref = n.getblockcount() - REF_LAG
        lock = ref + 48
        coin = [u for u in n.listunspent() if u["amount"] > 2][0]
        vouts = [(1 * ym.COIN, ym.yed_vault_script(params, owner, ref)),
                 (10_000, holder),
                 (0, bytes([ym.OP_RETURN]) + ym.push(ym.encode_mint(0, 5_000, lock, ref, owner, ym.FEE_VOUT_NONE))),
                 (int(coin["amount"] * ym.COIN) - 1 * ym.COIN - 10_000 - 10_000, change)]
        raw = ym.serialize_tx_v4([(coin["txid"], coin["vout"], b"", 0xFFFFFFFF)], vouts, 0, ref + 40).hex()
        signed = n.signrawtransaction(raw)
        assert signed["complete"], signed
        return signed["hex"]

    def holder_script(self, n):
        """A YED holder output of node n's wallet for the next block: a Falcon TX_PQPKH once Falcon is active (TOK-PQ),
        else P2PKH -- the holder policy yed_getnewaddress follows (quantum spec A-13)."""
        va = n.yed_validateaddress(n.yed_getnewaddress())
        if va["type"] == "pq": return ym.pqpkh_script(hex_str_to_bytes(va["keyid"]))
        return ym.p2pkh_script(hex_str_to_bytes(va["keyid"])[::-1])

    def s_invalid(self):
        self.step("invalid", "an invalid mint: refused by every Yellowback mempool; the block carrying it rejected by every Yellowback node")
        bad = self.bad_mint(USER)
        txid = self.node(USER).decoderawtransaction(bad)["txid"]
        self.out("  built %s: a $50 mint on the YED V (MINT-2 needs >= MIN_MINT)" % txid)
        for i in self.yed_nodes:
            self.fails(i, "sendrawtransaction", bad, expect="bad-yellowback-bad-mint-amount")
        tip = self.node(USER).getbestblockhash()
        cb, gbt = template_coinbase(self.node(POOLS[0]))
        block = CBlock()
        block.nVersion = gbt["version"]; block.hashPrevBlock = int(gbt["previousblockhash"], 16)
        block.hashBlockCommitments = int(gbt["blockcommitmentshash"], 16);   # 6.20.0: the header field (Heartwood: chain history root)
        block.nTime = gbt["curtime"]; block.nBits = int(gbt["bits"], 16)
        tx = CTransaction(); tx.deserialize(BytesIO(hex_str_to_bytes(bad)))
        block.vtx = [cb, tx]; block.hashMerkleRoot = block.calc_merkle_root(); block.solve()
        hexblock = bytes_to_hex_str(block.serialize())
        self.out("  solved block %064x on %s carrying it (Python Equihash 48,5)" % (block.sha256, tip[:16]))
        verdicts = {}
        for i in self.yed_nodes:
            verdicts[i] = self.node(i).submitblock(hexblock)
        self.out("  $ submitblock <block> on nodes %s\n    = %s" % (",".join(str(i) for i in self.yed_nodes), jdump(verdicts)))
        self.ok(set(verdicts.values()) == {"bad-yellowback-bad-mint-amount"}, "every Yellowback node rejects the block: bad-yellowback-bad-mint-amount")
        self.ok(all(self.node(i).getbestblockhash() == tip for i in range(self.n)), "no node moved off %s" % tip[:16])
        self.note("not submitted to node 1: it runs without -yellowbackattestorset, so the module is inert there and it would "
                  "accept the block (on mainnet the attestor set is a chain parameter and there is no such node; finding)")
        self.evidence("invalid", {"tx": txid, "block": "%064x" % block.sha256})
        self.mine(1)

    # ------------------------------------------------------------------ bridge (bridge-sim)
    def s_bridge(self):
        for shape in self.args.bridge_shapes.split(","):
            self.bridge_shape(shape)

    def bridge(self, *argv, check=True):
        return self.devnet("bridge", *argv, check=check)

    def bridge_status(self):
        dv.save(self.dir, self.state)
        out = subprocess.run([sys.executable, DEVNET, "bridge", "status", "--json", "--dir", self.dir], capture_output=True, text=True, timeout=120)
        try: return json.loads(out.stdout)
        except ValueError: raise WalkFailure("bridge status --json: %s %s" % (out.stdout[-400:], out.stderr[-400:]))

    def wait_bridge(self, predicate, what, blocks=40):
        """Mine one block at a time until the daemon's status satisfies predicate (it acts on each tip)."""
        for _ in range(blocks):
            time.sleep(2.5)
            st = self.bridge_status()
            if predicate(st): return st
            self.mine(1, quiet=True)
        st = self.bridge_status()
        self.out("    status: " + jdump(st, 1500))
        self.ok(predicate(st), what)
        return st

    def bridge_shape(self, shape):
        self.step("bridge", "the WYEC bridge persona, shape %s (bridge-sim; no Ethereum, a mock burn feed)" % shape)
        if dv.agent_alive((self.state.get("bridge") or {}).get("pid")): self.bridge("down")
        self.bridge("up", "--shape", shape)
        st = self.bridge_status()
        sid = st["set"]
        info = self.call(USER, "set_getinfo", sid, keys=["seats", "unlockthreshold", "cancelthreshold", "slashthreshold", "current", "ratelimitbps", "ratewindow", "livenesswindow", "open"])
        if shape == "guardians":
            self.ok((info["seats"], info["unlockthreshold"], info["cancelthreshold"], info["slashthreshold"], info["current"]) == (9, 6, 1, 7, 9),
                    "guardian set %s: 9 seats, 6 to unlock, 1 to cancel, 7 to slash, 9 current members on 9 nodes" % sid[:16])
        else:
            ch = self.call(USER, "set_getinfo", st["cancelset"], keys=["seats", "open", "cancelthreshold", "current"])
            self.ok(info["seats"] == 1 and info["unlockthreshold"] == 1 and ch["open"] and ch["current"] >= 3,
                    "relayer set %s (1 seat) + OPEN challenger set %s (%d challengers)" % (sid[:16], st["cancelset"][:16], ch["current"]))
        self.bridge("lock", "20", "--dest", "0x" + "ab" * 20)
        self.bridge("lock", "6", "--dest", "0x" + "cd" * 20)
        lock_h = self.mine(1)
        w = info["ratewindow"]
        self.note("U-20: the epoch a lock confirms in has no basis for it; the next epoch starts at %d (rate window %d)" % ((lock_h // w + 1) * w, w))
        self.mine_to((lock_h // w + 1) * w - 1)
        st = self.wait_bridge(lambda s: len(s.get("locks", [])) >= 2 and s.get("unlockable", 0) > 0, "the locks are under the set and an epoch with a basis has begun", blocks=40)
        locks = self.call(USER, "vault_list", {"tag": "WYEC", "setid": sid}, show=False)
        self.out("    = vault_list {tag: WYEC}: %s" % jdump([pick(r, ["outpoint", "value", "ownerheight", "appheight"]) for r in locks]))
        lts = [self.node(USER).getrawtransaction(lk["txid"], 1) for lk in st["locks"]]
        self.ok(any(o["scriptPubKey"]["type"] == "nulldata" and ("00" * 12 + "ab" * 20) in o["scriptPubKey"]["hex"] for lt in lts for o in lt["vout"]),
                "the lock carries the opaque 32-byte destination (ABI bytes32) in an OP_RETURN consensus never reads")
        recipient = self.node(HOLDER).getnewaddress()
        self.bridge("burn", "3", recipient, "--id", "burn-%s-1" % shape)
        st = self.wait_bridge(lambda s: any(b["id"] == "burn-%s-1" % shape and b.get("intent") for b in s["burns"]), "the daemon posted an unlock intent for the burn")
        burn = [b for b in st["burns"] if b["id"] == "burn-%s-1" % shape][0]
        self.out("    burn -> intent %s (signatures %s)" % (burn["intent"], burn.get("signers")))
        if not burn.get("released"):
            itx = burn["intent"].split(":")[0]
            if itx in self.node(USER).getrawmempool():
                self.wait_mempool(itx); self.mine(1)
            if any(r["outpoint"] == burn["intent"] for r in self.node(USER).vault_list({"kind": "intent", "tag": "WYEC"})):
                self.chainviz("a WYEC intent outstanding", intent=burn["intent"])
        st = self.wait_bridge(lambda s: any(b["id"] == "burn-%s-1" % shape and b.get("released") for b in s["burns"]),
                              "the daemon released the intent after the delay", blocks=30)
        burn = [b for b in st["burns"] if b["id"] == "burn-%s-1" % shape][0]
        rel = self.node(USER).getrawtransaction(burn["released"], 1)
        paid = [o for o in rel["vout"] if recipient in o["scriptPubKey"].get("addresses", [])]
        self.ok(paid and paid[0]["valueZat"] >= 3 * 100_000_000, "release %s paid 3 YEC to the burn's Ycash recipient" % burn["released"][:16])
        self.evidence("bridge_%s_release" % shape, {"intent": burn["intent"], "release": burn["released"]})

        # a rogue intent: signed by the unlock quorum without any burn
        self.bridge("rogue", "2")
        st = self.wait_bridge(lambda s: any(r.get("cancelled") for r in s.get("rogues", [])), "the watcher cancelled the intent it could not match to a burn", blocks=12)
        rogue = st["rogues"][-1]
        self.out("    rogue intent %s cancelled by %s" % (rogue["intent"], rogue["cancelled"]))
        self.wait_mempool(rogue["cancelled"]); self.mine(1)
        cancel = self.node(USER).getrawtransaction(rogue["cancelled"], 1)
        self.ok(cancel["vin"][0]["scriptSig"]["hex"].endswith("52"), "the cancel spends the intent with selector 2 (one canceller's signature)")
        self.ok(any(r["outpoint"] == rogue["cancelled"] + ":0" for r in self.node(USER).vault_list({"tag": "WYEC", "kind": "vault"})),
                "the value is back in a WYEC vault (I-2)")
        self.evidence("bridge_%s_rogue" % shape, rogue)

        # the guardians fall silent: the owner recovers every lock
        self.bridge("silence")
        # a heartbeat the daemon sent before it saw the silence may still be in the mempool: mine it first,
        # so the last act (and the dormancy height computed from it) is final
        time.sleep(3)
        for txid in self.node(USER).getrawmempool(): self.wait_mempool(txid)
        self.mine(1)
        info = self.node(USER).set_getinfo(sid)
        live_until = max(m["lastact"] for m in info["memberlist"]) + info["livenesswindow"]
        self.note("the daemon stops heartbeating; the set is DORMANT once no current member acted in livenessWindow (%d) -> height %d"
                  % (info["livenesswindow"], live_until))
        self.bridge("recover", check=False)
        self.mine_to(live_until)
        st = self.call(USER, "set_getinfo", sid, keys=["dormant", "released", "current"])
        self.ok(st["dormant"] and st["released"], "the bridge set is DORMANT and released")
        self.bridge("recover")
        for txid in self.node(USER).getrawmempool(): self.wait_mempool(txid)
        self.mine(1)
        left = [r for r in self.node(USER).vault_list({"tag": "WYEC", "setid": sid})]
        self.ok(not left, "the owner recovered every vault and intent under the set (OWNER-RELEASED, selector 3)")
        self.bridge("down")

    # ------------------------------------------------------------------ falcon (TOK-PQ at the Falcon height)
    def p2pkh_transfer_hex(self, to_node=CLAIMANT):
        """A raw TRANSFER of one of node 0's YED coins to a P2PKH holder of ``to_node``."""
        c = self.yed_coin(USER, ("falcon", "p2pkh", "slh"))
        spk = _spk_of_address(self.node(to_node).yed_getnewaddress("p2pkh"))
        return self.raw_transfer(USER, [(c["txid"], c["vout"], c["valueZat"])], [(spk, 10_000)], [(0, c["cents"])])

    def ensure_yed(self, cents=2_000):
        """Node 0 holds a confirmed YED coin of at least ``cents`` (the claims and the bridge steps may have spent it): mint one."""
        if any(c["cents"] >= cents and not c.get("spentUnconfirmed") for c in self.node(USER).yed_listunspent()): return
        self.fund_user()
        self.note("node 0 holds no YED coin of %d cents: a mint first" % cents)
        self.two_step(USER, "yed_mint", MINT_CENTS, LOCK_BLOCKS, "", "")
        self.mine(1)

    def tok_pq_rows(self, label):
        """From the Falcon height: P2PKH holders stop receiving (wallet and every mempool refuse), Falcon holders continue."""
        self.ok(self.falcon_active() and self.pq_params().get("schemes") == [1, 2], "%s: params.pq.falconActive, schemes [1, 2]" % label)
        addr = self.call(CLAIMANT, "yed_getnewaddress")
        self.ok(len(addr) == 53 and self.node(CLAIMANT).yed_validateaddress(addr)["pqscheme"] == 2, "%s: the default holder address is FN-DSA-512 (53 characters)" % label)
        self.fails(USER, "yed_send", self.node(CLAIMANT).yed_getnewaddress("p2pkh"), 500, expect="bad-yed-holder")
        bad = self.p2pkh_transfer_hex()
        for i in self.yed_nodes:
            self.fails(i, "sendrawtransaction", bad, expect="bad-yellowback-bad-yed-holder")
        good = self.call(USER, "yed_send", addr, 500, keys=["txid", "burnedCents"])
        self.wait_mempool(good["txid"])
        return good["txid"]

    def s_falcon(self):
        h = self.pq_params().get("falconHeight")
        self.step("falcon", "Falcon (FN-DSA-512) activation and TOK-PQ: P2PKH holders stop, Falcon holders continue; a reorg across the Falcon height")
        if h is None or h < 0:
            self.note("SKIP: no Falcon height on this devnet (`up --no-pqfalcon`); `up --pqfalconheight N` walks the activation")
            self.summary["steps"]["falcon"] = "SKIP: no -pqfalconheight"
            return
        self.ensure_yed()
        if h <= self.tip() + 2:
            self.note("Falcon has been active since height %d (the default devnet mirrors mainnet: Falcon live with the vault upgrade); "
                      "the activation and the reorg across it need `up --pqfalconheight N` with N above this step's start height (%d)" % (h, self.tip()))
            t = self.tok_pq_rows("Falcon active since %d" % h)
            self.mine(1)
            self.statehashes("TOK-PQ")
            self.summary["steps"]["falcon"] = {"falconHeight": h, "activation": False, "reorg": False}
            self.evidence("falcon", {"falconSend": t})
            return
        if h - self.tip() > 400:
            raise WalkFailure("the Falcon height %d is %d blocks ahead; pick N within 400 blocks of this step (tip %d)" % (h, h - self.tip(), self.tip()))
        if self.tip() > h - 2:
            raise WalkFailure("the Falcon height %d came too close (tip %d after topping node 0 up): pick N at least 10 above this step's start" % (h, self.tip()))
        # a reserve for after the reorg: every coin node 0 touches from here on is replayed from the mempool then
        reserve = self.call(USER, "yed_send", self.node(HOLDER).yed_getnewaddress("p2pkh"), 400, keys=["txid"])["txid"]
        self.wait_mempool(reserve); self.mine(1, quiet=True)
        # before: P2PKH holders still receive
        self.mine_to(h - 2)
        self.ok(not self.falcon_active(), "tip %d: Falcon inactive for the next block (%d < falconHeight %d)" % (self.tip(), self.tip() + 1, h))
        p2 = self.node(CLAIMANT).yed_getnewaddress()
        self.ok(len(p2) == 35, "before Falcon the default holder address is P2PKH (35 characters)")
        t1 = self.call(USER, "yed_send", p2, 700, keys=["txid"])["txid"]
        self.wait_mempool(t1)
        pre = self.mine(1)
        block_pre = self.node(USER).getblockhash(pre)
        self.ok(self.node(USER).getrawtransaction(t1, 1).get("blockhash") == block_pre and pre == h - 1,
                "transfer %s to a P2PKH holder mined at %d = falconHeight - 1" % (t1[:16], pre))
        # at the Falcon height: TOK-PQ
        f1 = self.tok_pq_rows("tip %d, next block %d = falconHeight" % (self.tip(), self.tip() + 1))
        self.mine(1)
        self.ok(self.tip() == h, "the Falcon transfer %s mined at falconHeight %d" % (f1[:16], h))
        # a P2PKH holder's YED moves on to a Falcon holder after the height (TOK-PQ binds outputs, not inputs)
        pc = self.yed_coin(CLAIMANT, ("p2pkh",))
        self.ok(pc is not None, "the claimant still holds a P2PKH coin (%s cents)" % (pc and pc["cents"]))
        hexm = self.raw_transfer(CLAIMANT, [(pc["txid"], pc["vout"], pc["valueZat"])],
                                 [(ym.pqpkh_script(hex_str_to_bytes(self.node(CLAIMANT).yed_validateaddress(self.node(CLAIMANT).yed_getnewaddress("pq"))["keyid"])), 10_000)],
                                 [(0, pc["cents"])])
        mig = self.call(CLAIMANT, "sendrawtransaction", hexm)
        self.wait_mempool(mig); self.mine(1)
        self.ok(self.node(USER).yed_gettxinfo(mig)["type"] == "transfer"
                and (pc["txid"], pc["vout"]) not in {(c["txid"], c["vout"]) for c in self.node(CLAIMANT).yed_listunspent()},
                "a P2PKH holder migrates after the Falcon height: %s spends the P2PKH coin to a Falcon TX_PQPKH" % mig[:16])
        before = self.statehashes("Falcon active")
        supply = self.node(USER).yed_getstats()["supplyCents"]
        # the reorg across the Falcon height: disconnect falconHeight - 1 and everything after on every node
        self.note("a reorg across the Falcon height: invalidateblock %s (height %d = falconHeight - 1) on every node" % (block_pre[:16], pre))
        for i in range(self.n): self.node(i).invalidateblock(block_pre)
        self.refresh_peer_views()                                     # 6.20.0: fetch the new branch's blocks
        sync_blocks(self.all_nodes())
        self.ok(self.tip() == h - 2 and not self.falcon_active(), "every node back at %d: Falcon inactive again for the next block" % self.tip())
        pools = {i: sorted(self.node(i).getrawmempool()) for i in self.yed_nodes}
        self.out("    = mempools after the reorg: %s" % jdump({i: [t[:12] for t in v] for i, v in pools.items()}, 900))
        self.ok(t1 in self.node(USER).getrawmempool(), "the pre-Falcon P2PKH transfer %s is back in the mempool (valid for height %d)" % (t1[:16], h - 1))
        t2 = self.call(HOLDER, "yed_send", self.node(CLAIMANT).yed_getnewaddress("p2pkh"), 300, keys=["txid"])["txid"]
        self.wait_mempool(t2)
        self.note("below the Falcon height again a new P2PKH transfer %s is accepted (TOK-PQ follows the tip)" % t2[:16])
        self.mine(1)
        self.ok(self.falcon_active(), "tip %d: Falcon active again for the next block" % self.tip())
        left = [t for t in self.node(USER).getrawmempool()]
        self.out("    = node0 mempool at falconHeight - 1: %s" % [t[:12] for t in left])
        for t in left:
            self.wait_mempool(t, nodes=self.yed_nodes)
        self.mine(2)
        for t in (t1, t2):
            self.ok(self.node(USER).getrawtransaction(t, 1).get("confirmations", 0) > 0, "%s confirmed on the new branch" % t[:16])
        fates = {}
        for t, name in ((f1, "the Falcon transfer"), (mig, "the P2PKH -> Falcon migration")):
            try: conf = self.node(USER).getrawtransaction(t, 1).get("confirmations", 0)
            except Exception: conf = None
            fates[t] = conf
            self.out("    %s %s: %s" % (name, t[:16], "confirmed again (%d)" % conf if conf else "in the mempool" if conf == 0 else "dropped"))
        tips = self.node(USER).getchaintips()
        self.ok(any(t["status"] == "invalid" and t["height"] >= h for t in tips), "the old branch across the Falcon height is invalid on node0 (getchaintips)")
        after = self.statehashes("after the reorg across the Falcon height")
        self.out("    supply %d cents before the reorg, %d after" % (supply, self.node(USER).yed_getstats()["supplyCents"]))
        self.summary["steps"]["falcon"] = {"falconHeight": h, "activation": True, "reorg": True}
        self.evidence("falcon", {"preFalconP2pkh": t1, "falconSend": f1, "migrate": mig, "invalidated": block_pre, "afterReorgP2pkh": t2,
                                 "replayed": fates, "statehashBefore": before, "statehashAfter": after})

    # ------------------------------------------------------------------ final
    def s_final(self):
        self.step("final", "every node agrees; the clients agree")
        yed, vault = self.statehashes("end")
        self.evidence("statehash", {"yed": yed, "vault": vault, "height": self.tip(), "stock": self.last_divergence,
                                    "attestorSetId": self.set_id})
        self.call(USER, "vault_getinfo", keys=["sets", "vaults", "intents", "lockedvalue", "statehash"])
        self.call(USER, "yed_getstats", keys=["supplyCents", "activeVaults", "claimedVaults", "closedVaults", "mintingAllowed"])
        self.chainviz("end")
        self.lwd_probe("end")
        self.lwd_equality("end")

    # ------------------------------------------------------------------ a joined testnet
    def s_network(self):
        """The one step a public testnet allows: the node is on the network its profile names."""
        sys.path.insert(0, os.path.join(dv.REPO, "contrib", "yellowback", "profiles"))
        import ybprofile
        profile = ybprofile.load(self.network)
        seat = self.state["seat"]
        self.current = "network"
        self.out("\n[network] %s: the node is on the network its profile names (read-only)" % self.network)
        info = self.call(seat, "getblockchaininfo", keys=["chain", "testnetprofile", "blocks", "headers"])
        self.ok(info["chain"] == profile["chain"], "chain %s" % profile["chain"])
        self.ok(info.get("testnetprofile") == profile["testnet_profile"], "-testnetprofile=%s" % profile["testnet_profile"])
        last = profile["prefix"]["last_height"]
        if info["blocks"] >= last:
            self.ok(self.call(seat, "getblockhash", last) == profile["prefix"]["last_hash"], "block %d is the compiled checkpoint" % last)
        else:
            self.note("below the prefix (%d of %d): the checkpoint row waits for the sync" % (info["blocks"], last))
        fork = profile["heights"]["ycash_fork"]
        if info["blocks"] >= fork:
            self.ok(self.call(seat, "getblock", self.call(seat, "getblockhash", fork))["previousblockhash"] == profile["prefix"]["last_hash"],
                    "the fork block %d follows the prefix" % fork)
        vault = self.call(seat, "vault_getinfo", keys=["activationheight", "attestorsetid", "moduleactive"])
        if profile["yellowback"]["enabled"]:
            want = profile["heights"]["vault"] or -1
            self.ok(vault["activationheight"] == want, "Vault at %s (the profile's)" % (want if want > 0 else "no height yet"))
            self.note("attestor set: %s" % (vault.get("attestorsetid") or "none compiled (until the network's rc names it)"))
        else:
            self.ok(vault["activationheight"] == -1 and not vault.get("moduleactive"), "no Vault, no Yellowback on %s" % self.network)
        self.summary["steps"]["network"] = "PASS"

    def run_joined(self):
        self.out("upgrade-walk %s on %s, joined %s (node%d)" % (time.strftime("%Y-%m-%d %H:%M:%S"), self.dir, self.network, self.state["seat"]))
        status = 0
        try:
            self.s_network()
        except WalkFailure as failure:
            self.out("\nWALK FAILED: %s" % failure)
            self.summary["failed"] = str(failure)
            status = 1
        legacy = self.network == "testnet-legacy"
        for name in STEPS:
            reason = "no Yellowback on testnet-legacy (Vault never activates)" if legacy and name != "clients" else ON_TESTNET[name]
            self.out("[%s] NOT ON %s: %s" % (name, self.network, reason))
            self.summary["steps"][name] = "N/A on %s: %s" % (self.network, reason)
        self.out("\n%s on %s" % ("WALK PASSED (network step)" if status == 0 else "WALK DID NOT PASS", self.network))
        if self.args.summary:
            with open(self.args.summary, "w") as f: json.dump(self.summary, f, indent=2, default=str)
        return status

    def run(self):
        if self.network != "regtest":
            return self.run_joined()
        self.out("upgrade-walk %s on %s (portseed %s), node %s, %s" % (time.strftime("%Y-%m-%d %H:%M:%S"), self.dir, self.state["portseed"],
                 self.state["bitcoind"], "skipping " + ",".join(sorted(self.skip)) if self.skip else "all steps"))
        self.out("ycash6 %s; devnet created %s; attestor set %s" % (dv.fork_commit(dv.REPO), self.state.get("created"), self.set_id))
        status = 0
        try:
            for name in STEPS:
                if name in self.skip and name != "clients":
                    self.out("\n[%s] skipped" % name); continue
                getattr(self, "s_" + name)()
                self.summary["steps"].setdefault(name, "PASS")
        except WalkFailure as failure:
            self.out("\nWALK FAILED: %s" % failure)
            self.summary["failed"] = str(failure)
            status = 1
        except Exception as error:
            import traceback
            self.out("\nWALK ERROR: %r\n%s" % (error, traceback.format_exc()))
            self.summary["failed"] = repr(error)
            status = 2
        self.summary["height"] = self.tip()
        self.summary["seconds"] = int(time.time() - self.t0)
        self.out("\n%s in %d s at height %d" % ("WALK PASSED" if status == 0 else "WALK DID NOT PASS", self.summary["seconds"], self.summary["height"]))
        if self.args.summary:
            with open(self.args.summary, "w") as f: json.dump(self.summary, f, indent=2, default=str)
        return status


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--dir", default=dv.DEFAULT_DIR)
    parser.add_argument("--transcript")
    parser.add_argument("--summary", help="write a JSON summary (steps, evidence, findings) here")
    parser.add_argument("--skip", help="comma-separated steps to skip: " + ",".join(STEPS))
    parser.add_argument("--only", help="run only these steps (comma-separated); clients' checks are skipped unless named")
    parser.add_argument("--bridge-shapes", default="guardians,relayer", help="the bridge shapes to walk (default both)")
    parser.add_argument("--lwd-port", type=int, default=9480, help="the fork's gRPC port; the baseline takes the next one (default 9480)")
    return Walk(parser.parse_args()).run()


if __name__ == "__main__":
    sys.exit(main())
