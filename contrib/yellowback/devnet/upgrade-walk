            if line.strip().startswith(("---", "ok", "FAIL", "PASS", "yellowback_devnet_test.go")): self.out("    | " + line.strip()[:300])
        self.ok(proc.returncode == 0, "lightwalletd's vault read calls equal the node's RPCs, byte for byte where compared (%s)" % label)

