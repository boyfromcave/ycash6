    def lwd_equality(self, label):
        """The fork's devnet test TestDevnetVaultUpgradeThroughServer: GetVaultInfo / ListSets / GetSet(the
        attestor set) / ListVaultOutputs equal the node's vault_getinfo / set_list / set_getinfo / vault_list."""
        lwd = self.state.get("lightwalletd") or {}
