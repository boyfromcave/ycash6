# systemd unit for the Yellowback quote agent (plan §5). Install as
# /etc/systemd/system/yellowback-quote.service, adjust User/paths, then
#   systemctl daemon-reload && systemctl enable --now yellowback-quote
[Unit]
Description=Yellowback quote agent (pushes YEC/USD into ycashd with yed_setquote)
After=network-online.target ycashd.service
Wants=network-online.target

[Service]
Type=simple
User=ycash
ExecStart=/usr/bin/env python3 /opt/yellowback/yellowback-quote --conf /etc/yellowback/yellowback-quote.toml
Restart=always
RestartSec=5
# The agent never exits on an RPC or source failure; a non-zero exit means a bad configuration.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/etc/yellowback

[Install]
WantedBy=multi-user.target
