    },
    "vault-locked": {
      "raisedBy": [
        "yed_redeem",
        "yed_sweep"
      ],
      "when": "tip below lockHeight (ACTIVE and VOID alike)"
    },
    "vault-not-active": {
      "raisedBy": [
        "yed_redeem",
        "yed_claim",
        "yed_sweep",
        "yed_getvault"
      ],
      "when": "an unknown txid; a CLOSED or CLAIMED vault (a VOID vault is releasable by yed_redeem, L14); another wallet's vault"
    },
    "vault-not-found": {
      "raisedBy": [
        "yed_redeem",
        "yed_claim",
        "yed_sweep",
        "yed_getvault"
      ],
      "when": "an unknown txid; a CLOSED or CLAIMED vault (a VOID vault is releasable by yed_redeem, L14); another wallet's vault"
    },
    "vault-not-owned": {
      "raisedBy": [
        "yed_redeem",
        "yed_claim",
        "yed_sweep",
        "yed_getvault"
      ],
      "when": "an unknown txid; a CLOSED or CLAIMED vault (a VOID vault is releasable by yed_redeem, L14); another wallet's vault"
    },
    "vault-value-too-small": {
      "raisedBy": [
        "yed_redeem",
        "yed_claim",
        "yed_sweep"
      ],
      "when": "the vault does not cover the network fee plus the enforcement fee (cannot happen for a vault MINT-5 accepted)"
    },
    "verdict-parent-not-tip": {
      "raisedBy": [
        "yed_getblockverdict"
      ],
      "when": "the block's parent is not the index tip and the block is not a rejected child of it (N12): pass the tip's grandparent"
    },
    "wallet-locked": {
      "raisedBy": [
        "every signing command"
      ],
      "when": "the wallet is encrypted and locked (walletpassphrase first); the stock EnsureWalletIsUnlocked message may precede it"
    },
    "yed-burn-refused": {
      "raisedBy": [
        "`sendrawtransaction` (the stock RPC)"
      ],
      "when": "with -yellowback, a raw transaction that spends a Tokens outpoint of this wallet without a payload that reassigns it (no payload, or a TRANSFER that assigns nothing): pass allowyedburn = true to send it anyway"
    },
    "yed-locked-outpoint": {
      "raisedBy": [
        "`lockunspent` (the stock RPC)"
      ],
      "when": "lockunspent false\\"
    },
    "yellowback-unhealthy": {
      "raisedBy": [
        "every gated command"
      ],
      "when": "the index is unhealthy (unhealthyReason follows); provoke with -yellowbacktestfault=storage:commit then any non-allow-listed command"
    }
