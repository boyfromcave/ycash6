      "raisedBy": [
        "yed_send",
        "yed_redeem",
        "yed_claim",
        "yed_mint"
      ],
      "when": "more than 250 YED inputs / more than 20 Sapling notes would be spent: consolidate first"
    },
    "too-many-notes": {
      "raisedBy": [
        "yed_send",
        "yed_redeem",
        "yed_claim",
        "yed_mint"
      ],
      "when": "more than 250 YED inputs / more than 20 Sapling notes would be spent: consolidate first"
    },
    "unlock-acknowledgement-missing": {
      "raisedBy": [
        "yed_unlockcoin"
      ],
