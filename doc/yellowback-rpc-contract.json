{
  "errors": {
    "attest-bad-sig": {
      "raisedBy": [
        "yed_addattestation"
      ],
      "when": "the compact signature does not verify under attestorPubKey(seq) with this chain's blockHash(citedHeight), **or is high-S** (R17): flip a byte; or sign with s un-normalised"
    },
    "attest-key-not-held": {
      "raisedBy": [
        "yed_signattestation",
        "yed_revive",
        "yed_withdrawbond"
      ],
      "when": "the wallet does not hold the key the command needs: sign for a seq registered by another node"
    },
    "attest-malformed": {
      "raisedBy": [
        "yed_addattestation",
        "yed_reportequivocation"
      ],
      "when": "not 74 bytes of hex (RPC_INVALID_PARAMETER)"
    },
    "attest-not-eligible": {
      "raisedBy": [
        "yed_addattestation"
      ],
      "when": "the record is EJECTED or WITHDRAWN (S4: PENDING, ELIGIBLE and DORMANT are pooled): feed an attestation of an ejected seq"
    },
    "attest-range": {
      "raisedBy": [
        "yed_addattestation",
        "yed_signattestation",
        "yed_revive"
      ],
      "when": "priceMicroUsd outside [PRICE_MIN, PRICE_MAX]"
    },
    "attest-stale": {
      "raisedBy": [
        "yed_addattestation",
        "yed_signattestation"
      ],
      "when": "citedHeight ≤ tip − REF_LAG − ATTEST_MAX_AGE, above the tip, or below startHeight: feed one citing tip − 20 on regtest"
    },
    "attest-unknown-seq": {
      "raisedBy": [
        "yed_addattestation",
        "yed_signattestation",
        "yed_withdrawbond",
        "yed_revive"
      ],
      "when": "no Attestors record with that seq: yed_addattestation of an attestation signed for seq 999"
    },
    "bad-address": {
      "raisedBy": [
        "yed_mint",
        "yed_redeem",
        "yed_claim",
        "yed_sweep"
      ],
      "when": "the address is not an s1…/sm… or ys1… address of this network (a ye… YED address, a Sprout address, nonsense), or its Sapling spending key is not in this wallet: pass a yed_getnewaddress result as from"
    },
    "bad-mint-amount": {
      "raisedBy": [
        "yed_mint"
      ],
      "when": "cents outside [MIN_MINT, MAX_MINT]"
    },
    "bad-xfer-amount": {
      "raisedBy": [
        "yed_send",
        "yed_sendmany"
      ],
      "when": "an amount outside [MIN_OUTPUT, MAX_OUTPUT]"
    },
    "bond-below-min": {
      "raisedBy": [
        "yed_registerattestor"
      ],
      "when": "bondYec < BOND_MIN (10 YEC on regtest): register with 9"
    },
    "bond-locked": {
      "raisedBy": [
        "yed_withdrawbond"
      ],
      "when": "tip < bondLocktime: withdraw right after registering"
    },
    "bond-spent": {
      "raisedBy": [
        "yed_withdrawbond"
      ],
      "when": "the bond outpoint is already spent (bondSpentHeight set): withdraw twice"
    },
    "bundle-insufficient": {
      "raisedBy": [
        "yed_buildbundle",
        "yed_estimatecollateral",
        "yed_mint",
        "yed_claim",
        "yed_claimnotice"
      ],
      "when": "armed and fewer than M_SELECT of selected(R, selector) have a usable attestation in the pool; also a given bundleHex that fails BUNDLE-1 at R (the message ends with the BUNDLE-1 reason). Message grammar: bundle-insufficient: <count> of <selected> selected attestors have a fresh attestation; missing seq <a,b,…> — the GUI reads the two numbers. Provoke: arm, feed one attestor only"
    },
    "bundle-malformed": {
      "raisedBy": [
        "yed_mint",
        "yed_claim",
        "yed_claimnotice"
      ],
      "when": "bundleHex is not \"YA\" ‖ 0x01 ‖ count ‖ count × 74 bytes (RPC_INVALID_PARAMETER)"
    },
    "change-floor": {
      "raisedBy": [
        "yed_send",
        "yed_sendmany",
        "yed_redeem",
        "yed_claim"
      ],
      "when": "no selection leaves YED change of 0 or ≥ MIN_OUTPUT (H2; a REDEEM or CLAIM burns a sub-dollar remainder instead, H4, so it reaches this only when even that is impossible): send cents − 50 from a single cents output. The message is structured and always has this shape: change-floor: <requested> cents cannot be sent from these coins without change below the $1.00 minimum output; nearest workable amounts: below <n\\"
    },
    "claim-not-underwater": {
      "raisedBy": [
        "yed_claim"
      ],
      "when": "RED-4 would fail at the reference snapshot (the price did not fall)"
    },
    "claim-not-yet": {
      "raisedBy": [
        "yed_claim"
      ],
      "when": "tip below claimHeight"
    },
    "equivocation-guard": {
      "raisedBy": [
        "yed_signattestation",
        "yed_revive"
      ],
      "when": "attest-signed.dat holds a signature for (seq, citedHeight) at a different price (S16): sign twice for one height at two prices, also across a restart. Message grammar: equivocation-guard: seq <n> already signed <p₀> for height <h>"
    },
    "expiring-too-soon": {
      "raisedBy": [
        "every builder"
      ],
      "when": "the index is far enough behind the chain that R + REF_WINDOW would expire the transaction at once, or the index has not reached startHeight + REF_LAG"
    },
    "fee-no-eligible-payee": {
      "raisedBy": [
        "yed_getfeepayee"
      ],
      "when": "E(refHeight) empty (FEE-0; not an error for the wallet, which omits the output): a refHeight below the first quote tag"
    },
    "index-below-start": {
      "raisedBy": [
        "every builder"
      ],
      "when": "the index is far enough behind the chain that R + REF_WINDOW would expire the transaction at once, or the index has not reached startHeight + REF_LAG"
    },
    "insufficient-yec": {
      "raisedBy": [
        "yed_mint"
      ],
      "when": "the wallet (or the named from address) cannot cover collateral + fees from confirmed, unlocked outputs or notes: yed_mint … <an empty s1… address>"
    },
    "insufficient-yed": {
      "raisedBy": [
        "yed_redeem",
        "yed_claim",
        "yed_send",
        "yed_sendmany"
      ],
      "when": "wallet YED below the burn or amount"
    },
    "invalid-address": {
      "raisedBy": [
        "yed_listtokens"
      ],
      "when": "a string that is neither a YED nor a transparent P2PKH address of this network"
    },
    "keypool-empty": {
      "raisedBy": [
        "yed_mint",
        "yed_send",
        "yed_redeem",
        "yed_claim"
      ],
      "when": "no fresh key could be drawn (keypoolrefill)"
    },
    "lock-below-min": {
      "raisedBy": [
        "yed_registerattestor"
      ],
      "when": "lockBlocks < BOND_MIN_LOCK (200 on regtest), or the resulting bondLocktime ≥ LOCKTIME_THRESHOLD"
    },
    "mempool-check-failed:<verdict>": {
      "raisedBy": [
        "yed_redeem",
        "yed_claim"
      ],
      "when": "MempoolCheck returned the named RED verdict (K7); provoke with a redemption whose reference snapshot has no pClaim where the claim path is chosen (vault-claim-not-underwater)"
    },
    "mint-bad-lock": {
      "raisedBy": [
        "yed_mint",
        "yed_estimatecollateral"
      ],
      "when": "lockBlocks outside every class, or lockHeight + GRACE ≥ LOCKTIME_THRESHOLD"
    },
    "mint-unsatisfiable": {
      "raisedBy": [
        "yed_mint",
        "yed_estimatecollateral"
      ],
      "when": "requiredZat > MAX_MONEY (K14): MAX_MINT cents at priceMicroUsd = PRICE_MIN"
    },
    "mint10-diverged": {
      "raisedBy": [
        "yed_estimatecollateral",
        "yed_mint"
      ],
      "when": "armed and \\"
    },
    "mintpol-cap": {
      "raisedBy": [
        "yed_mint"
      ],
      "when": "MINTPOL-1, one per halt bit and the cap: mint before activation; with no quote tags in the windows; after fewer than PARTICIPATION_FLOOR signals in a window; with the global ratio below GLOBAL_RATIO_HALT_BPS and the class's minimum ratio below RECAP_RATIO_BPS (W16: class A mints through a global-ratio halt, the message names the classes that can); with P_fast/P_slow diverging by more than DIVERGENCE_BPS; with -yellowbacksupplycapbps low and supply at the cap"
    },
    "mintpol-divergence": {
      "raisedBy": [
        "yed_mint"
      ],
      "when": "MINTPOL-1, one per halt bit and the cap: mint before activation; with no quote tags in the windows; after fewer than PARTICIPATION_FLOOR signals in a window; with the global ratio below GLOBAL_RATIO_HALT_BPS and the class's minimum ratio below RECAP_RATIO_BPS (W16: class A mints through a global-ratio halt, the message names the classes that can); with P_fast/P_slow diverging by more than DIVERGENCE_BPS; with -yellowbacksupplycapbps low and supply at the cap"
    },
    "mintpol-global-ratio": {
